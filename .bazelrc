# This host has no C compiler; use rules_python's script bootstrap so python
# targets do not require a C++ toolchain, and stub out cc autodetection.
common --@rules_python//python/config_settings:bootstrap_impl=script
common --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1

# GNAT prebuilt pin for the ghdl source build: every newer GNAT needs
# glibc >= 2.28 and cannot run on this host (glibc 2.26).
common --@rules_ada//ada/settings:version=12.2.0-1

# Shared disk cache so rebuilds survive an output-base clean.
build --disk_cache=~/.cache/bazel-disk-cache

# EDA and sim jobs are memory-heavy; cap local test parallelism.
test --local_test_jobs=4

# Show the real error output of failing actions instead of a summary line.
build --verbose_failures

# Per-user overrides (untracked) load last if present.
try-import %workspace%/.bazelrc.user
