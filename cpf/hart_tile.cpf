# =============================================================================
# hart_tile.cpf  (M17 — MTCMOS header power gating, cold-gate pilot)
# =============================================================================
# Power intent for the hart tile: ONE switchable domain (PD_GATED, everything
# except the TCM macro) headed by ARM sc-ad10-pmk HEADBUF switches, plus the
# always-on remainder (PD_AO: the TCM macro, the tool-inserted A2ISO output
# clamps, and the AO control routing). Consumed by Genus (iso insertion +
# domain marking) and Innovus (switch fabric, VDD_SW grid, AO region).
#
# NAMING (pmk convention is INVERTED from intuition — databook p.15/46):
#   VDD     = the ALWAYS-ON global net. Tile ring/stripes/M2+ grid; feeds the
#             HEAD switches' VDDG pins, the AO region's follow-pins, and the
#             TCM macro. Identical to the chip-top VDD — the assembly needs
#             no new supply pin.
#   VDD_SW  = the SWITCHED net: the gated region's M1 follow-pin rails,
#             produced by the switches' VDD pins. Internal to the tile.
#   The HEAD/HEADBUF cells' PIN named VDDG is the always-on INPUT and their
#   PIN named VDD is the switched OUTPUT. Read the pin/net bindings below
#   with that in mind.
#
# CONTROL PORTS (driven by pwr_ctrl at MCU level; hart 0 ties both '0'):
#   pd_sleep  = 1 -> switches OFF (pmk SLEEP is active-high sleep).
#             Also mirrored onto tcm_pgen at the top level: the AO TCM macro
#             power-gates itself through its own native PGEN, so it needs no
#             switch fabric and no rush-current budget here.
#   pd_iso_en = 1 -> isolate: every tile OUTPUT clamps LOW (A2ISO), which
#             equals the boundary registers' reset values — the arbiter sees
#             a gated tile exactly as it sees a reset one.
#
# NOT USED (documented deliberately): retention flops (cold-gate decision —
# wake = M12 cold boot; DRFF*/SDRFF* are the M17b option), footer switches
# (FOOT*: incompatible with gating level-up shifters per the kit README, and
# a switched ground complicates the well strategy), O2ISO clamp-high (no
# outbound signal wants a 1 clamp), level shifters (single 1.0 V rail).
#
# The 2007-era pmk NLDM has no Liberty PG-pin attributes, so EVERY cell role
# is declared here (define_* below) — the .lib alone cannot drive recognition
# in Genus 19 / Innovus 20 (M17 recon finding).
# =============================================================================

set_cpf_version 1.1
set_hierarchy_separator "/"

set_design hart_tile

# -----------------------------------------------------------------------------
# Library cell roles (sc-ad10-pmk, hvt)
# -----------------------------------------------------------------------------
# Header switches. Only the HEADBUF*M cells carry SLEEPOUT and can daisy-chain
# (plain HEAD* cannot — M17 recon); the fabric uses HEADBUFs exclusively so
# the enable chain doubles as the rush-current stagger (~60-90 ps/stage).
define_power_switch_cell -cells {HEADBUF16MA10TH HEADBUF32MA10TH} \
	-power_switchable VDD -power VDDG \
	-stage_1_enable !SLEEP -stage_1_output !SLEEPOUT \
	-type header
define_power_switch_cell -cells {HEAD8A10TH HEAD16A10TH HEAD32A10TH} \
	-power_switchable VDD -power VDDG \
	-stage_1_enable !SLEEP \
	-type header

# A2ISO clamp cells — declared for completeness/M17b, but NOT used by a rule
# in this file: isolation is implemented as EXPLICIT RTL AND-clamps at the
# ALWAYS-ON arbiter side in MCU.vhd (pd_iso_en per tile), which is
# electrically the same structure (an AND on AO power with the possibly-
# floating tile pin on one input) and is exercised by every functional sim.
# Genus cannot insert location-to iso cells for a block whose 'to' domain is
# the outside world (CPI-319) — the M17 lesson that drove this choice.
define_isolation_cell -cells {A2ISOX1MA10TH A2ISOX4MA10TH} \
	-power VDD -ground VSS \
	-enable EN -valid_location to

# Always-on buffers/inverters (VDDG-railed) for AO control nets that must
# cross the switched region (SLEEP chain taps, iso enable). dont_use in the
# .lib — declaring them here is what makes them legal for the LP flow.
define_always_on_cell -cells {GPGBUFX1MA10TH GPGBUFX4MA10TH GPGINVX1MA10TH GPGINVX4MA10TH} \
	-power_switchable VDD -power VDDG -ground VSS

# -----------------------------------------------------------------------------
# Nets and domains
# -----------------------------------------------------------------------------
create_power_nets  -nets VDD    -voltage 1.0
create_power_nets  -nets VDD_SW -voltage 1.0 -internal
create_ground_nets -nets VSS

# PD_AO: every tile port (the outside world is always-on) + the
# tool-inserted iso cells (a thin AO row band at the pin edge in P&R).
# NOTE the TCM macro (ram0) deliberately stays in PD_GATED even though its
# VDD pin physically ties to the ALWAYS-ON net (explicit globalNetConnect in
# the Innovus flow): functionally it DOES die with the domain — pd_sleep is
# mirrored onto its native PGEN at the MCU level — and keeping it in the
# gated domain stops the iso rule from wrapping the core->TCM pins in ~50
# pointless clamps inside the tightest timing path.
create_power_domain -name PD_AO -boundary_ports {*}

# PD_GATED: everything else — core, adddec, boundary registers, clock tree,
# and the (AO-railed, PGEN-self-gated) TCM macro. Shut off when pd_sleep is
# high.
create_power_domain -name PD_GATED -default -shutoff_condition {pd_sleep}

update_power_domain -name PD_AO    -internal_power_net VDD    -internal_ground_net VSS
update_power_domain -name PD_GATED -internal_power_net VDD_SW -internal_ground_net VSS

# Power modes — the two-state truth of a cold-gated tile. PM_ON = normal
# operation (the full MMMC times it); PM_SLEEP = PD_GATED off, in which NO
# timed path exists by construction (no retention, controls quasi-static +
# false-pathed). Declaring them is also what lets Innovus reason about
# domain coverage (IMPMSMV-3501 otherwise).
create_nominal_condition -name nc_on  -voltage 1.0
create_nominal_condition -name nc_off -voltage 0.0
create_power_mode -name PM_ON -default \
	-domain_conditions {PD_AO@nc_on PD_GATED@nc_on}
create_power_mode -name PM_SLEEP \
	-domain_conditions {PD_AO@nc_on PD_GATED@nc_off}

# -----------------------------------------------------------------------------
# Rules
# -----------------------------------------------------------------------------
# The switch fabric: VDD (AO) -> HEADBUF chain -> VDD_SW. Physical shape
# (column pitch, chain order, count) is the Innovus side's job.
create_power_switch_rule -name PSW_TILE -domain PD_GATED -external_power_net VDD
update_power_switch_rule -name PSW_TILE \
	-cells {HEADBUF16MA10TH} -prefix pgsw_

# NO isolation rule here (see the A2ISO note above): every gated->AO
# crossing (= every tile output) is clamped LOW by explicit RTL AND gates
# on the MCU side of the boundary, enabled by pwr_ctrl's pd_iso_en(h).
# Clamp-low matches the M13 boundary registers' reset values on ALL
# outbound signals, so the arbiter's IDLE sampler (M5a bug class) sees a
# legal, released master either way.

end_design
