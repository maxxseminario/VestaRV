"""Vesta RISC-V (vestarv) bazel module.

The system python on this host is 3.6, so rules_python provisions a hermetic
3.11 interpreter for every python target in the repo.
"""

module(
    name = "vestarv",
    version = "0.1.0",
)

bazel_dep(name = "rules_python", version = "1.5.1")

# sh_test for the //opensource_sim GHDL suite wrappers (bazel 9 no longer
# guarantees the native shell rules).
bazel_dep(name = "rules_shell", version = "0.6.1")

# This host has no system C compiler, and py_binary needs a resolvable cc
# toolchain even on linux. The zig-based hermetic toolchain is a static
# binary, so it also runs fine on this old glibc 2.26 host.
bazel_dep(name = "hermetic_cc_toolchain", version = "4.3.0")

# Bazel 9 removed the native cc_* rules, so any BUILD file that declares a
# cc_binary must load it from @rules_cc. This is a VISIBILITY-only dep: 0.2.17
# is already the resolved version in the graph (llvm-project, zlib,
# hermetic_cc_toolchain and rules_ada all pull it), so adding it here changes
# no version selection.
bazel_dep(name = "rules_cc", version = "0.2.17")

zig_toolchains = use_extension("@hermetic_cc_toolchain//toolchain:ext.bzl", "toolchains")
use_repo(zig_toolchains, "zig_sdk")

register_toolchains(
    "@zig_sdk//toolchain:linux_amd64_gnu.2.17",
)

# Hermetic TeX Live 2022 for the TRM build. Binaries verified to run on this
# glibc 2.26 host (whole-tree ceiling is glibc 2.23).
bazel_dep(name = "prodrive_technologies_bazel_latex", version = "1.2.2-20250401-c552d5b", repo_name = "bazel_latex")

# GHDL built from source (mcode backend) for the open-source VHDL sim tier.
# Needs rules_ada pinned to GNAT 12.2.0-1 in .bazelrc: every newer GNAT
# prebuilt requires glibc >= 2.28 and dies on this host.
bazel_dep(name = "ghdl", version = "6.0.0.bcr.2")

# Direct dep only so .bazelrc can pin @rules_ada//ada/settings:version (the
# GNAT bootstrap compiler ghdl builds with).
bazel_dep(name = "rules_ada", version = "0.1.0")

# Every Ada compile of ghdl succeeds with the pinned GNAT 12.2.0-1 on this
# host; only the final AdaLink fails, because GNAT's bundled ld needs
# glob@GLIBC_2.27 and this host is glibc 2.26. The patch adds -B/usr/bin to
# the ghdl binary's link flags so gcc picks the system binutils ld (2.37,
# native x86_64) instead. On a modern-glibc host the flag is harmless: the
# system ld there is at least as new as the bundled one.
single_version_override(
    module_name = "ghdl",
    patch_strip = 1,
    patches = ["//toolchains/ghdl:ghdl_system_ld.patch"],
    version = "6.0.0.bcr.2",
)

# Force-upgrade of bazel_latex's transitive rules_foreign_cc 0.12.0, which
# uses an API removed in bazel 9.
bazel_dep(name = "rules_foreign_cc", version = "0.15.1")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# The exact xPack GCC release ci.yml pins (XPACK_GCC_VERSION: 13.2.0-2).
# Byte-identical reproduction of software/bootrom_mp/bin/rom.rcf is a hard
# requirement (physical mask-ROM content), so this compiler must never be
# swapped for another version or vendor.
# The patch_cmds below reproduce the bench machine's ld shim: the tarball's
# GNU ld needs glob@GLIBC_2.27 and refuses to run on this glibc 2.26 host,
# so when ld fails to execute AND ~/local-glibc (an extracted Ubuntu 18.04
# glibc 2.27) exists, ld is wrapped to run ld.real under that loader --
# identical to the hand patch documented in ~/local-glibc/README.md. On
# modern-glibc hosts (CI's ubuntu-latest) the condition is false and the
# pristine toolchain is used unchanged.
http_archive(
    name = "xpack_riscv_gcc",
    build_file = "//toolchains/riscv:xpack_gcc.BUILD",
    patch_cmds = [
        """if ! riscv-none-elf/bin/ld --version >/dev/null 2>&1 && [ -e "$HOME/local-glibc/lib/ld-2.27.so" ]; then
  mv riscv-none-elf/bin/ld riscv-none-elf/bin/ld.real
  printf '%s\\n' '#!/bin/bash' \\
    '# Generated by MODULE.bazel patch_cmds: run ld.real under the local glibc 2.27' \\
    '# loader because this host glibc (2.26) is one version too old. See' \\
    '# ~/local-glibc/README.md.' \\
    'TOOLCHAIN_DIR="$(cd "$(dirname "$0")/../.." && pwd)"' \\
    "GLIBC_DIR=\\"$HOME/local-glibc/lib\\"" \\
    'exec "$GLIBC_DIR/ld-2.27.so" --library-path "$GLIBC_DIR:/lib64:$TOOLCHAIN_DIR/libexec" "$(dirname "$0")/ld.real" "$@"' \\
    > riscv-none-elf/bin/ld
  chmod +x riscv-none-elf/bin/ld
fi""",
    ],
    sha256 = "52545afb900200fbf65fe05f7ce7090b8a42c64091f4f5d43cae6bb68ea2434a",
    strip_prefix = "xpack-riscv-none-elf-gcc-13.2.0-2",
    urls = ["https://github.com/xpack-dev-tools/riscv-none-elf-gcc-xpack/releases/download/v13.2.0-2/xpack-riscv-none-elf-gcc-13.2.0-2-linux-x64.tar.gz"],
)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.11",
)
