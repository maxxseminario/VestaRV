# VestaRV: root package of the workspace.

# .bazelignore keeps roughly 450 GB of EDA output trees out of the build
# graph. //tools/ci:check_bazelignore_test asserts the required entries are
# still there, and a label is the only way to hand the file to a sandboxed
# test, so it is exported here rather than read off the source tree.
exports_files([".bazelignore"])

load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

# Convenience entry point: bazel run //:generate
alias(
    name = "generate",
    actual = "//platform/common/python:generate",
)

# Everything derived from the register descriptions, in dependency order:
# .rdl -> VHDL packages -> C headers -> chip generator. bazel run //:regs
sh_binary(
    name = "regs",
    srcs = ["//tools/build:regs.sh"],
    args = [
        "$(rootpath //platform/common/python:rdl_vhdl_pkgs)",
        "$(rootpath //platform/common/python:rdl_regs_headers)",
        "$(rootpath //platform/common/python:generate)",
    ],
    data = [
        "//platform/common/python:rdl_vhdl_pkgs",
        "//platform/common/python:rdl_regs_headers",
        "//platform/common/python:generate",
    ],
)

# The measured analog chapter, spliced into the TRM by
# LatexUserGuide.CopyAnalogChapter. data/raw/** is 13MB of raw sim dumps that
# no .tex inputs (it is named only in comments), so it stays out of the action.
filegroup(
    name = "castalia_analog_chapter",
    srcs = glob(
        ["implementations/asic/castalia/analog/**"],
        exclude = ["implementations/asic/castalia/analog/data/raw/**"],
        allow_empty = False,
    ),
    visibility = ["//visibility:public"],
)

# Top-level prose, for the documentation link checker.
filegroup(
    name = "root_docs",
    srcs = glob(
        ["*.md"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

# Link TARGETS reached from docs/index.html (the published TRM PDFs).
filegroup(
    name = "doc_link_targets",
    srcs = glob(
        ["implementations/asic/*/docs/TRM.pdf"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

# FPGA bring-up bench inputs, staged at the runfiles root because that is the GHDL
# working directory: hdl/fpga/ARM_IP_ROM.vhd opens "rom.rcf" there (MCU.vhd binds it with
# no generic map), and hdl/common/tb/serial_flash.vhd takes a path of exactly 29
# characters. Read only by //implementations/fpga/bringup:fpga_flash_boot. The payload is the
# rv32ui-p-simple ISA test: blinky is linked at 0x814C and loaded at 0x8000, but the ROM
# enters at PROG_BASE_ADDR 0x8200, so blinky traps on entry (the other apps share its layout).
genrule(
    name = "fpga_bringup_rom_rcf",
    srcs = ["//software/bootrom_mp:rom_rcf"],
    outs = ["rom.rcf"],
    cmd = "cp $< $@",
    visibility = ["//implementations/fpga/bringup:__pkg__"],
)

genrule(
    name = "fpga_bringup_flash_rcf",
    srcs = ["//verification/isa:rv32ui-p-simple_flashed"],
    outs = ["fpga_bringup_flashpayload.rcf"],
    cmd = "cp $< $@",
    visibility = ["//implementations/fpga/bringup:__pkg__"],
)
