-- verification/formal/fabric_formal_props.psl  (R-S4-3 items 3 and 5)
-- Properties for the two contracts the mutation campaign found unchecked.
-- Bound to the directed bench, NOT to arb_lat_tb: these shapes do not
-- occur under arb_lat_tb's stimulus, which is why F4 and F6 escaped.
vunit fabric_formal_props (fabric_formal_tb(tb)) {
    default clock is rising_edge(clk);

    -- mutex_bank -- CLAIM ATOMICITY.  A claim-read returns the OLD state
    -- in the same transaction that claims.  The bench supplies the
    -- expected value as a reference; the property is an equality against
    -- it, so it is independent of how mutex_bank computes rdata.
    -- mx_rdata is REGISTERED: the claimed-from state appears the cycle
    -- AFTER the enabled transaction, hence `next`.
    P_MTX_CLAIM_RETURNS_OLD : assert always (
        ((resetn = '1') and (mx_en = '1') and (mx_we = "0000") and (mx_exp_valid = '1'))
        -> next (mx_rdata = mx_exp));

    -- mutex_bank -- STEAL-PROOF.  A claim-read aimed at a HELD mutex must
    -- return the INCUMBENT holder, never zero: a zero would mean the
    -- claimant believes it acquired a mutex somebody else owns.  This is
    -- the mutual-exclusion contract at the slave side.
    P_MTX_NO_STEAL : assert always (
        ((resetn = '1') and (mx_en = '1') and (mx_we = "0000") and (mx_claim_held = '1'))
        -> next (mx_rdata /= x"00000000"));

    -- resv_unit -- THE M4b FOREIGN-WRITE RULE.  Once another master has
    -- written the reserved address, the reservation must be DEAD: the
    -- holder's resv_valid must be clear, and its later SC must fail.
    P_RESV_FOREIGN_WRITE_KILLS : assert always (
        ((resetn = '1') and (foreign_write_done = '1')) -> (rv_valid(0) = '0'));

    -- resv_unit -- and the SC that follows must be adjudicated a FAILURE.
    P_RESV_SC_AFTER_FOREIGN_FAILS : assert always (
        ((resetn = '1') and (foreign_write_done = '1')
         and (rv_sen = '1') and (rv_lrsc(1 downto 0) = "10") and (rv_gnt(0) = '1'))
        -> next (rv_scfail(0) = '1'));

    -- resv_unit -- a failed SC must also be SUPPRESSED, not merely flagged.
    P_RESV_FAILED_SC_NO_WRITE : assert always (
        ((resetn = '1') and (foreign_write_done = '1')
         and (rv_sen = '1') and (rv_lrsc(1 downto 0) = "10") and (rv_gnt(0) = '1'))
        -> (rv_weg = "0000"));
}

-- ---------------------------------------------------------------------------
-- M8 GRANT-LOCKING (R-S4-3 item 4, bounded iteration).
-- The window is declared by the BENCH, not inferred from a_lock: a master may
-- assert lock before it is granted, and the arbiter pins on its DATA->LOCKED
-- edge -- residency is not a function of the bound ports.  lock_window is high
-- from master 0's locked READ completing until master 0 drops lock, i.e.
-- exactly the interval the arbiter must hold the grant pinned.
-- ---------------------------------------------------------------------------
vunit fabric_formal_props_m8 (fabric_formal_tb(tb)) {
    default clock is rising_edge(clk);

    -- No other master may be granted while master 0 owns the locked window,
    -- and masters 1..3 request throughout it (witness W_CONTENDED).
    P_LOCK_ATOMIC : assert always
        ((resetn = '1' and lock_window = '1') ->
         (ab_gnt(1) = '0' and ab_gnt(2) = '0' and ab_gnt(3) = '0'));

    -- NOT ASSERTED, and the reason is a property bug I made, not an RTL one:
    -- "master 0 holds the grant throughout its own window" is FALSE BY DESIGN.
    -- mp_arbiter's LOCKED arm starts with `gnt <= (others => '0')` and only
    -- re-raises gnt(cur) when the follow-up write's FRESH req arrives, so the
    -- locked master's own grant legitimately drops between the RMW halves.
    -- M8's guarantee is exclusion of OTHERS, not continuous ownership --
    -- which is exactly what P_LOCK_ATOMIC above states.
}
