# Shared verification sources.
# The p-mode test environment (headers plus linker scripts) that every ISA test
# image compiles and links against.
# The ISA image rules live in //verification/isa; this package only publishes
# the env/ inputs they consume, because env/ has no BUILD file of its own.

package(default_visibility = ["//visibility:public"])

# Headers reached through the ISA Makefile's -I../env/p, plus encoding.h which
# riscv_test.h includes as ../encoding.h.
filegroup(
    name = "env_headers",
    srcs = ["env/encoding.h"] + glob(
        ["env/p/*.h"],
        allow_empty = True,
    ),
)

# The p-mode linker scripts.
# link.ld is the default for every test; link_shared.ld is the per-test override
# for an image too large for the private TCM.
filegroup(
    name = "env_p_linker_scripts",
    srcs = glob(
        ["env/p/*.ld"],
        allow_empty = True,
    ),
)

exports_files([
    "env/p/link.ld",
    "env/p/link_shared.ld",
    "env/p/link_boot.ld",
    "env/p/link_fem.ld",
])

# ---------------------------------------------------------------------------
# Benchmark sources for //verification/cpi.
#
# benchmarks/ has no BUILD file of its own, so its files belong to this
# package and only this package can publish them. The CPI harness compiles
# each benchmark's .c set against its own crt and stubs (see
# //verification/cpi:defs.bzl), which is why the sources are exposed per
# benchmark rather than as one filegroup: the compile action must name exactly
# the translation units of the benchmark under test.
#
# mm is absent on purpose: it has no main(), it is a multicore thread_entry
# benchmark, and the CPI harness runs one bare hart.
# ---------------------------------------------------------------------------
_CPI_BENCHMARKS = [
    "dhrystone",
    "median",
    "memcpy",
    "multiply",
    "qsort",
    "rsort",
    "spmv",
    "towers",
    "vvadd",
]

[
    filegroup(
        name = "benchmark_%s_srcs" % b,
        srcs = glob(["benchmarks/%s/*.c" % b]),
    )
    for b in _CPI_BENCHMARKS
]

# Everything a benchmark compile can include: encoding.h reached through
# -Iverification/env, benchmarks/common/util.h through
# -Iverification/benchmarks/common, and each benchmark's own dataset and
# declaration headers through -Iverification/benchmarks/<name>.
filegroup(
    name = "benchmark_headers",
    srcs = ["env/encoding.h"] + glob(
        [
            "benchmarks/common/*.h",
            "benchmarks/*/*.h",
        ],
        allow_empty = True,
    ),
)
