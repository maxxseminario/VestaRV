# The Makefile's one per-test linker script override (Makefile:235).
# rv32uc-p-rvc's .text.init is larger than the 8 KiB private TCM, so it links
# into the shared bulk RAM instead of aliasing over itself.
_LD_OVERRIDES = {
    "rv32uc": {"rvc": SHARED_LD},
}

[
    riscv_isa_suite(
        suite = suite,
        march = march,
        tests = tests,
        defines = CI_DEFINES,
        hdrs = _COMMON_HDRS,
        ld_overrides = _LD_OVERRIDES.get(suite, {}),
    )
    for suite, march, tests in _CI_SUITES
]

# rv32uzf (X4 Zfinx), Makefile:349.  It is a live suite with its own -march and
# it builds at the default define set, but build_mp_images.sh does NOT include
# it in its default group list, so it is NOT part of the CI image set and is
# kept out of :ci_images below.  Running it against RTL needs the ON polarity
# (-DCORE_ENABLE_ZFINX), which is a `defines` argument, not a code change.
riscv_isa_suite(
    suite = "rv32uzf",
    march = "rv32imc_zfinx",
    tests = _RV32UZF_TESTS,
    defines = CI_DEFINES,
    hdrs = _COMMON_HDRS,
)

# --------------------------------------------------------------------------
# OPEN-SOURCE-SIM (GHDL bare-core) POLARITY
#
# The //opensource_sim GHDL harness enables every single-bare-core-verifiable
# extension generic, and the rv32ua ext-probes dispatch their ON arm on these
# build-time defines — so it needs the SAME nine suites at a different
# polarity. This list MUST mirror CORE_ENABLE_DEFS in
# opensource_sim/isa/run_isa.sh, one for one (that script's make path and
# these targets must produce interchangeable images). No -DNHARTS: the bare
# harness is one hart, matching run_isa.sh's own build line.
# --------------------------------------------------------------------------
OS_CORE_ENABLE_DEFINES = [
    "-DCORE_ENABLE_COMPRESSED",
    "-DCORE_ENABLE_ZICOND",
    "-DCORE_ENABLE_ZCB",
    "-DCORE_ENABLE_ZIMOP",
    "-DCORE_ENABLE_ZIHINT",
    "-DCORE_ENABLE_ZICBOZ",
    "-DCORE_ENABLE_ZABHA",
    "-DCORE_ENABLE_ZACAS",
    "-DCORE_ENABLE_ZCMP",
    "-DCORE_ENABLE_ZCMT",
    "-DCORE_ENABLE_ZBKB",
    "-DCORE_ENABLE_ZBKC",
    "-DCORE_ENABLE_ZBKX",
    "-DCORE_ENABLE_ZKN",
    "-DCORE_ENABLE_ZFINX",
]

[
    riscv_isa_suite(
        suite = suite,
        march = march,
        tests = tests,
        defines = OS_CORE_ENABLE_DEFINES,
        hdrs = _COMMON_HDRS,
        ld_overrides = _LD_OVERRIDES.get(suite, {}),
        name_prefix = "os_",
        outdir = "os/",
    )
    for suite, march, tests in _CI_SUITES + [("rv32uzf", "rv32imc_zfinx", _RV32UZF_TESTS)]
]

# The CI image set: exactly what `./build_mp_images.sh 4 rcf_ci` stages.
filegroup(
    name = "ci_images",
    srcs = [":%s_flashed" % suite for suite, _, _ in _CI_SUITES],
)

filegroup(
    name = "ci_rcfs",
    srcs = [":%s_rcfs" % suite for suite, _, _ in _CI_SUITES],
)

# Every image this package can build, CI set plus rv32uzf, flashed and not.
filegroup(
    name = "all_images",
    srcs = [":ci_images", ":ci_rcfs", ":rv32uzf_flashed", ":rv32uzf_rcfs"],
)

# --------------------------------------------------------------------------
# N=5 CROSS-CHECK IMAGES
#
# verification/isa/rcf/ holds the canonical Castalia set, and since CPR8/R7 it
# is stamped NHARTS=5, not the CI job's 4.  These five multi-hart tests are the
# ones whose emitted code actually depends on NHARTS, and they exist here at
# N=5 solely so the port can be byte-compared against that on-disk set.  They
# are also the demonstration of the point of this port: the SAME .S, differing
# only in a -D, is a different action with a different output, which is exactly
# what the Makefile cannot express.
# Not wired into :all_images; build them by name.
_N5_CROSSCHECK = [
    ("rv32ui", "rv32imc", "shmem_mp"),
    ("rv32ui", "rv32imc", "shclint"),
    ("rv32ui", "rv32imc", "shexec"),
    ("rv32ua", "rv32imac", "shlrsc"),
    ("rv32ua", "rv32imac", "shspin"),
]

[
    riscv_isa_image(
        name = "n5_%s-p-%s" % (suite, test),
        src = "tests/%s/%s.S" % (suite, test),
        march = march,
        defines = ["-DNHARTS=5"],
        hdrs = _COMMON_HDRS,
        basename = "%s-p-%s" % (suite, test),
        outdir = "n5/",
    )
    for suite, march, test in _N5_CROSSCHECK
]

filegroup(
    name = "n5_crosscheck",
    srcs = [":n5/%s-p-%s.rcf" % (suite, test) for suite, _, test in _N5_CROSSCHECK],
)

# --------------------------------------------------------------------------
# CONTRACT TEST
#
# tools/cosim/gate/bootrom_mp_rom.rcf is the ONLY tracked .rcf in the tree
# (.gitignore re-includes tools/cosim/gate/*.rcf over the global *.rcf rule),
# and it is the MP bootrom image, not an ISA test image, so there is no tracked
# golden for anything this package produces and no golden diff to wire up.
# Byte identity against the on-disk verification/isa/rcf/ set was therefore
# measured by hand and reported; what stands as a test here is the image
# CONTRACT, which is what a stale or mis-staged image violates first:
#   * an unflashed image is exactly 20480 words of 32 '0'/'1' characters,
#   * a flashed image opens with the 0x10adbeef vector-area header, ends with
#     the 0xcafebabe execute word, and carries no second header,
#   * the flashed file name is exactly 22 characters.
py_test(
    name = "image_contract_test",
    size = "small",
    srcs = ["tests_image_contract.py"],
    main = "tests_image_contract.py",
    data = [
        ":rv32uc_flashed",
        ":rv32uc_rcfs",
        ":rv32uzba_flashed",
        ":rv32uzba_rcfs",
        ":rv32uzbc_flashed",
        ":rv32uzbc_rcfs",
        ":rv32um_flashed",
        ":rv32um_rcfs",
    ],
)
