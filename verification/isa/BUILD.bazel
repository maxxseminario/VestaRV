# Per-test bazel targets for the verification/isa images.
#
# This package re-expresses the CI job "Bootrom + ISA image builds", which runs
# `./build_mp_images.sh 4 rcf_ci`, as one target per test.  build_mp_images.sh
# builds the eight groups below and stages them, flashed and x-padded, into its
# destination directory.
#
# THE POLARITY IS IN THE ACTION KEY.  The Makefile keys each ELF on its .S
# alone, so the -march of the suite and the -DNHARTS / -DCORE_ENABLE_* defines
# can change under a build directory that is never invalidated; that is why
# build_mp_images.sh must `rm -rf build/` and stamp build/.imgset.  Here every
# one of those flags is an argument of the compile action, so a polarity change
# rebuilds precisely the images it affects.
#
# Only the p-mode (`-p-`) variants exist: compile_template instantiates
# $(1)_p_tests, never $(1)_v_tests or $(1)_ps_tests.
#
# The test lists below are the <suite>_sc_tests lists of tests/<suite>/Makefrag,
# which is the authority on what is live.  A .S sitting in a suite directory
# without a Makefrag entry is NOT built here either: tests/rv32ui/ma_data.S,
# wntag.S, wntagx.S, tests/rv32ua/d5sess.S, extprobe_template.S and the
# dbg*mp.S one-offs that tools/build_one_rcf.sh stages by hand.

load(":defs.bzl", "CI_DEFINES", "SHARED_LD", "riscv_isa_image", "riscv_isa_suite")
load("@rules_python//python:defs.bzl", "py_test")

package(default_visibility = ["//visibility:public"])

# Everything a test compile can read besides its own .S:
#   * //verification:env_headers -- encoding.h and env/p/*.h, reached through
#     the Makefile's -I../env/p (riscv_test.h, test_macros.h, mp_boot.h,
#     core_features.h),
#   * macros/scalar/*.h -- the Makefile's -I./macros/scalar,
#   * tests/rv64*/*.S -- the rv32 tests of the shared suites #include their
#     rv64 counterparts (for example tests/rv32ui/add.S includes
#     ../rv64ui/add.S), so the rv64 trees are compile inputs even though no
#     rv64 image is built at XLEN=32,
#   * tests/*/*.h -- a suite-local header a test includes out of its own
#     directory, which is how cpp resolves a quoted include first
#     (tests/rv32uzf/test_macros_zfinx.h is the only one today).
_COMMON_HDRS = [
    "//verification:env_headers",
] + glob(
    [
        "macros/scalar/*.h",
        "tests/rv64*/*.S",
        "tests/*/*.h",
    ],
    allow_empty = True,
)

