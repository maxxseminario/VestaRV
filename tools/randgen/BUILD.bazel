load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

# The K3 random-stream generator, its ISA model and its census instrument.
# config.py pulls oracle_isa out of tools/cosim and verify_stage out of
# platform/common/python, so both are real deps rather than sys.path luck.
py_library(
    name = "randgen_lib",
    srcs = [
        "census.py",
        "config.py",
        "emit.py",
        "isa_model.py",
        "randgen.py",
        "rng.py",
        "stream.py",
    ],
    data = glob(["campaign/*"]),
    imports = ["."],
    deps = [
        "//platform/common/python:chipgen_lib",
        "//tools/cosim:cosim",
    ],
)

py_binary(
    name = "randgen",
    srcs = ["randgen.py"],
    main = "randgen.py",
    deps = [":randgen_lib"],
)

# The K3 unit tests. The load-bearing case is test_decoder_agrees_with_objdump:
# every mnemonic the generator can emit is assembled by gas and refereed by
# `objdump -M no-aliases`, so the hermetic xPack binutils must be on hand.
# RANDGEN_GCC names the staged driver; test_randgen derives RISCV_PREFIX from
# it, which is the variable census.py has always read.
#
# TWO INPUTS OWNED BY OTHER PACKAGES WERE ONCE STAGED BY HAND. Both are now
# declared labels in `data` below, and this test runs sandboxed with nothing
# read out of the source tree:
#
#  1. config.load()'s default is the TRACKED
#     platform/common/config/ChipConfig.resolved.json. //platform/common
#     excludes it from :config_srcs (it is generator output, not input) and
#     :castalia_resolved_config is the REGENERATED copy at a bazel-out path,
#     which config.py cannot resolve. //platform/common:tracked_resolved_config
#     is the public label for the tracked file.
#  2. verification/isa/macros/scalar/*.h. _compile_stream passes
#     -I<repo>/verification/isa/../env/p, and a path with a '..' component
#     resolves only if verification/isa exists in the runfiles tree, so
#     without those headers even the staged env/p headers are unreachable.
#     //verification/isa:scalar_macros is that filegroup; staging it also
#     materialises verification/isa/ so the '..' path resolves.
#
# THE k3s01 PIN WAS ADJUDICATED 2026-08-23: BENIGN CONFIG DRIFT, RE-RECORDED.
# The campaign was recorded 2026-08-03 at 5a0cc19 against config digest
# 9ca2e20fb3d2 (priv=(none) harts=4). Two later default flips moved it to
# 1ffadbaf4c85:
#   * 52130ac (2026-08-04) K7 item 1 -- priv.trapCsr false -> true, which also
#     turns image_defines into ["-DCORE_ENABLE_TRAPCSR"],
#   * e9ece88 / 1af1953 (2026-08-14/15) Castalia Penta -- numHarts 4 -> 5.
# (isa.minimalTiles, also set by 1af1953, is NOT in oracle_isa._REQUIRED_ISA,
# so it reaches neither the knob line nor the digest.)
#
# Measured before re-recording, which is what makes this benign rather than
# assumed: rebuilding all six streams with the CURRENT generator against the
# 2026-08-03 resolved config reproduces all six recorded hashes byte for byte,
# and diffing old-config against new-config output moves exactly ONE line in
# each of the eight tracked default-config .S files -- the `# config :`
# reproduction comment. No instruction, no class count, no total, no blocked
# class and no required amendment moved. Neither numHarts nor trapCsr reaches
# an emitter (numHarts appears only in identity/digest/manifest; trapCsr is
# oracle verdict B and only adds itself to knobs_on_without_emitter).
#
# The recorded "one failure" was itself an artefact: the eq() sat inside the
# per-stream loop, so it aborted on k3s01 and hid that all six had moved. The
# test now diagnoses the config digest first and lists every moved stream, and
# both arms were seen to fail before the tag came off.
py_test(
    name = "test_randgen",
    size = "large",
    srcs = ["test_randgen.py"],
    data = [
        # config.py reaches verify_stage.py by path, and it is not one of
        # chipgen_lib's declared modules, so the whole generator source set
        # is staged rather than a private label.
        "//platform/common:tracked_resolved_config",
        "//platform/common/python:generator_srcs",
        "//platform/myshkin/gcc/lib:platform_headers",
        "//verification/isa:scalar_macros",
        "//verification:env_headers",
        "//verification:env_p_linker_scripts",
        "@xpack_riscv_gcc//:as",
        "@xpack_riscv_gcc//:gcc",
        "@xpack_riscv_gcc//:objcopy",
        "@xpack_riscv_gcc//:objdump",
        "@xpack_riscv_gcc//:toolchain",
    ],
    env = {"RANDGEN_GCC": "$(rootpath @xpack_riscv_gcc//:gcc)"},
    main = "test_randgen.py",
    deps = [":randgen_lib"],
)
