load("@rules_python//python:defs.bzl", "py_binary", "py_test")

package(default_visibility = ["//visibility:public"])

# The single canonical bin -> RCF converter (replaces the five divergent
# od+awk copies in the makefiles). Byte-verified against the pinned
# software/bootrom_mp/bin/rom.rcf gate artifact.
py_binary(
    name = "bin2rcf",
    srcs = ["scripts/bin2rcf.py"],
    main = "scripts/bin2rcf.py",
)

# Out-of-place port of verification/isa/flash_prepend.sh's transform,
# byte-verified against the bash original's output.
py_binary(
    name = "rcf_flash",
    srcs = ["scripts/rcf_flash.py"],
    main = "scripts/rcf_flash.py",
)

# Linker scripts shared by the firmware builds. The .ld files `INCLUDE`
# memory.x / periph.x and the *_START/_SIZE fragments, so all must travel
# together.
#
# THE .x AND .txt FILES HERE ARE THE LINK ENVIRONMENT THE MASK PLATE WAS
# COMPILED FROM, and as of 2026-08-23 they are also a verbatim copy of
# //platform/common:castalia_linker_scripts.  The recorded divergence is empty.
#
# They were NOT a copy until then.  They were frozen at 2026/04/20 and had gone
# stale under the chip: 16 KiB ROM where the part has 8 KiB, and one flat RAM
# window 0x0814C-0x0FFFF where the part has an 8 KiB TCM, a mirror of it, then
# NPU_RAM and SHARED_RAM.  Refreshing them was blocked by ONE thing, and it was
# a real defect rather than a packaging problem: rv4th.c put 0x5D70 bytes of
# Forth interpreter arrays in .noinit, which fits the old 32436-byte window and
# overflows the real 7708-byte one by 16212 bytes.  The stale script is why that
# never failed a build.  On the part it did not fail at all -- it wrote through
# the TCM mirror at 0xA000 back onto the vector table and the stack, and past
# 0xC000 into the shared NPU staging RAM.
#
# That was fixed at source (see THE TCM BUDGET in software/bootrom_mp/src/rv4th.c
# and the ASSERT at the bottom of linker-scripts/MCU-bootrom.ld), so the boot ROM
# now links against the true map.  The boot image moved with it, and its two
# recorded goldens (software/bootrom_mp/testdata/rom_rcf_golden.txt and
# tools/cosim/gate/bootrom_mp_rom.rcf) and the physical rom2k_hvt_pg plate were
# re-cut in the same change.  Five files, one md5:
#     d177e8314f2de080150070762b3d80f7   (was cab1bbe82d67d959d514dda9e338e3f9)
#
# The six MCU.ld firmware images were unaffected: they link against either set,
# and were built both ways on 2026-08-23 with every .rcf and .hex byte identical.
# Only the .elf symbol table moves, because periph.x contributes absolute symbols.
#
# :rom_plate_link_env_test still guards this directory, and its job did not
# change: the two sets are allowed to diverge again when the chip map moves, but
# never in silence.  A divergence that reappears means the plate is stale again.
filegroup(
    name = "linker_scripts",
    srcs = glob([
        "linker-scripts/*.ld",
        "linker-scripts/*.x",
        "linker-scripts/*.txt",
    ]),
)

# The six generator-written names in linker-scripts/. The two .ld files are
# hand written and have no generated counterpart, so they are not in this list.
LINK_ENV_FILES = [
    "memory.x",
    "periph.x",
    "RAM_START.txt",
    "RAM_SIZE.txt",
    "ROM_START.txt",
    "ROM_SIZE.txt",
]

# The frozen link environment above must diverge from the live chip memory map
# in exactly the recorded way, and no other. This fails loudly when the chip's
# generated map moves again, or when somebody edits the frozen copy.
#
# It is deliberately not a "these two must be equal" check: they are known to be
# unequal, and the point is to make the inequality reviewed rather than silent.
#
# Re-record the baseline (only after deciding the plate still ships as is) with:
#   tools/bin/bazel build //platform/common:castalia_linker_scripts
#   python3 tools/build/scripts/check_plate_link_env.py --update \
#     --baseline tools/build/testdata/rom_plate_link_env.diff \
#     --file memory.x tools/build/linker-scripts/memory.x \
#       bazel-bin/platform/common/chip_artifacts_castalia/out/linker-scripts/memory.x \
#     ... one --file triple per name below ...
py_test(
    name = "rom_plate_link_env_test",
    size = "small",
    srcs = ["scripts/check_plate_link_env.py"],
    args = [
        "--baseline",
        "$(rootpath testdata/rom_plate_link_env.diff)",
    ] + [
        arg
        for f in LINK_ENV_FILES
        for arg in [
            "--file",
            f,
            "$(rootpath linker-scripts/" + f + ")",
            "$(rootpath //platform/common:castalia_" + f.replace(".", "_").lower() + ")",
        ]
    ],
    # Every label named by a $(rootpath) above has to be its own data entry;
    # a filegroup that merely contains the file does not satisfy $(rootpath).
    data = [
        "testdata/rom_plate_link_env.diff",
    ] + [
        "linker-scripts/" + f
        for f in LINK_ENV_FILES
    ] + [
        "//platform/common:castalia_" + f.replace(".", "_").lower()
        for f in LINK_ENV_FILES
    ],
    main = "scripts/check_plate_link_env.py",
)

# ---------------------------------------------------------------------------
# IMAGE-vs-MEMORY-MAP GATE
#
# The guard above proves the FROZEN link environment has not drifted. It says
# nothing about whether an image LINKED through some linker script actually
# fits the part, and that is the hole the boot ROM fell through:
#
#   flashboot.elf  .noinit  NOBITS  0x0000814C  0x5D70 bytes -> ends 0x0000DEBB
#   the chip's TCM                              0x8000-0x9FFF (8 KiB)
#
# 16,060 bytes past the end of RAM, for over a week, with every gate green.
# Nothing was wrong with the link: MCU-bootrom.ld INCLUDEs a memory.x frozen on
# 2026/04/20 that still describes a 16 KiB TCM, the real TCM halved on
# 2026-08-16, and the linker cheerfully honoured the description it was given.
# A linker script is a claim about the chip, and no gate was checking the claim
# against the chip.
#
# :check_image_regions.py closes that. It reads the section headers out of the
# built ELF and the regions out of the CURRENT generated memory map, and never
# consults a linker script for its bar -- a linker script that lies is the
# defect, so it cannot also be the reference.
#
# See the script's docstring for exactly what counts as a violation (NOBITS
# sections do; zero-size placeholders and non-allocated debug sections do not;
# the NPU staging window and the shared RAM are legitimate homes, so the bar is
# "inside SOME declared region", never "inside the TCM").
#
# WHY BOTH TESTS LIVE HERE AND NOT NEXT TO THEIR IMAGES.
# ci.yml's bazel-gates job runs `//...` minus //opensource_sim/..., minus
# //hdl/common/tb/..., minus //toolchains/..., and minus //verification/cpi/...
# (that last one because its tests drag in the from-source GHDL build). A check
# on the CPI images placed in //verification/cpi would therefore run in NEITHER
# workflow: ci.yml excludes the package, and sim.yml takes explicit targets and
# would not name it. Placing both tests in //tools/build puts them inside
# ci.yml's wildcard while the images they read stay plain genrule outputs that
# need no simulator. Nothing had to be named in sim.yml.

# The product firmware: everything that is meant to run on a Castalia part.
# The seven images that link through linker-scripts/ (bootrom_mp via
# MCU-bootrom.ld, the blinky family via MCU.ld) and the debug trampoline that
# lives in the shared window.
PRODUCT_IMAGES = [
    "//software/bootrom_mp:flashboot.elf",
    "//software/afetest:afetest.elf",
    "//software/blinky:blinky.elf",
    "//software/gpiotoggle:gpiotoggle.elf",
    "//software/looptest:looptest.elf",
    "//software/slowblink:slowblink.elf",
    "//software/traptest:traptest.elf",
    "//software/dbg_trampoline:dbg_trampoline.elf",
]

# The memory map, straight from the generator, in both the forms the check
# needs: the JSON is authoritative for ROM/peripheral/TCM, and memory.x is the
# only machine-readable statement of the NPU staging and shared RAM windows.
# The check cross-checks the two before trusting either.
MAP_ARGS = [
    "--memory-map-json",
    "$(rootpath //platform/common:castalia_config_memorymap_json)",
    "--memory-x",
    "$(rootpath //platform/common:castalia_memory_x)",
]

MAP_DATA = [
    "//platform/common:castalia_config_memorymap_json",
    "//platform/common:castalia_memory_x",
]

# --min-images is a floor, not a count: a data list that stops resolving would
# otherwise turn this into a green check of nothing. It was 29 while
# PRODUCT_IMAGES also carried twenty-one lab images; it tracks the list, so
# moving it DOWN is only ever correct alongside a deliberate removal from
# PRODUCT_IMAGES, never to make a red target green. --require-nobits is the
# standing control that .bss/.noinit really do reach the comparison, since a
# NOBITS section is what the motivating defect was.
py_test(
    name = "firmware_image_map_test",
    size = "small",
    srcs = ["scripts/check_image_regions.py"],
    args = MAP_ARGS + [
        "--min-images",
        "8",
        "--require-nobits",
    ] + ["$(rootpaths %s)" % i for i in PRODUCT_IMAGES],
    data = MAP_DATA + PRODUCT_IMAGES,
    main = "scripts/check_image_regions.py",
)

# The verification images. Same check, same script, separate target because
# these are red today for a reason that is understood and is NOT the same
# defect as the boot ROM's.
#
# KNOWN RED. The 2026-08-16 TCM halving (0x8000-0xBFFF -> 0x8000-0x9FFF) left
# verification/env/p/link.ld and verification/env/p/link_shared.ld pinning the
# whole ISR bank and the NPU ideal-output vector into what is now a hole:
#   .npu0_yhat     0xB000     comment still reads "(TCM)"
#   .isr_meip      0xB100
#   .isr_afe_shared / .isr_eis / .isr_uart0_tc  0xB700-0xBDFF, inside the bank
#                              the script documents as "0xB200-0xBAFF, TCM"
# and it left nine verification/cpi benchmarks whose working sets run past the
# end of the TCM (spmv's .rodata by 35,744 bytes, rsort_noc's .data by 10,056,
# dhrystone's NOBITS .bss by 6,584).
# 47 images and 61 sections out of the 595 this target sweeps. Run the target
# to see every one; the ISA half is 19 rv32ui sources (the sh*/w* peripheral
# tests, the only ones that instantiate an ISR) at two polarities each.
#
# THE TAG COMES OFF in the commit that repoints those two linker scripts off
# the 0xA000-0xBFFF hole and re-homes the oversized CPI working sets, per
# BAZEL.md "Known red". It is NOT a carve-out for the boot ROM: flashboot.elf
# sits in :firmware_image_map_test above, untagged, and that target reported it
# 16,060 bytes over before the .noinit fix landed on 2026-08-23.
py_test(
    name = "verification_image_map_test",
    size = "small",
    srcs = ["scripts/check_image_regions.py"],
    args = MAP_ARGS + [
        "--min-images",
        "590",
    ] + [
        "$(rootpaths //verification/isa:all_elfs)",
        "$(rootpaths //verification/cpi:cpi_elfs)",
    ],
    data = MAP_DATA + [
        "//verification/isa:all_elfs",
        "//verification/cpi:cpi_elfs",
    ],
    main = "scripts/check_image_regions.py",
    tags = ["known_red"],
)
