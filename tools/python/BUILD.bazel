load("@rules_python//python:defs.bzl", "py_binary", "py_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "check_doc_links.py",
    "check_entity_defaults.py",
    "check_register_browser.py",
    "npu_vector_regen_diff.py",
    "run_shell_check.py",
    "theme_sync.py",
])

# ---------------------------------------------------------------------------
# Documentation link integrity
# ---------------------------------------------------------------------------

py_binary(
    name = "check_doc_links",
    srcs = ["check_doc_links.py"],
    main = "check_doc_links.py",
)

# The file list the sandboxed run scans. $(SRCS) of a source-file dependency
# expands to workspace-relative paths, which is exactly what --files-from
# wants and what check_doc_links resolves against its --root.
genrule(
    name = "docs_page_manifest",
    srcs = ["//docs:pages"],
    outs = ["docs_page_manifest.txt"],
    cmd = "for f in $(SRCS); do echo $$f; done > $@",
)

# SCANS docs/ pages, with the published TRM PDFs staged as link targets.
# The root README/CHANGELOG/CONTRIBUTING link to assets and per-package
# READMEs scattered across many bazel packages, so staging their target set
# is not worth it here; the standalone git-mode default (CI) still covers
# them.
# --files-from is the strict mode: an unreadable list or listed file is exit 2,
# never a quietly empty scan reported as OK.
py_test(
    name = "check_doc_links_test",
    size = "small",
    srcs = ["check_doc_links.py"],
    args = [
        "--files-from",
        "$(rootpath :docs_page_manifest)",
    ],
    data = [
        ":docs_page_manifest",
        "//:doc_link_targets",
        "//docs:site",
    ],
    main = "check_doc_links.py",
)

# ---------------------------------------------------------------------------
# The theme splicer THEME_ADOPTION.md section 1 promises
# ---------------------------------------------------------------------------

# Writer: run it in the workspace to re-splice vesta_theme.css into every
# marked page. The --check side of it is tested by //docs:theme_sync_test.
py_binary(
    name = "theme_sync",
    srcs = ["theme_sync.py"],
    main = "theme_sync.py",
)

# ---------------------------------------------------------------------------
# The entity-default axis scanner
# ---------------------------------------------------------------------------

# THE GRADED GATE. It bites: no --report-only. The bare invocation holds
# ENABLE_DEBUG to its two-class contract -- false at every core-side
# declaration (vesta and the components standing for it, debug_module,
# jtag_dtm), and equal to the shipped CORE_ENABLE_DEBUG at the hart_tile and
# orch_tile wrappers -- and it also runs the MGMT_HART axis. The wrapper
# requirement is read out of hdl/common/MemoryMap.vhd rather than written into
# the checker, so a knob flip moves the requirement with it instead of leaving
# a stale literal behind (which is what --report-only was papering over from
# 2026-08-21 until this target was re-armed).
#
# The scanner's own liveness is still asserted underneath: it exits 2, not 1,
# if the ENABLE_TRAPCSR control comes back under --control-min sites, so a
# stale scanner or a mis-staged sandbox cannot pass this quietly either.
py_test(
    name = "check_entity_defaults_test",
    size = "small",
    srcs = ["check_entity_defaults.py"],
    args = [
        "--generic",
        "ENABLE_DEBUG",
    ],
    data = [
        "//hdl:vhdl_sources",
        # MCU.template.vhd is one of the scanned emitter sites. Without it the
        # scanner reports MISSING FILE and grades itself INCOMPLETE, which is
        # now a failure rather than a line of console noise.
        "//platform/common:hdl_template_srcs",
        "//platform/common/python:generator_srcs",
    ],
    main = "check_entity_defaults.py",
)

# THE SAME GATE, SECOND GENERIC: the C-extension fetch-ahead, shipped ON
# 2026-08-23. It is a separate target rather than a second flag on the one
# above because the DECL-site floor is per-generic and each target must state
# its own measured value: ENABLE_IF_AHEAD is consumed wholly inside vesta.vhd,
# so it has 4 declaration sites (entity vesta, entity hart_tile, the component
# vesta inside hart_tile.vhd, entity orch_tile) where ENABLE_DEBUG has 5. A
# shared floor would either be too high here or too low there, and a floor that
# is too low is how the scanner goes blind.
#
# The MGMT_HART axis is skipped: it is generic-independent and the ENABLE_DEBUG
# target above already grades it, so running it twice buys nothing.
py_test(
    name = "check_entity_defaults_if_ahead_test",
    size = "small",
    srcs = ["check_entity_defaults.py"],
    args = [
        "--generic",
        "ENABLE_IF_AHEAD",
        "--require-min-decls",
        "4",
        "--skip-mgmt-hart",
    ],
    data = [
        "//hdl:vhdl_sources",
        "//platform/common:hdl_template_srcs",
        "//platform/common/python:generator_srcs",
    ],
    main = "check_entity_defaults.py",
)
