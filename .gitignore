# Generated source / build artifacts
# ─────────────────────────────────────────────────────────────────────────────
# Platform generator outputs (auto-generated)
platform/*/latex/TRM/
platform/*/config/MemoryMap.json

# Build artifacts
verification/isa/build/
# D1 (2026-08-05): the one-off ELF/rcf scratch tree of
# verification/isa/tools/build_one_rcf.sh. It exists precisely so that
# building a single test does NOT touch verification/isa/build/, whose
# .imgset identity change wipes the whole shared build tree -- so it is a
# build artifact by the same argument as the line above it.
verification/isa/build_oneoff/
verification/isa/rcf/
# per-NHARTS image sets built by platform/common `make verify` / A3
# (rcf_argus etc. -- *.rcf contents are already ignored globally; this also
#  drops the .nharts stamp files)
verification/isa/rcf_*/
verification/benchmarks/build/
software/*/obj/
software/*/bin/
# tools/build/linker-scripts/{memory.x,periph.x,*_START.txt,*_SIZE.txt} are
# TRACKED since the CI bring-up (2026-07-18): they are frozen build INPUTS of
# software/bootrom_mp (the Castalia generator never writes to tools/, golden
# rule), and the hosted CI bootrom build needs them from a bare checkout.
# They are the link environment the taped-out rom2k_hvt_pg plate was compiled
# from, NOT a copy of the current generator output, and the boot ROM does not
# link against the current output at all (rv4th .noinit overflows the 8 KiB
# TCM).  //tools/build:rom_plate_link_env_test pins how far the two may drift.

# Software headers (auto-generated)
software/commune/include/MemoryMap.h
software/commune/include/periph.S

