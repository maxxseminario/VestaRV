software/commune/include/MemoryMap.h
software/commune/include/periph.S

# Hardware VHDL (auto-generated)
hardware/Myshkin.vhd

# HDL peripheral blocks (custom IP)
hardware/MCU/peripherals/NPU.vhd
hardware/MCU/periph/SARADC.vhd
hardware/MCU/periph/AFE.vhd
hardware/MCU/periph/AFE_FSM.vhd

# ARM IP
*ARM*

# Compiled binaries
*.o
*.elf
*.bin
