xcelium/riscv_test/innovus_chip/xcelium.d/
xcelium/riscv_test/innovus_chip/log/
xcelium/riscv_test/innovus_chip/*.sdf*
xcelium/riscv_test/innovus_chip/*.out
xcelium/riscv_test/innovus_chip/*.err
xcelium/riscv_test/innovus_chip/*.shm/
xcelium/riscv_test/innovus_chip/*.dsn
xcelium/riscv_test/innovus_chip/*.trn
xcelium/riscv_test/innovus_chip/waves.*
xcelium/riscv_test/innovus_chip/xrun.history
xcelium/riscv_test/innovus_chip/xrun.log
xcelium/riscv_test/innovus_chip/gate_smoke_results.txt
xcelium/riscv_test/innovus_chip/smoke_run.log
