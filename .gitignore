# VestaRV: what git must not track. Ordered rule blocks; the last matching
# pattern wins, so the blanket rules at the bottom override the whitelists above
# them. Inline comments are not supported here: every '#' must start its own line.
#
# The Cadence working directories, ignored wholesale: genus is synthesis, innovus
# place and route, signoff_mp Pegasus DRC and LVS, cpf the Common Power Format,
# xcelium simulation, .cadence session state. They hold roughly 450 GB of
# generated output plus the hand-written flow scripts. Consequence to know: git is
# not the backup for those sources, and a fresh clone cannot rebuild any flow.
# .bazelignore still names all four trees and must keep doing so; tracking a file
# in git and hiding it from bazel are independent concerns.
genus/
innovus/
signoff_mp/
cpf/


.cadence/
# On disk only: std_cells/ is PDK-derived .lef under foundry NDA, hardware/ is
# VHDL superseded by hdl/, .claude/skills/ holds local skill definitions.
std_cells/
hardware/
.claude/skills/

# Teaching material and its chip configuration, untracked but still on disk.
# Nothing tracked is wired to either: platform/common:config_srcs reaches the
# config only through glob(["config/*.json"]), which still satisfies its
# allow_empty=False. The tree is also in .bazelignore, so a local
# `bazel test //...` skips it rather than failing on a package it cannot build.
software/course/
platform/common/config/argus_course.json

# Bench and programmer host tools, untracked but still on disk: the PyEmanate GUI,
# the Forth flash programmer and the UART chip programmer. None is wired into
# anything: no BUILD.bazel, no bazel dependency, no workflow, no markdown link.
# This does not extend to tools/debug, which is active.
tools/PyEmanate/
tools/flash_programmer/
tools/chip_programmer/
# Pegasus and Calibre DRC-LVS run logs.
ic_bad/
# logo/ held *.gds.
logo/

# Foundry and PDK IP. Never commit it: TSMC and every other foundry's PDK data is
# under NDA, and layout, timing, netlist and tech files embed foundry-proprietary
# information.
*.gds
*.gds2
*.oas
*.lef
*.def
*.def.gz
*.sdf
*.spef
*.cdl
*.oa
*.lvs.v
*.route.gz
# any file whose name carries the foundry/PDK name:
*tsmc*

# Generic EDA and simulation intermediates, in case a tool runs outside its tree.
*.rcf
# No .rcf is tracked anywhere, the boot ROM image included: only the source that
# builds it is (software/bootrom_mp/, md5 pinned in software/bootrom_mp/rom_rcf.md5).
*.trn
*.dsn
*.pak
*.svcf
*.diag
INCA_libs/
xcelium.d/
*.shm/
.simvision/
xrun.log
xrun.history
xrun.key

# Generated source and build artifacts. Platform generator outputs first.
platform/*/latex/TRM/
platform/*/config/MemoryMap.json

# Build artifacts
verification/isa/build/
# The one-off ELF and rcf scratch tree of verification/isa/tools/build_one_rcf.sh.
# It exists so that building a single test does not touch verification/isa/build/,
# whose .imgset identity change wipes the whole shared build tree.
verification/isa/build_oneoff/
verification/isa/rcf/
# The per-NHARTS image sets `make verify` builds. Their *.rcf contents are already
# ignored globally; this rule also drops the .nharts stamp files.
verification/isa/rcf_*/
verification/benchmarks/build/
software/*/obj/
software/*/bin/
# tools/build/linker-scripts/{memory.x,periph.x,*_START.txt,*_SIZE.txt} are
# deliberately tracked: they are frozen build inputs of software/bootrom_mp, the
# chip generator never writes into tools/, and the hosted CI bootrom build needs
# them from a bare checkout. They are the link environment the taped-out
# rom2k_hvt_pg plate was compiled from, not a copy of the current generator
# output, and the boot ROM does not link against the current output at all.
# //tools/build:rom_plate_link_env_test pins how far the two may drift.

# Generated firmware headers.
software/commune/include/MemoryMap.h
software/commune/include/periph.S

# Generated VHDL.
hardware/Myshkin.vhd

# Peripheral blocks kept out of the public tree.
hardware/MCU/peripherals/NPU.vhd
hardware/MCU/periph/SARADC.vhd
hardware/MCU/periph/AFE.vhd
hardware/MCU/periph/AFE_FSM.vhd

# ARM IP.
*ARM*
# A narrow exception for hdl/fpga/ only. ARM_IP_RAM.vhd and ARM_IP_ROM.vhd there
# are hand-written synthesisable stand-ins for the compiled macros: project VHDL
# carrying no vendor code, named to mirror the files they replace, which is the
# only reason *ARM* catches them. Without this the FPGA substitution set ships two
# of its four cells. It does not extend to hdl/common/, where the twelve
# behavioural models the pattern hides stay hidden.
!hdl/fpga/ARM_IP_RAM.vhd
!hdl/fpga/ARM_IP_ROM.vhd

# Compiled binaries.
*.o
*.elf
*.bin
# *.hex
*.dump
*.map

# Python cache.
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# LaTeX: keep the .tex sources and the final .pdf, drop every intermediate.
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.bbl
*.blg
*.nav
*.snm
*.vrb
*.fdb_latexmk
*.fls
*.synctex.gz

# Logs and acquisition data.
tools/debug/forth_dashboard/saradc_logs/
tools/debug/fast_saradc/logs/
**/saradc_logs/*.txt
**/fast_saradc_data_*.txt
myshkin_commands.log

# AI assistant instructions: local only, never committed.
CLAUDE.md
**/CLAUDE.md
.claude/
**/.claude/
*.claude.md
**/AGENTS.md

# Editor and IDE state.
.vscode/
.idea/
*.swp
*.swo
*~

# OS files.
.DS_Store
Thumbs.db

# Syncthing.
.stfolder/
*.sync-conflict-*

# Xcelium simulation sources: a default-deny whitelist that versions only the
# hand-authored setup, the run and control scripts, the test and cell lists and
# the testbench sources, and never the multi-GB compiled libraries, waveforms,
# logs and snapshots. It sits near the bottom so it is evaluated late.
#
# Ignore everything under xcelium/ by default.
xcelium/**
# Descend into every subdirectory, so the files below can be re-included.
!xcelium/**/
# Re-include only these source and setup file types.
!xcelium/**/*.sh
!xcelium/**/*.tcl
!xcelium/**/*.do
!xcelium/**/*.vhd
!xcelium/**/*.sv
!xcelium/**/*.svh
!xcelium/**/*.v
!xcelium/**/*.vh
!xcelium/**/*.f
!xcelium/**/*.txt
!xcelium/**/*.md
!xcelium/**/README*
!xcelium/**/Makefile
# Always drop these, even where a rule above matched: the compiled libraries and
# snapshots, waveforms, SimVision state, symbol caches, logs, local AI settings
# and generated RAM images.
xcelium/**/xcelium.d/
xcelium/**/waves.shm/
xcelium/**/.simvision/
xcelium/**/.bpad/
xcelium/**/log/
xcelium/**/.claude/
xcelium/**/ram_images/
xcelium/**/*.svcf
xcelium/**/xrun.key
xcelium/**/xrun.log
xcelium/**/xrun.history
# The `make verify` staging flows. platform/common/verify.sh regenerates them in
# full, .sh, .txt and .vhd included, so they are exempt from the whitelist.
xcelium/riscv_test/verify_*/
# Generated data dumps that happen to be .txt.
xcelium/**/sig_approx_fp.txt
xcelium/**/output_results.txt
xcelium/**/*_actual_*.txt

# Local engineering changelog.
.devlog/

# Publications and conference material, copied in for local reference.
docs/publications/

# No HTML pages in this repository (CI's No-HTML gate enforces it). Local HTML
# notes such as docs/afe_rev2_*.html stay on disk only. The debug dashboard's
# web UI is the one exemption.
*.html
*.htm
!tools/debug/forth_dashboard*/**/*.html

# The generated power dashboard; tools/python/gen_power_dashboard.py rebuilds it.
power_dashboard.html

# The Myshkin AFE bidirectional-current design note, local for now.
implementations/asic/myshkin-2025-11/docs/afe-bidirectional-current-upgrade.html

# Untracked-noise suppression, kept at the very bottom so the xcelium-scoped rules
# here win over the whitelist above.
#
# Syncthing conflict copies. Broader than the *.sync-conflict-* rule above: this
# also catches variants without the trailing dash or the leading dot.
*sync-conflict*

# Innovus and Pegasus session logs dropped in the repo root.
/innovus.cmd
/innovus.log*
/pegasus_ui_gui.log

# signoff_mp: generated foundry OA cell libraries, tool stdout dumps, backups.
signoff_mp/chip_top_signoff/
signoff_mp/chip_argus_signoff/
signoff_mp/pvs/*.stdout
*.jul*.bak

# One-shot debug tooling that stays on disk. It lives inside xcelium/, where *.tcl
# and *.sh are whitelisted above, so it must be re-ignored here, after that
# whitelist.
xcelium/riscv_test/behavioral_mp/m19c_probe*.tcl
xcelium/riscv_test/innovus_mp/diag_*.sh

# The connected-chip gate-sim scratch directories: drop the multi-MB artifacts,
# keep the hand-authored script and setup set.
xcelium/riscv_test/innovus_chip/xcelium.d/
xcelium/riscv_test/innovus_chip/log/
xcelium/riscv_test/innovus_chip/*.sdf*
xcelium/riscv_test/innovus_chip/*.out
xcelium/riscv_test/innovus_chip/*.err
xcelium/riscv_test/innovus_chip/*.shm/
xcelium/riscv_test/innovus_chip/*.dsn
xcelium/riscv_test/innovus_chip/*.trn
xcelium/riscv_test/innovus_chip/waves.*
xcelium/riscv_test/innovus_chip/xrun.history
xcelium/riscv_test/innovus_chip/xrun.log
xcelium/riscv_test/innovus_chip/gate_smoke_results.txt
xcelium/riscv_test/innovus_chip/smoke_run.log
xcelium/riscv_test/innovus_chip_quad/xcelium.d/
xcelium/riscv_test/innovus_chip_quad/log/
xcelium/riscv_test/innovus_chip_quad/*.sdf*
xcelium/riscv_test/innovus_chip_quad/*.out
xcelium/riscv_test/innovus_chip_quad/*.err
xcelium/riscv_test/innovus_chip_quad/*.shm/
xcelium/riscv_test/innovus_chip_quad/*.dsn
xcelium/riscv_test/innovus_chip_quad/*.trn
xcelium/riscv_test/innovus_chip_quad/waves.*
xcelium/riscv_test/innovus_chip_quad/xrun.history
xcelium/riscv_test/innovus_chip_quad/xrun.log
xcelium/riscv_test/innovus_chip_quad/gate_smoke_results.txt
xcelium/riscv_test/innovus_chip_quad/smoke_run.log
# Re-include the hand-authored setup the global rules dropped. *.sh, *.v, *.vhd
# and *.txt already survive the xcelium whitelist above; these four do not, and
# the explicit re-includes win over the *.sdf* and *.rcf globals.
!xcelium/riscv_test/innovus_chip/*.py
!xcelium/riscv_test/innovus_chip/*.rcf
!xcelium/riscv_test/innovus_chip/*.sdfcmd
!xcelium/riscv_test/innovus_chip/cds.lib
!xcelium/riscv_test/innovus_chip_quad/*.py
!xcelium/riscv_test/innovus_chip_quad/*.rcf
!xcelium/riscv_test/innovus_chip_quad/*.sdfcmd
!xcelium/riscv_test/innovus_chip_quad/cds.lib

# xcelium/ is untracked entirely. This blanket rule wins over every !xcelium/**
# re-include above, so the whole tree stays on disk and nothing tracks it.
xcelium/
innovus.cmd*

# Bazel: the convenience symlinks into the output base, and per-user rc overrides.
# MODULE.bazel.lock is deliberately not ignored; it is committed for
# reproducibility.
bazel-bin
bazel-out
bazel-testlogs
bazel-vestarv
.bazelrc.user
# The bazelisk binary itself is fetched by tools/get_bazel.sh, not committed.
tools/bin/bazel

