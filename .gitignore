# ─────────────────────────────────────────────────────────────────────────────
# EDA tool working directories (Cadence) — entirely generated, never committed
# ─────────────────────────────────────────────────────────────────────────────
# genus  = synthesis, innovus = place & route, xcelium = simulation, .cadence = session state
genus/
innovus/
xcelium/
.cadence/
ic_bad/          # Pegasus/Calibre DRC-LVS run logs
logo/            # contained *.gds

# ─────────────────────────────────────────────────────────────────────────────
# FOUNDRY / PDK IP — NEVER commit. TSMC (and any foundry) PDK data is under NDA.
# Layout, timing, netlist, and tech files embed foundry-proprietary information.
# ─────────────────────────────────────────────────────────────────────────────
*.gds
*.gds2
*.oas
*.lef
*.def
*.def.gz
*.sdf
*.spef
*.cdl
*.oa
*.lvs.v
*.route.gz
*tsmc*           # any file whose name carries the foundry/PDK name

# Generic EDA/simulation intermediates (in case tools run elsewhere)
*.rcf
*.trn
*.dsn
*.pak
*.svcf
*.diag
INCA_libs/
xcelium.d/
*.shm/
.simvision/
xrun.log
xrun.history
xrun.key

# ─────────────────────────────────────────────────────────────────────────────
# Generated source / build artifacts
# ─────────────────────────────────────────────────────────────────────────────
# Platform generator outputs (auto-generated)
platform/latex/TRM/
platform/config/MemoryMap.json

# Build artifacts
verification/isa/build/
verification/isa/rcf/
verification/benchmarks/build/
software/*/obj/
software/*/bin/
tools/build/linker-scripts/*.x
tools/build/linker-scripts/*.txt

# Software headers (auto-generated)
software/commune/include/MemoryMap.h
software/commune/include/periph.S

# Hardware VHDL (auto-generated)
hardware/Myshkin.vhd

# HDL peripheral blocks (custom IP)
hardware/MCU/peripherals/NPU.vhd
hardware/MCU/periph/SARADC.vhd
hardware/MCU/periph/AFE.vhd
hardware/MCU/periph/AFE_FSM.vhd

# ARM IP
*ARM*

# Compiled binaries
*.o
*.elf
*.bin
# *.hex
*.dump
*.map

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# ─────────────────────────────────────────────────────────────────────────────
# LaTeX — keep only sources (.tex) and final output (.pdf); ignore everything else
# ─────────────────────────────────────────────────────────────────────────────
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.bbl
*.blg
*.nav
*.snm
*.vrb
*.fdb_latexmk
*.fls
*.synctex.gz

# ─────────────────────────────────────────────────────────────────────────────
# Logs & acquisition data
# ─────────────────────────────────────────────────────────────────────────────
tools/debug/forth_dashboard/saradc_logs/
tools/debug/fast_saradc/logs/
**/saradc_logs/*.txt
**/fast_saradc_data_*.txt
myshkin_commands.log

# ─────────────────────────────────────────────────────────────────────────────
# AI assistant instructions (local only, not committed)
# ─────────────────────────────────────────────────────────────────────────────
CLAUDE.md
**/CLAUDE.md

# ─────────────────────────────────────────────────────────────────────────────
# Editor / IDE
# ─────────────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─────────────────────────────────────────────────────────────────────────────
# OS files
# ─────────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─────────────────────────────────────────────────────────────────────────────
# Syncthing
# ─────────────────────────────────────────────────────────────────────────────
.stfolder/
*.sync-conflict-*
