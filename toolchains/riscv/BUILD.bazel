# Anchor package for the hermetic RISC-V toolchain overlay (xpack_gcc.BUILD).
# The @xpack_riscv_gcc repository is declared in MODULE.bazel; firmware rules
# consume its filegroups directly.

exports_files(["xpack_gcc.BUILD"])

# Sandboxed compile+link proof for the hermetic toolchain, covering the
# host-glibc ld shim path. If this target builds, the toolchain works here.
genrule(
    name = "smoke_elf",
    srcs = ["smoke.c"],
    outs = ["smoke.elf"],
    cmd = "$(location @xpack_riscv_gcc//:gcc) -march=rv32i -mabi=ilp32 " +
          "-nostartfiles -Wl,-e,main $(location smoke.c) -o $@",
    tools = [
        "@xpack_riscv_gcc//:gcc",
        "@xpack_riscv_gcc//:toolchain",
    ],
    visibility = ["//visibility:private"],
)
