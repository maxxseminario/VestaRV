# VestaRV: GHDL toolchain wiring for the open-source simulation tier.
#
# The patch below is referenced from MODULE.bazel's single_version_override for
# the ghdl module, so it has to be an exported source file of a real package.

load("@rules_python//python:defs.bzl", "py_binary", "py_test")

package(default_visibility = ["//visibility:public"])

exports_files(["ghdl_system_ld.patch"])

# Convenience aliases so nothing outside this package has to know that the
# simulator comes from an external module, or which backend it is built with.
alias(
    name = "ghdl",
    actual = "@ghdl//:ghdl_mcode",
)

alias(
    name = "vhdl_libs_v08",
    actual = "@ghdl//:vhdl_libs_v08",
)

# The synthesizability gate and its census

# Two roles in one script (run / gate), so the raw-netlist parser has exactly
# one definition.  It is a build TOOL for ghdl_synth_test's synth action and
# the test BINARY that reads the census that action wrote.  Counts are NOT
# frozen against a table: the design moves constantly, and a frozen census
# only failed on every legitimate RTL change.
py_binary(
    name = "synth_census",
    srcs = ["synth_census.py"],
    main = "synth_census.py",
)

exports_files([
    "synth_census.py",
    "synth_coverage.py",
])

# The file list synth_coverage_test reads, one path per line.  Same shape
# and same reason as //tools/ci:vhdl_source_manifest: args built out of
# $(rootpaths ...) are shell-tokenized, which quietly loses any path
# containing a space, and a 25-entry list on a command line is unreadable in
# a failure message.  $(rootpaths) rather than $(SRCS) because these are
# GENERATED files, whose exec path and runfiles path differ.
genrule(
    name = "census_manifest",
    testonly = True,
    srcs = ["//hdl/common/synth:synth_censuses"],
    outs = ["census_manifest.txt"],
    cmd = "for f in $(rootpaths //hdl/common/synth:synth_censuses); do echo $$f; done > $@",
)

# The coverage gate: no RTL file may dodge the census

# Every VHDL file under hdl/, one path per line, for the same reason
# //tools/ci:vhdl_source_manifest exists: $(SRCS) expanded into an args list is
# shell-tokenized, and a two-thousand-entry command line is unreadable in a
# failure message.  $(SRCS) rather than $(rootpaths) because these are SOURCE
# files, whose exec path is already the workspace-relative path.
genrule(
    name = "vhdl_source_manifest",
    testonly = True,
    srcs = ["//hdl:vhdl_sources"],
    outs = ["vhdl_source_manifest.txt"],
    cmd = "for f in $(SRCS); do echo $$f; done > $@",
)

# PROVES that every entity declared under hdl/common/ is synthesized by
# something: it is either the top of a ghdl_synth_test (a documented skip
# counts, because a skip is a recorded decision) or it appears in the
# elaborated hierarchy of one, which the census records module by module.
#
# WHY THE PER-BLOCK GATE IS NOT ENOUGH.  //hdl/common/synth:synth grades the
# blocks that HAVE a target.  Nothing graded the list itself, so a new .vhd under
# hdl/common/ that no target names and no graded block instantiates was simply
# never synthesized, and both gates stayed green while the coverage shrank as
# a fraction of the tree.  This is the gate a new RTL file trips on the commit
# that adds it.
#
# The exclusion list, one documented reason per entry, is EXCLUSIONS in
# synth_coverage.py.  An exclusion that matches no file is a FAILURE, not a
# no-op, so a licence to skip cannot outlive the file it was written for.
py_test(
    name = "synth_coverage_test",
    size = "small",
    srcs = ["synth_coverage.py"],
    args = [
        "--sources-from",
        "$(rootpath :vhdl_source_manifest)",
        "--census-from",
        "$(rootpath :census_manifest)",
    ],
    data = [
        "//hdl:vhdl_sources",
        "//hdl/common/synth:synth_censuses",
        ":census_manifest",
        ":vhdl_source_manifest",
    ],
    main = "synth_coverage.py",
)
