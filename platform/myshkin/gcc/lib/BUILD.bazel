# VestaRV: myshkin platform support files consumed by the firmware builds.
#
# Checked-in snapshots of chip generator output. The application makefiles under software/
# prefer this directory over tools/build/linker-scripts whenever linker/memory.x exists; it
# does and it is tracked, so the bazel rules use these files unconditionally. This BUILD file
# only gives the files a package; nothing here is generated at build time.

package(default_visibility = ["//visibility:public"])

# -I directory contents: the register map header and the assembler view.
filegroup(
    name = "platform_headers",
    srcs = [
        "include/MemoryMap.h",
        "include/periph.S",
    ],
)

# memory.x and periph.x, pulled in by the INCLUDE lines in MCU.ld. The linker
# resolves them out of the -L search path.
filegroup(
    name = "linker_fragments",
    srcs = [
        "linker/memory.x",
        "linker/periph.x",
    ],
)
