{
  "_comment": "CastaliaB: config/castalia.json with hart 0's ISA and privilege set turned all the way up; the chip shape, peripheral set, memory map and package are Castalia's. Build with: make chip CONFIG=config/castalia_b.json ; prove with: make verify CONFIG=config/castalia_b.json",

  "chipName": "CastaliaB",
  "numHarts": 5,
  "orchestrator": true,

  "isa": {
    "mul": true,
    "fastMul": true,
    "div": true,
    "atomics": true,
    "compressed": true,
    "bitmanip": true,
    "minimalTiles": true,
    "counters": true,
    "counters64": true,
    "zicond": true,
    "zcb": true,
    "zimop": true,
    "zihint": true,
    "zihpm": true,
    "zawrs": true,
    "zabha": true,
    "zacas": true,
    "zicboz": true,
    "zcmp": true,
    "zcmt": true,
    "zbkb": true,
    "zbkc": true,
    "zbkx": true,
    "zkn": true,
    "zfinx": true
  },

  "priv": {
    "trapCsr": true,
    "umode": true,
    "pmp": true,
    "pmpEntries": 16
  },

  "debug": {
    "enable": true
  },

  "core": {
    "fetchAhead": true
  },

  "peripherals": {
    "cqAfeStubs": false,
    "qspi": true,
    "i3c": true,
    "nfc": true,
    "rtc": true,
    "pwm": true,
    "onewire": true,
    "fieldPower": true,
    "dma": true,
    "dmaChannels": 4,
    "i2ctarget": true,
    "trng": true,
    "eventFabric": true
  },

  "package": {
    "model": "castalia-lqfp100",
    "preliminary": true
  }
}
