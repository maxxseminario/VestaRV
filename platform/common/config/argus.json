{
  "_comment": "Argus: the frozen 18-hart teaching chip, no orchestrator and no NPU. Build with: make chip CONFIG=config/argus.json ; prove with: make verify CONFIG=config/argus.json",

  "chipName": "Argus",
  "numHarts": 18,
  "orchestrator": false,
  "numMutexes": 32,

  "memory": {
    "romSize": 8192,
    "tcmSizePerHart": 16384,
    "sharedBulkRamSize": 131072
  },

  "isa": {
    "compressed": true,
    "mul": true,
    "fastMul": true,
    "div": true,
    "atomics": true,
    "bitmanip": true,
    "counters": false,
    "counters64": false
  },

  "peripherals": {
    "npu": false,
    "cqAfeStubs": true,
    "qspi": false,
    "i3c": false,
    "rtc": false,
    "pwm": false,
    "onewire": false,
    "dma": false,
    "i2ctarget": false,
    "trng": false,
    "eventFabric": false
  },

  "debug": {
    "enable": false
  },

  "package": {
    "model": "myshkin-qfn44"
  }
}
