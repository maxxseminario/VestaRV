{
  "_comment": "ArgusDebug: config/argus.json plus the Debug Module, the only 18-hart proof that the DM elaborates; it wears castalia-lqfp100 because that is the one package model bonding the JTAG TAP. Prove with: SUITE=full MAX_PARALLEL=6 make verify CONFIG=config/argus_debug.json",

  "chipName": "ArgusDebug",
  "numHarts": 18,
  "orchestrator": false,
  "numMutexes": 32,

  "memory": {
    "romSize": 8192,
    "tcmSizePerHart": 16384,
    "sharedBulkRamSize": 131072
  },

  "isa": {
    "compressed": true,
    "mul": true,
    "fastMul": true,
    "div": true,
    "atomics": true,
    "bitmanip": true,
    "counters": false,
    "counters64": false
  },

  "peripherals": {
    "npu": false,
    "cqAfeStubs": true,
    "qspi": false,
    "i3c": false,
    "rtc": false,
    "pwm": false,
    "onewire": false,
    "dma": false,
    "i2ctarget": false,
    "trng": false,
    "eventFabric": false
  },

  "debug": {
    "enable": true
  },

  "package": {
    "model": "castalia-lqfp100"
  }
}
