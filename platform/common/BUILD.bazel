# ---------------------------------------------------------------------------
# The standing gates, as tests.
#
# Every one of them runs through //platform/common/bazel:check_runner, which
# gives them a scrubbed environment, absolute-path resolution, and (for the two
# checks that derive their inputs from their own __file__) a staged tree with
# the layout they expect. No check script is modified and none of them can see
# the source tree's out/ or config/. Arguments after the bare "--" go to the
# check script untouched.
# ---------------------------------------------------------------------------

CHECK_RUNNER = "//platform/common/bazel:check_runner.py"

# The generated MCU.vhd must be a byte-for-byte drop-in for the tracked
# hdl/common/MCU.vhd, header comment aside. This is the RTL-generation bar.
py_test(
    name = "check_mcu_vhd_test",
    size = "small",
    srcs = [CHECK_RUNNER],
    args = [
        "--script=platform/common/python/check_mcu_vhd.py",
        "--",
        "$(rootpath :castalia_mcu_vhd)",
        "hdl/common/MCU.vhd",
    ],
    data = [
        ":castalia_mcu_vhd",
        "//hdl:vhdl_sources",
        "//platform/common/python:check_mcu_vhd.py",
    ],
    main = "check_runner.py",
)

# Constant-by-constant equivalence with the tracked memory-map package. Both
