# ---------------------------------------------------------------------------
# SystemRDL gates (tools/rdl/README.md, report R1).
#
# rdl_vs_vhdl_<periph>_test: the .rdl description and the VHDL that implements it
# decode the same registers. The VHDL is the authority, so these read the RTL
# source, not a generated artifact: for the UART pilot the RegSlotUARTx*
# constants of the tracked memory-map package plus UART.vhd's own storage signals,
# reset branch and write-1-to-clear arm.
#
# rdl_vs_generator_test: the .rdl offsets equal the generated slot map, and then
# every register, field, reset value and description config/MemoryMap.json carries.
# Since report R5 most peripherals' templates ARE built from the .rdl, so for them
# this is a self-consistency check on the loader and the emitters rather than a
# comparison of two authors; for CLINT, MUTEX, IRQROUTER and PWRCTRL, whose tables
# are still hand-written because their register set is a function of the
# configuration, it remains the original cross-check. It also holds
# config/rdl.json's registerSource flags and generate.py to the same story, which
# is what stops a deleted table from quietly coming back. It runs against
# config/castalia.json, the tape-out configuration, which instantiates every
# peripheral config/rdl.json flags.
# ---------------------------------------------------------------------------

# The SystemRDL emission as a runnable target: the same code generate.py calls,
# but with @rdl_deps in its runfiles, so it actually runs. It writes into the
# SOURCE tree, exactly as `bazel run //:generate` does and for the same reason
# (the artifacts are additive documentation, not build inputs).
py_binary(
    name = "rdl_generate",
    srcs = ["//platform/common/python:rdl_emit.py"],
    data = [
        "//hdl:rdl_sources",
        ":rdl_config",
    ],
    main = "rdl_emit.py",
    deps = ["//platform/common/python:rdl_lib"],
)

[
    py_test(
        name = "rdl_vs_vhdl_" + periph + "_test",
        size = "small",
        srcs = ["//platform/common/python:rdl_vs_vhdl_test.py"],
        args = ["--periph=" + periph],
        data = [
            "//hdl:rdl_sources",
            "//hdl:vhdl_sources",
        ],
        main = "rdl_vs_vhdl_test.py",
        deps = ["//platform/common/python:rdl_test_lib"],
    )
    for periph in [
        "uart",
        # The twenty house-style blocks (R2, 2026-09-10). One shared reader --
        # makeGenericReader in rdl_vs_vhdl_test.py -- covers all of them: slot
        # constants (local SLOT_*, the memory-map package's RegSlot*, NPU's
        # MmrAddr*, or a literal table guarded by `require` patterns) and the
        # reset branch of the register-write process.
        "clint",
        "dma",
        "evfab",
        "gpio",
        "i2c",
        "i2ctarget",
        "i3c",
        "irq_router",
        "mutex_bank",
        "nfc",
        "npu",
        "onewire",
        "pwm",
        "pwr_ctrl",
        "qspi",
        "rtc",
        "spi",
        "system",
        "timer",
        "trng",
    ]
]

# SystemRDL LEVEL 2 (report R6). A migrated entity no longer declares its own
# word offsets, field ranges, IMPL masks or reset tables: those are generated
# from the .rdl into hdl/common/regs/vhdl/<block>_regs_pkg.vhd, which the entity
# `use`s. Two gates hold that down, and they are deliberately different kinds of
# gate:
#
#   rdl_vhdl_pkg_test       the TRACKED package is byte-identical to a fresh
#                           emission -- the same role check_memorymap_vhd_test
#                           plays for the generated memory-map package.
#   rdl_pkg_vs_legacy_test  every value in the tracked package equals the
#                           hand-written constant it replaced, transcribed from
#                           the pre-migration revision. This is the leg of the
#                           argument that does NOT run through the .rdl: with the
#                           decode's independent copy gone, rdl_vs_vhdl_<periph>_test
#                           now reads the package, so something outside the
#                           SystemRDL path has to hold the numbers.
py_test(
    name = "rdl_vhdl_pkg_test",
    size = "small",
    srcs = ["//platform/common/python:rdl_vhdl_pkg_test.py"],
    data = [
        "//hdl:rdl_sources",
        "//hdl:vhdl_sources",
    ],
    main = "rdl_vhdl_pkg_test.py",
    deps = ["//platform/common/python:rdl_test_lib"],
)

# No @rdl_deps: it parses the tracked package text, which is the artifact the RTL
# compiles. Running the emitter here would grade the emitter against itself.
py_test(
    name = "rdl_pkg_vs_legacy_test",
    size = "small",
    srcs = ["//platform/common/python:rdl_pkg_vs_legacy_test.py"],
    data = [
        # The frozen table for the twenty-two blocks of report R8a.
        "//platform/common/python:rdl_legacy_constants.json",
        "//hdl:vhdl_sources",
    ],
    main = "rdl_pkg_vs_legacy_test.py",
)

# ---------------------------------------------------------------------------
# The firmware register headers (report R6): software/include/regs/*.h, emitted
# from the chip addrmap through stock PeakRDL-cheader. Three gates.
# ---------------------------------------------------------------------------

# Identity + address consistency. The MemoryMap.h handed in is the DEFAULT
# generation's, which since 2026-09-12 IS the tape-out configuration and is
# therefore still the one that instantiates every peripheral these headers
# describe.
py_test(
    name = "regs_headers_identity_test",
    size = "small",
    srcs = ["//platform/common/python:regs_headers_test.py"],
    args = [
        "--memorymap-h=$(rootpath :castalia_memorymap_h)",
        "TestHeadersAreCurrent",
    ],
    data = [
        ":castalia_memorymap_h",
        ":rdl_config",
        "//hdl:rdl_sources",
        "//software/include:regs_headers",
    ],
    main = "regs_headers_test.py",
    deps = ["//platform/common/python:rdl_regs_lib"],
)

py_test(
    name = "regs_headers_vs_memorymap_test",
    size = "small",
    srcs = ["//platform/common/python:regs_headers_test.py"],
    args = [
        "--memorymap-h=$(rootpath :castalia_memorymap_h)",
        "TestHeadersAgreeWithMemoryMapH",
    ],
    data = [
        ":castalia_memorymap_h",
        ":rdl_config",
        "//hdl:rdl_sources",
        "//software/include:regs_headers",
    ],
    main = "regs_headers_test.py",
    deps = ["//platform/common/python:rdl_regs_lib"],
)

# The compile gate: a translation unit that USES every object-like macro the
# headers define, compiled freestanding at -Wall -Wextra -Werror by the same
# hermetic RISC-V gcc check_memorymap_h_test uses.
py_test(
    name = "regs_headers_compile_test",
    size = "small",
    srcs = [CHECK_RUNNER],
    args = [
        "--script=platform/common/python/check_regs_headers.py",
        "--env=RISCV_CC=abs:$(rootpath @xpack_riscv_gcc//:gcc)",
        "--",
        "abs:software/include/regs",
        "--memorymap-h",
        "abs:$(rootpath :castalia_memorymap_h)",
    ],
    data = [
        ":castalia_memorymap_h",
        "//platform/common/python:check_regs_headers.py",
        "//software/include:regs_headers",
        "@xpack_riscv_gcc//:gcc",
        "@xpack_riscv_gcc//:toolchain",
    ],
    main = "check_runner.py",
)

