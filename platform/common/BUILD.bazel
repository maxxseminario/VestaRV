load("@rules_python//python:defs.bzl", "py_binary", "py_test")
load("//platform/common/bazel:chipgen.bzl", "chip_artifact", "chip_artifacts")

package(default_visibility = ["//visibility:public"])

# ---------------------------------------------------------------------------
# THE MEASURED ANALOG CHAPTER IS NOT WIRED IN YET.
#
# LatexUserGuide.CopyAnalogChapter reads implementations/asic/<chip>/analog/ and
# splices it into the TRM. Those files sit in the ROOT package (implementations/
# has no BUILD file of its own) where their default visibility is private, so
# they can be neither globbed nor labelled from here, and platform/common is the
# only package this agent owns.
#
# //BUILD.bazel exports the measured analog chapter (data/raw excluded), so the
# generation stages it and the TRM carries the full chapter;
# :castalia_analog_chapter_test asserts it stays present.
CASTALIA_ANALOG = ["//:castalia_analog_chapter"]

# ---------------------------------------------------------------------------
# Generator inputs that live under the chip root.
# python/ and bazel/ are their own packages, so the globs here never reach them.
# ---------------------------------------------------------------------------

filegroup(
    name = "hdl_template_srcs",
    srcs = glob(
        ["hdl_templates/*.vhd"],
        allow_empty = False,
    ),
)

filegroup(
    name = "peripheral_intro_srcs",
    srcs = glob(
        ["latex/PeripheralIntroductions/*.tex"],
        allow_empty = False,
    ),
)

# Everything under latex/ that is an INPUT. latex/TRM/ is generator OUTPUT and is
# gitignored, so it is not globbed -- except for the two hand-written *_man.tex
# wrappers, which are tracked on purpose and which the generated TRM \inputs.
filegroup(
    name = "latex_srcs",
    srcs = [":peripheral_intro_srcs"] + glob(
        [
            "latex/*.tex",
            "latex/figures/**",
            "latex/matplotlib/**",
        ],
        allow_empty = False,
    ) + glob(
        ["latex/TRM/include/*_man.tex"],
        allow_empty = False,
    ),
)

# The hand-written / hand-exported chip configurations. The three generator
# OUTPUTS that also land in config/ are excluded: they are results, not inputs,
# and depending on them would make the action depend on the last local build.
# The per-peripheral SystemRDL adoption flags (tools/rdl/README.md). Named on its
# own so the RDL emitters and gates depend on this one file rather than on the
# whole config glob.
filegroup(
    name = "rdl_config",
    srcs = ["config/rdl.json"],
)

filegroup(
    name = "config_srcs",
    srcs = glob(
        ["config/*.json"],
        exclude = [
            "config/ChipConfig.resolved.json",
            "config/MemoryMap.json",
            "config/PadRing.json",
        ],
        allow_empty = False,
    ),
)

# Inputs the generator reaches for ABOVE the chip root, staged at their
# workspace-relative paths so LatexUserGuide's '/../../../' arithmetic lands on
# them unchanged. //hdl:vhdl_sources is coarser than the one file actually read
# (hdl/common/periph/NPU.vhd), but hdl/ exports no finer label.
OUT_OF_TREE_SRCS = ["//hdl:vhdl_sources"] + CASTALIA_ANALOG

CHIP_ROOT_SRCS = [
    ":config_srcs",
    ":hdl_template_srcs",
    ":latex_srcs",
]

# ---------------------------------------------------------------------------
# The generation actions.
# ---------------------------------------------------------------------------

chip_artifacts(
    name = "chip_artifacts_castalia",
    srcs = ["//platform/common/python:generator_srcs"],
    chip_root_srcs = CHIP_ROOT_SRCS,
    out_of_tree_srcs = OUT_OF_TREE_SRCS,
)

# A second, identical generation. Two separate actions in two separate staged
# trees, so :generation_determinism_test can byte-compare them and prove the
# generator has no wall-clock or ordering nondeterminism left in it.
chip_artifacts(
    name = "chip_artifacts_castalia_repro",
    srcs = ["//platform/common/python:generator_srcs"],
    chip_root_srcs = CHIP_ROOT_SRCS,
    out_of_tree_srcs = OUT_OF_TREE_SRCS,
)

# Argus (18 harts, 32 mutexes). There are no identity gates for it -- the tracked
# RTL is Castalia's -- so the bar is that the configuration still generates and
# its machine-readable outputs still parse (:argus_generation_test).
chip_artifacts(
    name = "chip_artifacts_argus",
    srcs = ["//platform/common/python:generator_srcs"],
    chip_root_srcs = CHIP_ROOT_SRCS,
    config = "config/argus.json",
    out_of_tree_srcs = ["//hdl:vhdl_sources"],
)

# MCU_hart (1 hart, no orchestrator, minimal peripheral set). The DRC/LVS
# vehicle: one hardened hart_tile, the shared fabric it masters, and the AFE
# stub bank, with everything optional dropped. There are no identity gates for
# it either -- the tracked RTL is Castalia's -- so the bar here is that the
# configuration generates and its machine-readable outputs parse
# (:mcu_hart_generation_test). What it emits is ALSO elaborated and BOOTED, by
# //opensource_sim/mcu_hart, which consumes the two labels below.
chip_artifacts(
    name = "chip_artifacts_mcu_hart",
    srcs = ["//platform/common/python:generator_srcs"],
    chip_root_srcs = CHIP_ROOT_SRCS,
    config = "config/mcu_hart.json",
    out_of_tree_srcs = ["//hdl:vhdl_sources"],
)

# FPGA (1 hart, no orchestrator, nothing that has no FPGA counterpart). The
# bring-up vehicle for the synthesizable cells in hdl/fpga/. The tracked RTL is
# Castalia's here too, so the bar is that the configuration still generates and
# its machine-readable outputs still parse (:fpga_generation_test). What binds
# against it is not built here: hdl/fpga/README.md carries the elaboration
# recipe, which needs a simulator this build does not provision.
chip_artifacts(
    name = "chip_artifacts_fpga",
    srcs = ["//platform/common/python:generator_srcs"],
    chip_root_srcs = CHIP_ROOT_SRCS,
    config = "config/fpga.json",
    out_of_tree_srcs = ["//hdl:vhdl_sources"],
)

