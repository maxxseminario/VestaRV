# ---------------------------------------------------------------------------
# THE TAPE-OUT CONFIGURATION HAS NO TARGET FAMILY OF ITS OWN (2026-09-12).
#
# It used to: `chip_artifacts_castalia_tapeout` plus castalia_tapeout_memorymap_h,
# _config_memorymap_json, _padring_tcl, _trm_tree and three tests, built from
# config/castalia.json while the unsuffixed `castalia` targets above were the
# default-knob generation. Owner decision: ONE default silicon chip. The
# generator's built-in defaults ARE config/castalia.json now, so the two
# generations are byte-identical apart from the provenance field `configFile`,
# and the suffixed family was a second build of the same chip. It is gone, and
# every consumer -- the register gates below included -- reads the default
# family. config/castalia.json stays on disk as the explicit, named form of the
# configuration (`make verify CONFIG=config/castalia.json`, and what the private
# analog overlay configs document themselves against), and it now states only
# chipName. Nothing in the build grades that file; the identity between it and
# the defaults is a migration-time result, not a standing gate.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# CastaliaB (owner decision 2026-09-12): config/castalia.json with hart 0 turned
# all the way up. Same chip shape, peripheral set, memory map and package; the
# orchestrator carries every selectable isa.* extension plus U-mode and PMP at 16
# entries, and isa.minimalTiles holds harts 1-4 at rv32iac.
#
# THE TILE ISA, since 2026-09-12: the generator's split covers every knob under
# isa.* and priv.* (the TILE_ENABLE_* set, mcu_vhd.py coreGenericLines), so a
# knob turned on for hart 0 here is OFF in the hardened tile netlist. This
# configuration is what found the older, three-constant split (P10 finding F1,
# where the tiles inherited Zfinx, Zkn and PMP) and it is the regression test
# for the wider one: its tile class must stay rv32iac however loud hart 0 is.
#
# There is no tracked RTL for this configuration -- the tracked pair is the
# default generation -- so the bar is that it generates and its outputs parse.
# It additionally gets its own determinism pair, because an all-on ISA walks
# emitter paths (Zfinx, Zkn, the PMP CSR bank) the default generation never does.
# ---------------------------------------------------------------------------
chip_artifacts(
    name = "chip_artifacts_castalia_b",
    srcs = ["//platform/common/python:generator_srcs"],
    chip_root_srcs = CHIP_ROOT_SRCS,
    config = "config/castalia_b.json",
    out_of_tree_srcs = OUT_OF_TREE_SRCS,
)

# The second, identical generation :castalia_b_generation_determinism_test byte-
# compares against, exactly as :chip_artifacts_castalia_repro does for the
# default-knob generation.
