# VestaRV: the chip generator's python sources and their gates.

load("@rdl_deps//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

# The chip generator's real library modules, and nothing else.
#
# generate.py is deliberately NOT here: it is a SCRIPT, not a module -- importing
# it runs a whole generation, writing out/, config/*.json and latex/TRM/. The
# check_* scripts are excluded too; they are standalone textual checkers with no
# dependency on these modules, and each gets its own target below.
py_library(
    name = "chipgen_lib",
    srcs = [
        "BitField.py",
        "CRC.py",
        "ChipGenerator.py",
        "GpioConfigurator.py",
        "LatexUserGuide.py",
        "Package.py",
        "Peripheral.py",
        "Register.py",
        "TabbedTable.py",
        "mcu_vhd.py",
        "overlay.py",
        "tb_vhd.py",
        "web_export.py",
    ],
    imports = ["."],
)

# generate.py as a runnable binary, for `bazel run //:generate`.
#
#   bazel run //:generate -- --config platform/common/config/asic_default.json --out /tmp/x
#
# It reads its inputs from the source tree bazel names in BUILD_WORKSPACE_DIRECTORY, and
# relative --config/--out paths resolve against that too, since `bazel run` starts the binary
# in its runfiles tree. WARNING: with no --out it writes INTO the source tree, exactly where
# `make generate` would. The hermetic path is //platform/common:chip_artifacts_castalia, which
# runs the same script inside a staged copy and declares its outputs.
py_binary(
    name = "generate",
    srcs = ["generate.py"],
    data = [
        "//hdl:rdl_sources",
        "//platform/common:rdl_config",
        "//platform/common:config_srcs",
        "//platform/common:hdl_template_srcs",
        "//platform/common:latex_srcs",
        "//hdl:vhdl_sources",
        "//:castalia_analog_chapter",
],
    deps = [
        ":chipgen_lib",
        ":rdl_lib",
    ],
)

# Every generator source, for staging into the hermetic generation action.
filegroup(
    name = "generator_srcs",
    srcs = glob(
        ["*.py"],
        allow_empty = False,
    ),
)

# The standing gate scripts, for staging into the check tests.
filegroup(
    name = "check_scripts",
    srcs = glob(
        [
            "check_*.py",
            "splice_*.py",
        ],
        allow_empty = False,
    ),
)

exports_files(glob(
    [
        "check_*.py",
        "splice_*.py",
        "generate.py",
    ],
    allow_empty = False,
))

# The check_* scripts as runnable binaries. The TESTS that point them at the
# generated artifacts live in //platform/common, next to the generation rule.
[
    py_binary(
        name = script[:-len(".py")],
        srcs = [script],
    )
    for script in [
        "check_config_defaults.py",
        "check_configurator_sync.py",
        "check_intro_names.py",
        "check_mcu_vhd.py",
        "check_memorymap_h.py",
        "check_memorymap_vhd.py",
        "check_riscv_tb_vhd.py",
        "splice_web_data.py",
        "splice_register_browser.py",
    ]
]

# Pure textual self-check of generate.py: every knob's two default literals
# (the _CONFIG_SCHEMA entry and its _cfg() call site) must agree. The Makefile
# runs this BEFORE generation, so it needs no generated input at all and reads
# generate.py straight out of the runfiles tree.
py_test(
    name = "check_config_defaults_test",
    size = "small",
    srcs = ["check_config_defaults.py"],
    data = ["generate.py"],
    main = "check_config_defaults.py",
)

# SystemRDL (tools/rdl/README.md). rdl_model.py compiles a .rdl description into
# the generator's own RegisterTemplate/BitField objects, and every emitter below
# consumes those, so an .rdl peripheral reaches the TRM, the C header, the RTL
# and the configurator through the code paths that are already gated.
#
# :rdl_lib is NOT folded into :chipgen_lib, but generate.py now DEPENDS on it:
# most peripheral register maps are loaded from the .rdl descriptions rather than
# written out in generate.py. The hermetic generation action gets the
# same closure through //platform/common/bazel:stage_generate, which puts it on
# the generator subprocess's PYTHONPATH, and the .rdl files themselves through
# chipgen.bzl's _rdl_srcs.

py_library(
    name = "rdl_lib",
    srcs = [
        "rdl_cheader.py",
        "rdl_configurator.py",
        # generate.py's tail imports rdl_emit for the SystemRDL side artifacts
        # (out/rdl/*, the DEBUG register table the TRM inputs), so `bazel run
        # //:generate` needs it in the runfiles, not only on the hermetic
        # action's PYTHONPATH.
        "rdl_emit.py",
        "rdl_latex.py",
        "rdl_model.py",
        "rdl_vhdl.py",
        "rdl_vhdl_pkg.py",
    ],
    imports = ["."],
    deps = [
        ":chipgen_lib",
        requirement("systemrdl-compiler"),
    ],
)

# The .rdl descriptions vs the VHDL that implements them, and vs the generator's
# own register data. Both are declared in //platform/common, next to the
# generation rules whose artifacts they consume; only the sources live here.
exports_files([
    "check_regs_headers.py",
    "package_die_row_test.py",
    "rdl_negative_control_test.py",
    "regs_headers_test.py",
    # The frozen constant table rdl_pkg_vs_legacy_test grades the generated
    # packages against. Data, not source: it is checked in, never
    # regenerated by a gate, and hand-edited when a register deliberately moves.
    "rdl_legacy_constants.json",
    "rdl_legacy_snapshot.py",
    "rdl_pkg_vs_legacy_test.py",
    "rdl_vhdl_pkg_test.py",
    "rdl_vs_generator_test.py",
    "rdl_vs_vhdl_test.py",
])

# rdl_chip.py without the testonly tag: the whole-chip binding (instance names,
# base addresses, per-instance reset values) is also what the firmware header
# emitter needs, and that is a build tool, not a test.
py_library(
    name = "rdl_chip_lib",
    srcs = [
        "rdl_chip.py",
        "rdl_emit.py",
    ],
    imports = ["."],
    deps = [":rdl_lib"],
)

py_library(
    name = "rdl_test_lib",
    testonly = True,
    srcs = [
        "rdl_chip.py",
        "rdl_emit.py",
        "rdl_negative_control_test.py",
        "rdl_pkg_vs_legacy_test.py",
        "rdl_vhdl_pkg_test.py",
        "rdl_vs_generator_test.py",
        "rdl_vs_vhdl_test.py",
    ],
    imports = ["."],
    deps = [":rdl_lib"],
)

# The two TRACKED VHDL register packages. They are sources
# the RTL `use`s -- Genus, Xcelium and GHDL all read the tree, so a build output
# would not do -- and //platform/common:rdl_vhdl_pkg_test is what keeps a tracked
# generated file honest.
# The firmware-facing register headers: per-block field macros and
# struct overlays from STOCK PeakRDL-cheader, plus the castalia_regs.h umbrella
# carrying one base and one typed pointer per instance.
py_library(
    name = "rdl_regs_lib",
    testonly = True,
    srcs = [
        "rdl_cheader_regs.py",
        "regs_headers_test.py",
    ],
    imports = ["."],
    deps = [
        ":rdl_chip_lib",
        requirement("peakrdl-cheader"),
    ],
)

py_binary(
    name = "rdl_regs_headers",
    srcs = ["rdl_cheader_regs.py"],
    data = [
        "//hdl:rdl_sources",
        "//platform/common:rdl_config",
    ],
    main = "rdl_cheader_regs.py",
    deps = [
        ":rdl_lib",
        ":rdl_chip_lib",
        requirement("peakrdl-cheader"),
    ],
)

py_binary(
    name = "rdl_vhdl_pkgs",
    srcs = ["rdl_vhdl_pkg.py"],
    data = ["//hdl:rdl_sources"],
    main = "rdl_vhdl_pkg.py",
    deps = [":rdl_lib"],
)

# The frozen-table writer. It is deliberately NOT wired into any test: a gate
# that regenerated rdl_legacy_constants.json would grade the emitter against
# itself. Run it only to add a peripheral that has not migrated yet.
py_binary(
    name = "rdl_legacy_snapshot",
    srcs = ["rdl_legacy_snapshot.py"],
    data = [
        "//hdl:rdl_sources",
        "//hdl:vhdl_sources",
    ],
    main = "rdl_legacy_snapshot.py",
    deps = [":rdl_lib"],
)

py_binary(
    name = "rdl_emit",
    srcs = ["rdl_emit.py"],
    data = [
        "//hdl:rdl_sources",
        "//platform/common:rdl_config",
    ],
    deps = [":rdl_lib"],
)

# The two WHOLE-CHIP artifacts, which rdl_emit cannot make because they are not
# per-peripheral: the TRM's flat register index and MemoryMap.h's per-INSTANCE
# address defines. Both need the instance names and base addresses, and those
# are written down only in castalia_penta_wound.rdl.
py_binary(
    name = "rdl_chip",
    srcs = [
        "rdl_chip.py",
        "rdl_emit.py",
    ],
    data = [
        "//hdl:rdl_sources",
        "//platform/common:rdl_config",
    ],
    deps = [
        ":rdl_lib",
        requirement("systemrdl-compiler"),
    ],
)
