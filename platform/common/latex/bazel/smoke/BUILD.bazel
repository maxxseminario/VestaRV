# VestaRV: hermetic LaTeX smoke test, isolated in its own package.
#
# bazel_latex 1.2.2 calls native.sh_binary, which Bazel 9 removed, and the failure is at load
# time, so one latex_document call can make a whole package unloadable; keeping it here behind
# smoke.bzl's guard leaves the parent package's TRM targets untouched. The document is minimal,
# so a failure is a toolchain failure. Tagged manual so a wildcard build does not pay for it.

load(":smoke.bzl", "latex_document_where_supported")

package(default_visibility = ["//visibility:public"])

exports_files(["smoke.tex"])

latex_document_where_supported(
    name = "smoke",
    main = "smoke.tex",
    tags = ["manual"],
)
