{
  "block": "ControlAmpClosedLoop",
  "tex_root": "include/analog/",
  "nominal_corner": "tt",
  "supply_var": "VDD25",
  "tests": {
    "uf_dc": {
      "dir": "UnityFeedbackWBiasTB",
      "result": "dc",
      "xlabel": "Input voltage $V_{\\mathrm{IN}}$~[\\si{\\volt}]",
      "xunit_tex": "\\si{\\volt}",
      "nominal_x": 1.25,
      "signals": {
        "vout": {
          "expr": "v(\"/V_OutOL\")",
          "label": "$V_{\\mathrm{OUT}}$",
          "unit_tex": "\\si{\\volt}",
          "digits": 3
        },
        "verr": {
          "expr": "(v(\"/V_OutOL\")-v(\"/V_InP\"))",
          "label": "$V_{\\mathrm{OUT}}-V_{\\mathrm{IN}}$",
          "unit_tex": "\\si{\\milli\\volt}",
          "scale": 1000.0,
          "digits": 3
        },
        "idd": {
          "expr": "abs(i(\"/POWER/SRC_VDD25/PLUS\"))",
          "label": "$I_{\\mathrm{DD}}$",
          "unit_tex": "\\si{\\micro\\ampere}",
          "scale": 1000000.0,
          "digits": 2
        },
        "vos": {
          "expr": "value(v(\"/V_OutOL\")-v(\"/V_InP\") 1.25)",
          "label": "Buffer error at $V_{\\mathrm{IN}}=\\SI{1.25}{\\volt}$",
          "unit_tex": "\\si{\\micro\\volt}",
          "scale": 1000000.0,
          "digits": 1
        },
        "vin_lo": {
          "expr": "cross(abs(v(\"/V_OutOL\")-v(\"/V_InP\")) 1e-3 1 \"falling\")",
          "label": "Lower edge of the \\SI{1}{\\milli\\volt} window",
          "unit_tex": "\\si{\\volt}",
          "digits": 3
        },
        "vin_hi": {
          "expr": "cross(abs(v(\"/V_OutOL\")-v(\"/V_InP\")) 1e-3 1 \"rising\")",
          "label": "Upper edge of the \\SI{1}{\\milli\\volt} window",
          "unit_tex": "\\si{\\volt}",
          "digits": 3
        }
      }
    },
    "uf_margin": {
      "dir": "UnityFeedbackWBiasTB",
      "result": "stb_margin",
      "signals": {
        "lg0_db": {
          "expr": "dB20(value(getData(\"loopGain\" ?result \"stb\") 1.0))",
          "label": "Loop gain at \\SI{1}{\\hertz}",
          "unit_tex": "\\si{\\decibel}",
          "digits": 2
        },
        "lg_ugf": {
          "expr": "unityGainFreq(getData(\"loopGain\" ?result \"stb\"))",
          "label": "Loop unity-gain frequency",
          "unit_tex": "\\si{\\mega\\hertz}",
          "scale": 1e-06,
          "digits": 3
        },
        "pm": {
          "expr": "getData(\"phaseMargin\" ?result \"stb_margin\")",
          "label": "Phase margin",
          "unit_tex": "\\si{\\degree}",
          "digits": 2
        },
        "pmf": {
          "expr": "getData(\"phaseMarginFreq\" ?result \"stb_margin\")",
          "label": "Frequency at the phase margin",
          "unit_tex": "\\si{\\mega\\hertz}",
          "scale": 1e-06,
          "digits": 3
        },
        "gm": {
          "expr": "getData(\"gainMargin\" ?result \"stb_margin\")",
          "label": "Gain margin",
          "unit_tex": "\\si{\\decibel}",
          "digits": 2
        },
        "gmf": {
          "expr": "getData(\"gainMarginFreq\" ?result \"stb_margin\")",
          "label": "Frequency at the gain margin",
          "unit_tex": "\\si{\\mega\\hertz}",
          "scale": 1e-06,
          "digits": 1
        }
      }
    },
    "uf_noise": {
      "dir": "UnityFeedbackWBiasTB",
      "result": "noise",
      "xlabel": "Frequency~[\\si{\\hertz}]",
      "xunit_tex": "\\si{\\hertz}",
      "signals": {
        "nout": {
          "expr": "getData(\"out\")",
          "label": "Output noise density",
          "unit_tex": "\\si{\\nano\\volt\\per\\sqrt\\hertz}",
          "scale": 1000000000.0,
          "digits": 2
        },
        "nout_1": {
          "expr": "value(getData(\"out\") 1.0)",
          "label": "Output noise at \\SI{1}{\\hertz}",
          "unit_tex": "\\si{\\nano\\volt\\per\\sqrt\\hertz}",
          "scale": 1000000000.0,
          "digits": 0
        },
        "nout_1k": {
          "expr": "value(getData(\"out\") 1e3)",
          "label": "Output noise at \\SI{1}{\\kilo\\hertz}",
          "unit_tex": "\\si{\\nano\\volt\\per\\sqrt\\hertz}",
          "scale": 1000000000.0,
          "digits": 1
        },
        "nfloor": {
          "expr": "value(getData(\"out\") 3e5)",
          "label": "Broadband floor at \\SI{300}{\\kilo\\hertz}",
          "unit_tex": "\\si{\\nano\\volt\\per\\sqrt\\hertz}",
          "scale": 1000000000.0,
          "digits": 2
        },
        "fcorner": {
          "expr": "cross(getData(\"out\") sqrt(2)*value(getData(\"out\") 3e5) 1 \"either\")",
          "label": "Flicker corner",
          "unit_tex": "\\si{\\kilo\\hertz}",
          "scale": 0.001,
          "digits": 2
        },
        "nint_10k": {
          "expr": "sqrt(integ(getData(\"out\")**2 0.1 1e4))",
          "label": "Integrated noise, \\SI{0.1}{\\hertz}--\\SI{10}{\\kilo\\hertz}",
          "unit_tex": "\\si{\\micro\\volt}",
          "scale": 1000000.0,
          "digits": 2
        },
        "nint_1M": {
          "expr": "sqrt(integ(getData(\"out\")**2 0.1 1e6))",
          "label": "Integrated noise, \\SI{0.1}{\\hertz}--\\SI{1}{\\mega\\hertz}",
          "unit_tex": "\\si{\\micro\\volt}",
          "scale": 1000000.0,
          "digits": 2
        }
      }
    },
    "uf_op": {
      "dir": "UnityFeedbackWBiasTB",
      "result": "dcOp",
      "signals": {
        "iamp": {
          "expr": "abs(i(\"/OPAMP/vdd!\"))",
          "label": "Amplifier supply current",
          "unit_tex": "\\si{\\micro\\ampere}",
          "scale": 1000000.0,
          "digits": 2
        },
        "itot": {
          "expr": "abs(i(\"/POWER/SRC_VDD25/PLUS\"))",
          "label": "Bench supply current (amplifier + bias generator)",
          "unit_tex": "\\si{\\micro\\ampere}",
          "scale": 1000000.0,
          "digits": 2
        },
        "vout_op": {
          "expr": "v(\"/V_OutOL\")",
          "label": "Output voltage, unity gain at \\SI{1.25}{\\volt}",
          "unit_tex": "\\si{\\volt}",
          "digits": 4
        },
        "vbnm": {
          "expr": "v(\"/V_BNM\")",
          "label": "NMOS mirror bias $V_{\\mathrm{BNM}}$",
          "unit_tex": "\\si{\\milli\\volt}",
          "scale": 1000.0,
          "digits": 1
        },
        "vbnc": {
          "expr": "v(\"/V_BNC\")",
          "label": "NMOS cascode bias $V_{\\mathrm{BNC}}$",
          "unit_tex": "\\si{\\milli\\volt}",
          "scale": 1000.0,
          "digits": 1
        },
        "vbpm": {
          "expr": "v(\"/V_BPM\")",
          "label": "PMOS mirror bias $V_{\\mathrm{BPM}}$",
          "unit_tex": "\\si{\\milli\\volt}",
          "scale": 1000.0,
          "digits": 1
        },
        "vbpc": {
          "expr": "v(\"/V_BPC\")",
          "label": "PMOS cascode bias $V_{\\mathrm{BPC}}$",
          "unit_tex": "\\si{\\milli\\volt}",
          "scale": 1000.0,
          "digits": 1
        }
      }
    },
    "slew": {
      "dir": "SlewOpenLoopWBiasTB",
      "result": "tran",
      "xlabel": "Time~[\\si{\\micro\\second}]",
      "xunit_tex": "\\si{\\micro\\second}",
      "xscale": 1000000.0,
      "signals": {
        "vout": {
          "expr": "v(\"/V_OutOL\")",
          "label": "$V_{\\mathrm{OUT}}$",
          "unit_tex": "\\si{\\volt}",
          "digits": 3
        },
        "vin": {
          "expr": "v(\"/V_InP\")",
          "label": "$V_{\\mathrm{INP}}$",
          "unit_tex": "\\si{\\volt}",
          "digits": 3
        },
        "iload": {
          "expr": "i(\"/C_L/PLUS\")",
          "label": "Load current",
          "unit_tex": "\\si{\\micro\\ampere}",
          "scale": 1000000.0,
          "digits": 2
        },
        "sr_up": {
          "expr": "1.0/(cross(v(\"/V_OutOL\") 2.25 1 \"rising\")-cross(v(\"/V_OutOL\") 1.25 1 \"rising\"))",
          "label": "Slew rate, rising",
          "unit_tex": "\\si{\\volt\\per\\micro\\second}",
          "scale": 1e-06,
          "digits": 3
        },
        "sr_dn": {
          "expr": "1.0/(cross(v(\"/V_OutOL\") 1.25 1 \"falling\")-cross(v(\"/V_OutOL\") 2.25 1 \"falling\"))",
          "label": "Slew rate, falling",
          "unit_tex": "\\si{\\volt\\per\\micro\\second}",
          "scale": 1e-06,
          "digits": 3
        },
        "isrc": {
          "expr": "average(clip(i(\"/C_L/PLUS\") cross(v(\"/V_OutOL\") 1.25 1 \"rising\") cross(v(\"/V_OutOL\") 2.25 1 \"rising\")))",
          "label": "Slewing current, rising edge",
          "unit_tex": "\\si{\\micro\\ampere}",
          "scale": 1000000.0,
          "digits": 2
        },
        "isnk": {
          "expr": "abs(average(clip(i(\"/C_L/PLUS\") cross(v(\"/V_OutOL\") 2.25 1 \"falling\") cross(v(\"/V_OutOL\") 1.25 1 \"falling\"))))",
          "label": "Slewing current, falling edge",
          "unit_tex": "\\si{\\micro\\ampere}",
          "scale": 1000000.0,
          "digits": 2
        },
        "ipk_src": {
          "expr": "ymax(i(\"/C_L/PLUS\"))",
          "label": "Peak edge current, sourcing",
          "unit_tex": "\\si{\\micro\\ampere}",
          "scale": 1000000.0,
          "digits": 2
        },
        "ipk_snk": {
          "expr": "abs(ymin(i(\"/C_L/PLUS\")))",
          "label": "Peak edge current, sinking",
          "unit_tex": "\\si{\\micro\\ampere}",
          "scale": 1000000.0,
          "digits": 2
        }
      }
    }
  },
  "figures": [
    {
      "id": "ctrlamp_buffer_error",
      "test": "uf_dc",
      "signals": [
        "verr"
      ],
      "corners": "all",
      "ylabel": "$V_{\\mathrm{OUT}}-V_{\\mathrm{IN}}$~[\\si{\\milli\\volt}]",
      "yprec": 1,
      "axis_extra": "ymin=-1.5, ymax=1.5, enlarge y limits=false, restrict y to domain=-30:30",
      "caption": "Unity-gain tracking error against input voltage. Inside the window \\SIrange{0.30}{2.01}{\\volt} the error stays under \\SI{1}{\\milli\\volt}, passing through \\SI{+61}{\\micro\\volt} at mid-supply; the curve leaves the frame at both ends, where the PMOS tail runs out of headroom near the supply and the output stage reaches its low limit near \\texttt{vss!}. The vertical scale is clipped to \\(\\pm\\SI{1.5}{\\milli\\volt}\\) so the in-range behaviour is visible at all --- the error reaches \\SI{+97}{\\milli\\volt} at \\SI{0}{\\volt} and \\SI{-382}{\\milli\\volt} at \\SI{2.5}{\\volt}.",
      "width": "0.80\\linewidth",
      "height": "6.0cm"
    },
    {
      "id": "ctrlamp_noise",
      "test": "uf_noise",
      "signals": [
        "nout"
      ],
      "corners": "all",
      "xlog": true,
      "ylog": true,
      "ylabel": "Output noise density~[\\si{\\nano\\volt\\per\\sqrt\\hertz}]",
      "axis_extra": "xtick={1e-1,1e1,1e3,1e5,1e7}",
      "caption": "Output-referred noise density of the amplifier in unity-gain feedback, including the noise of the local bias generator. Flicker noise dominates below the \\SI{34}{\\kilo\\hertz} corner and reaches \\SI{4.77}{\\micro\\volt\\per\\sqrt\\hertz} at \\SI{1}{\\hertz}; the broadband floor is \\SI{16.0}{\\nano\\volt\\per\\sqrt\\hertz}, and the fall above about \\SI{2}{\\mega\\hertz} is the closed-loop bandwidth rolling the noise off, not a reduction in the noise generated.",
      "width": "0.80\\linewidth",
      "height": "6.0cm"
    },
    {
      "id": "ctrlamp_slew",
      "test": "slew",
      "signals": [
        "vin",
        "vout"
      ],
      "corners": [
        "tt"
      ],
      "ylabel": "Voltage~[\\si{\\volt}]",
      "yprec": 1,
      "caption": "Large-signal step response. The open-loop bench slams the differential input from \\(-\\SI{1.25}{\\volt}\\) to \\(+\\SI{1.25}{\\volt}\\) and back, fully steering the input pair, so the output slews at the rate the output stage can charge and discharge the \\SI{10}{\\pico\\farad} load. The two edges are visibly unequal: the output takes \\SI{1.4}{\\micro\\second} to slew up and \\SI{5.7}{\\micro\\second} to slew back down, a factor of four.",
      "width": "0.80\\linewidth",
      "height": "6.0cm"
    }
  ],
  "tables": [
    {
      "id": "ctrlamp_dcop",
      "type": "matrix",
      "test": "uf_op",
      "stat": "value",
      "signals": [
        "vout_op",
        "iamp",
        "itot"
      ],
      "corners": "all",
      "spread_column": true,
      "caption": "DC operating point in the unity-gain bench with the input held at mid-supply, over all five process corners."
    },
    {
      "id": "ctrlamp_stability",
      "type": "matrix",
      "test": "uf_margin",
      "stat": "value",
      "signals": [
        "lg0_db",
        "lg_ugf",
        "pm",
        "pmf",
        "gm",
        "gmf"
      ],
      "corners": "all",
      "spread_column": true,
      "caption": "Loop stability from the \\texttt{stb} analysis of \\texttt{UnityFeedbackWBiasTB}, probed in the feedback path around the unity-gain connection --- the worst-case feedback factor. A dash in the gain-margin rows means the loop gain phase does not reach \\SI{-180}{\\degree}, so no gain margin is defined."
    },
    {
      "id": "ctrlamp_largesignal",
      "type": "matrix",
      "test": "slew",
      "stat": "value",
      "signals": [
        "sr_up",
        "sr_dn",
        "isrc",
        "isnk"
      ],
      "corners": "all",
      "spread_column": true,
      "caption": "Large-signal step response of \\texttt{SlewOpenLoopWBiasTB} into \\SI{10}{\\pico\\farad}. Slew rate is taken between the \\SI{1.25}{\\volt} and \\SI{2.25}{\\volt} output levels; the slewing currents are the mean load current over that same interval, i.e.\\ the same measurement expressed as $I=C\\,\\mathrm{d}V/\\mathrm{d}t$. DC drive compliance is given in Table~\\ref{tab:ctrlamp-drivemap}."
    },
    {
      "id": "ctrlamp_accuracy",
      "type": "matrix",
      "test": "uf_dc",
      "stat": "value",
      "signals": [
        "vos",
        "vin_lo",
        "vin_hi"
      ],
      "corners": "all",
      "spread_column": true,
      "caption": "Unity-gain accuracy and usable input range. The window edges are where the magnitude of the tracking error crosses \\SI{1}{\\milli\\volt}; between them the amplifier follows its input to better than that, and the residual at mid-supply is the systematic input offset."
    },
    {
      "id": "ctrlamp_noise",
      "type": "matrix",
      "test": "uf_noise",
      "stat": "value",
      "signals": [
        "nout_1",
        "nout_1k",
        "nfloor",
        "fcorner",
        "nint_10k",
        "nint_1M"
      ],
      "corners": "all",
      "spread_column": true,
      "caption": "Output-referred noise in unity-gain feedback, amplifier and local bias generator together. The flicker corner is quoted as the frequency at which the density has risen to \\(\\sqrt{2}\\) times the \\SI{300}{\\kilo\\hertz} floor. In unity gain the output-referred and input-referred densities are equal to within a fraction of a percent below \\SI{100}{\\kilo\\hertz}, so these also read as input-referred numbers over the band that matters to the potentiostat loop."
    }
  ],
  "points": [
    "131-135"
  ],
  "emit_master": false,
  "emit_corner_table": false
}