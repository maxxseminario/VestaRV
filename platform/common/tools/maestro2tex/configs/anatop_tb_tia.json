{
  "block": "TiaAmp",
  "tex_root": "include/analog/",
  "nominal_corner": "tt",
  "supply_var": "VDD25",
  "emit_master": true,
  "emit_corner_table": true,
  "corner_table_caption": "Process, temperature and supply points simulated for the transimpedance stage. The typical point is the Monte Carlo process section at zero statistical offset and the \\SI{37}{\\celsius} on-body temperature; the four skew corners are the foundry corners at \\SI{25}{\\celsius}. This run is corners only --- no Monte Carlo, so no mismatch or yield figures appear in this section.",
  "tests": {
    "tia_ac": {
      "dir": "TiaFbTB",
      "result": "ac",
      "xlabel": "Frequency~[\\si{\\hertz}]",
      "xunit_tex": "\\si{\\hertz}",
      "nominal_x": 1.0,
      "signals": {
        "zt": {
          "expr": "mag(VF(\"/V_OUT\"))",
          "label": "Transimpedance $|Z_t|$",
          "unit_tex": "\\si{\\kilo\\ohm}",
          "scale": 0.001,
          "digits": 1
        },
        "zt_dc": {
          "expr": "value(mag(VF(\"/V_OUT\")) 1)",
          "label": "Transimpedance at \\SI{1}{\\hertz}",
          "short_label": "$Z_t(\\mathrm{DC})$",
          "unit_tex": "\\si{\\kilo\\ohm}",
          "scale": 0.001,
          "digits": 2
        },
        "zt_pk": {
          "expr": "ymax(mag(VF(\"/V_OUT\")))",
          "label": "Peak transimpedance",
          "short_label": "$|Z_t|_{\\max}$",
          "unit_tex": "\\si{\\kilo\\ohm}",
          "scale": 0.001,
          "digits": 2
        },
        "peak_db": {
          "expr": "(ymax(dB20(VF(\"/V_OUT\"))) - value(dB20(VF(\"/V_OUT\")) 1))",
          "label": "Gain peaking",
          "unit_tex": "\\si{\\decibel}",
          "scale": 1.0,
          "digits": 2
        },
        "f_pk": {
          "expr": "xmax(mag(VF(\"/V_OUT\")) 1)",
          "label": "Frequency of the peak",
          "short_label": "$f_{\\mathrm{pk}}$",
          "unit_tex": "\\si{\\hertz}",
          "scale": 1.0,
          "digits": 0
        },
        "f3db": {
          "expr": "bandwidth(VF(\"/V_OUT\") 3 \"low\")",
          "label": "Signal bandwidth $f_{-3\\,\\mathrm{dB}}$",
          "unit_tex": "\\si{\\kilo\\hertz}",
          "scale": 0.001,
          "digits": 3
        },
        "zin": {
          "expr": "value(mag(VF(\"/WE\")) 1)",
          "label": "Input impedance at WE, \\SI{1}{\\hertz}",
          "short_label": "$Z_{\\mathrm{in}}$",
          "unit_tex": "\\si{\\ohm}",
          "scale": 1.0,
          "digits": 1
        }
      }
    },
    "tia_dc": {
      "dir": "TiaFbTB",
      "result": "dc",
      "xlabel": "Test-source current $i_{\\mathrm{we}}$ drawn out of the WE node~[\\si{\\micro\\ampere}]",
      "xunit_tex": "\\si{\\micro\\ampere}",
      "xscale": 1000000.0,
      "nominal_x": 0.0,
      "signals": {
        "vout": {
          "expr": "VS(\"/V_OUT\")",
          "label": "Output voltage $V_{\\mathrm{OUT}}$",
          "unit_tex": "\\si{\\volt}",
          "scale": 1.0,
          "digits": 3
        },
        "we_err": {
          "expr": "(VS(\"/WE\") - VS(\"/V_CM\"))",
          "label": "Virtual-ground error $V_{\\mathrm{WE}}-v_{\\mathrm{cm}}$",
          "unit_tex": "\\si{\\milli\\volt}",
          "scale": 1000.0,
          "digits": 3
        },
        "rt_0": {
          "expr": "value(deriv(VS(\"/V_OUT\")) 0)",
          "label": "Incremental gain at zero current",
          "short_label": "$\\mathrm{d}V_{\\mathrm{OUT}}/\\mathrm{d}I_{\\mathrm{WE}}$",
          "unit_tex": "\\si{\\kilo\\ohm}",
          "scale": 0.001,
          "digits": 2
        },
        "rt_2u": {
          "expr": "value(deriv(VS(\"/V_OUT\")) 2e-06)",
          "label": "Incremental gain at $i_{\\mathrm{we}} = \\SI{+2}{\\micro\\ampere}$",
          "unit_tex": "\\si{\\kilo\\ohm}",
          "scale": 0.001,
          "digits": 2
        },
        "vout_hi": {
          "expr": "ymax(VS(\"/V_OUT\"))",
          "label": "$V_{\\mathrm{OUT}}$ upper extreme",
          "unit_tex": "\\si{\\volt}",
          "scale": 1.0,
          "digits": 3
        },
        "vout_lo": {
          "expr": "ymin(VS(\"/V_OUT\"))",
          "label": "$V_{\\mathrm{OUT}}$ lower extreme",
          "unit_tex": "\\si{\\volt}",
          "scale": 1.0,
          "digits": 3
        },
        "we_err_0": {
          "expr": "value((VS(\"/WE\") - VS(\"/V_CM\")) 0)",
          "label": "Virtual-ground error at zero current",
          "unit_tex": "\\si{\\milli\\volt}",
          "scale": 1000.0,
          "digits": 3
        },
        "we_err_p2u": {
          "expr": "value((VS(\"/WE\") - VS(\"/V_CM\")) 2e-06)",
          "label": "Virtual-ground error at $i_{\\mathrm{we}} = \\SI{+2}{\\micro\\ampere}$",
          "unit_tex": "\\si{\\milli\\volt}",
          "scale": 1000.0,
          "digits": 3
        },
        "we_err_n2u": {
          "expr": "value((VS(\"/WE\") - VS(\"/V_CM\")) -2e-06)",
          "label": "Virtual-ground error at $i_{\\mathrm{we}} = \\SI{-2}{\\micro\\ampere}$",
          "unit_tex": "\\si{\\milli\\volt}",
          "scale": 1000.0,
          "digits": 3
        },
        "idd": {
          "expr": "value(abs(IDC(\"/POWER/SRC_VDD25/PLUS\")) 0)",
          "label": "Supply current $I_{\\mathrm{DD}}$ (amplifier only)",
          "unit_tex": "\\si{\\micro\\ampere}",
          "scale": 1000000.0,
          "digits": 2
        }
      }
    },
    "amp_stb": {
      "dir": "UnityFeedbackTB",
      "result": "stb",
      "xlabel": "Frequency~[\\si{\\hertz}]",
      "xunit_tex": "\\si{\\hertz}",
      "signals": {
        "lg_db": {
          "expr": "dB20(getData(\"loopGain\" ?result \"stb\"))",
          "label": "Open-loop gain $A$",
          "unit_tex": "\\si{\\decibel}",
          "scale": 1.0,
          "digits": 2
        },
        "a0": {
          "expr": "ymax(dB20(getData(\"loopGain\" ?result \"stb\")))",
          "label": "DC open-loop gain $A_0$",
          "unit_tex": "\\si{\\decibel}",
          "scale": 1.0,
          "digits": 2
        },
        "ugf": {
          "expr": "cross(dB20(getData(\"loopGain\" ?result \"stb\")) 0 1 \"falling\")",
          "label": "Unity-gain frequency",
          "short_label": "$f_u$",
          "unit_tex": "\\si{\\mega\\hertz}",
          "scale": 1e-06,
          "digits": 3
        },
        "pm": {
          "expr": "getData(\"phaseMargin\" ?result \"stb_margin\")",
          "label": "Phase margin",
          "unit_tex": "\\si{\\degree}",
          "scale": 1.0,
          "digits": 1
        },
        "gm": {
          "expr": "getData(\"gainMargin\" ?result \"stb_margin\")",
          "label": "Gain margin",
          "unit_tex": "\\si{\\decibel}",
          "scale": 1.0,
          "digits": 1
        },
        "fp1_meas": {
          "expr": "bandwidth(getData(\"loopGain\" ?result \"stb\") 3 \"low\")",
          "label": "Measured dominant pole $f_{p1}$",
          "unit_tex": "\\si{\\hertz}",
          "scale": 1.0,
          "digits": 1
        },
        "lg_ph": {
          "expr": "phase(getData(\"loopGain\" ?result \"stb\"))",
          "label": "Loop phase $\\ang{180}+\\angle A$",
          "unit_tex": "\\si{\\degree}",
          "scale": 1.0,
          "digits": 1
        }
      }
    },
    "amp_dc": {
      "dir": "UnityFeedbackTB",
      "result": "dc",
      "xlabel": "Input common-mode voltage~[\\si{\\volt}]",
      "xunit_tex": "\\si{\\volt}",
      "nominal_x": 1.25,
      "signals": {
        "vos": {
          "expr": "value((VS(\"/V_OutOL\") - VS(\"/V_InP\")) 1.25)",
          "label": "Input offset at $v_{\\mathrm{cm}}$",
          "short_label": "$V_{\\mathrm{OS}}$",
          "unit_tex": "\\si{\\milli\\volt}",
          "scale": 1000.0,
          "digits": 3
        },
        "cm_lo": {
          "expr": "cross(abs(VS(\"/V_OutOL\")-VS(\"/V_InP\")) 0.002 1 \"falling\")",
          "label": "Lower edge of the tracking range",
          "unit_tex": "\\si{\\volt}",
          "scale": 1.0,
          "digits": 3
        },
        "cm_hi": {
          "expr": "cross(abs(VS(\"/V_OutOL\")-VS(\"/V_InP\")) 0.002 1 \"rising\")",
          "label": "Upper edge of the tracking range",
          "unit_tex": "\\si{\\volt}",
          "scale": 1.0,
          "digits": 3
        },
        "track_err": {
          "expr": "value(abs(VS(\"/V_OutOL\")-VS(\"/V_InP\")) 1.25)",
          "label": "Tracking error at $v_{\\mathrm{cm}}$",
          "unit_tex": "\\si{\\milli\\volt}",
          "scale": 1000.0,
          "digits": 3
        }
      }
    },
    "amp_noise": {
      "dir": "UnityFeedbackTB",
      "result": "noise",
      "xlabel": "Frequency~[\\si{\\hertz}]",
      "xunit_tex": "\\si{\\hertz}",
      "signals": {
        "vn_10": {
          "expr": "value(getData(\"in\" ?result \"noise\") 10.0)",
          "label": "Input noise density at \\SI{10}{\\hertz}",
          "unit_tex": "\\si{\\micro\\volt\\per\\sqrt\\hertz}",
          "scale": 1000000.0,
          "digits": 3
        },
        "vn_100": {
          "expr": "value(getData(\"in\" ?result \"noise\") 100.0)",
          "label": "Input noise density at \\SI{100}{\\hertz}",
          "unit_tex": "\\si{\\micro\\volt\\per\\sqrt\\hertz}",
          "scale": 1000000.0,
          "digits": 3
        },
        "vn_1k": {
          "expr": "value(getData(\"in\" ?result \"noise\") 1000.0)",
          "label": "Input noise density at \\SI{1}{\\kilo\\hertz}",
          "unit_tex": "\\si{\\micro\\volt\\per\\sqrt\\hertz}",
          "scale": 1000000.0,
          "digits": 3
        },
        "vn_int": {
          "expr": "sqrt(integ(getData(\"in\" ?result \"noise\")**2 0.1 1700.0))",
          "label": "Integrated input noise, \\SIrange{0.1}{1700}{\\hertz}",
          "short_label": "$v_{n,\\mathrm{rms}}$",
          "unit_tex": "\\si{\\micro\\volt}",
          "scale": 1000000.0,
          "digits": 2
        }
      }
    },
    "drive_dc": {
      "dir": "DriveTB",
      "result": "dc",
      "xlabel": "Load current drawn from the output~[\\si{\\micro\\ampere}]",
      "xunit_tex": "\\si{\\micro\\ampere}",
      "xscale": 1000000.0,
      "nominal_x": 0.0,
      "signals": {
        "vo": {
          "expr": "VS(\"/V_OutOL\")",
          "label": "Output voltage",
          "unit_tex": "\\si{\\volt}",
          "scale": 1.0,
          "digits": 3
        },
        "i_src": {
          "expr": "cross(VS(\"/V_OutOL\") 1.2375 1 \"falling\")",
          "label": "Sourcing limit at \\SI{1}{\\percent} droop",
          "short_label": "$I_{\\mathrm{SRC}}$",
          "unit_tex": "\\si{\\micro\\ampere}",
          "scale": 1000000.0,
          "digits": 2
        },
        "vo_snk40": {
          "expr": "value(VS(\"/V_OutOL\") -4e-05)",
          "label": "Output while sinking \\SI{40}{\\micro\\ampere}",
          "unit_tex": "\\si{\\volt}",
          "scale": 1.0,
          "digits": 4
        },
        "vo_src40": {
          "expr": "value(VS(\"/V_OutOL\") 4e-05)",
          "label": "Output while sourcing \\SI{40}{\\micro\\ampere}",
          "unit_tex": "\\si{\\volt}",
          "scale": 1.0,
          "digits": 3
        }
      }
    },
    "slew_tr": {
      "dir": "SlewOpenLoopTB",
      "result": "tran",
      "xlabel": "Time~[\\si{\\micro\\second}]",
      "xunit_tex": "\\si{\\micro\\second}",
      "xscale": 1000000.0,
      "signals": {
        "vo": {
          "expr": "VT(\"/V_OutOL\")",
          "label": "Output voltage",
          "unit_tex": "\\si{\\volt}",
          "scale": 1.0,
          "digits": 3
        },
        "sr_p": {
          "expr": "ymax(deriv(VT(\"/V_OutOL\")))",
          "label": "Rising slew rate",
          "short_label": "$\\mathrm{SR}^{+}$",
          "unit_tex": "\\si{\\volt\\per\\micro\\second}",
          "scale": 1e-06,
          "digits": 2
        },
        "sr_n": {
          "expr": "abs(ymin(deriv(VT(\"/V_OutOL\"))))",
          "label": "Falling slew rate",
          "short_label": "$\\mathrm{SR}^{-}$",
          "unit_tex": "\\si{\\volt\\per\\micro\\second}",
          "scale": 1e-06,
          "digits": 2
        }
      }
    },
    "step_tr": {
      "dir": "StepUnityFeedbackTB",
      "result": "tran",
      "xlabel": "Time~[\\si{\\micro\\second}]",
      "xunit_tex": "\\si{\\micro\\second}",
      "xscale": 1000000.0,
      "signals": {
        "vo": {
          "expr": "VT(\"/V_OutOL\")",
          "label": "Output voltage",
          "unit_tex": "\\si{\\volt}",
          "scale": 1.0,
          "digits": 3
        },
        "ovs": {
          "expr": "((ymax(VT(\"/V_OutOL\")) - (VAR(\"V_CM\")+0.5)) * 100.0)",
          "label": "Overshoot on the rising edge",
          "unit_tex": "\\si{\\percent}",
          "scale": 1.0,
          "digits": 2
        },
        "und": {
          "expr": "(((VAR(\"V_CM\")-0.5) - ymin(VT(\"/V_OutOL\"))) * 100.0)",
          "label": "Undershoot on the falling edge",
          "unit_tex": "\\si{\\percent}",
          "scale": 1.0,
          "digits": 2
        },
        "t_pk": {
          "expr": "((xmax(VT(\"/V_OutOL\") 1) - 100e-06) * 1000000.0)",
          "label": "Time from the edge to the peak",
          "unit_tex": "\\si{\\micro\\second}",
          "scale": 1.0,
          "digits": 2
        },
        "err_1us": {
          "expr": "((value(VT(\"/V_OutOL\") 101e-06) - value(VT(\"/V_OutOL\") 500e-06)) * 1000.0)",
          "label": "Residual error \\SI{1}{\\micro\\second} after the edge",
          "unit_tex": "\\si{\\milli\\volt}",
          "scale": 1.0,
          "digits": 3
        }
      }
    },
    "amp_op": {
      "dir": "UnityFeedbackTB",
      "result": "dcOpInfo",
      "xlabel": "",
      "signals": {
        "gm1": {
          "expr": "OP(\"/OPAMP/M4\" \"gm\")",
          "label": "First-stage transconductance $g_{m1}$ (M4)",
          "unit_tex": "\\si{\\micro\\siemens}",
          "scale": 1000000.0,
          "digits": 2
        },
        "gm2": {
          "expr": "OP(\"/OPAMP/M12\" \"gm\")",
          "label": "Second-stage transconductance $g_{m2}$ (M12)",
          "unit_tex": "\\si{\\micro\\siemens}",
          "scale": 1000000.0,
          "digits": 1
        },
        "r1": {
          "expr": "1.0/(OP(\"/OPAMP/M4\" \"gds\")+OP(\"/OPAMP/M11\" \"gds\"))",
          "label": "First-stage output resistance $R_1$",
          "unit_tex": "\\si{\\mega\\ohm}",
          "scale": 1e-06,
          "digits": 3
        },
        "r2": {
          "expr": "1.0/(OP(\"/OPAMP/M12\" \"gds\")+OP(\"/OPAMP/M5\" \"gds\"))",
          "label": "Second-stage output resistance $R_2$",
          "unit_tex": "\\si{\\kilo\\ohm}",
          "scale": 0.001,
          "digits": 1
        },
        "cc": {
          "expr": "OP(\"/OPAMP/C0\" \"cap\")",
          "label": "Miller capacitance $C_c$",
          "unit_tex": "\\si{\\pico\\farad}",
          "scale": 1000000000000.0,
          "digits": 3
        },
        "itail": {
          "expr": "abs(OP(\"/OPAMP/M2\" \"id\"))",
          "label": "Tail current $I_{\\mathrm{tail}}$ (M2)",
          "unit_tex": "\\si{\\micro\\ampere}",
          "scale": 1000000.0,
          "digits": 3
        },
        "a0_pred": {
          "expr": "dB20((OP(\"/OPAMP/M4\" \"gm\")/(OP(\"/OPAMP/M4\" \"gds\")+OP(\"/OPAMP/M11\" \"gds\")))*(OP(\"/OPAMP/M12\" \"gm\")/(OP(\"/OPAMP/M12\" \"gds\")+OP(\"/OPAMP/M5\" \"gds\"))))",
          "label": "Predicted DC gain $g_{m1}R_1 g_{m2}R_2$",
          "unit_tex": "\\si{\\decibel}",
          "scale": 1.0,
          "digits": 2
        },
        "fu_pred": {
          "expr": "OP(\"/OPAMP/M4\" \"gm\")/(2*3.14159265358979*OP(\"/OPAMP/C0\" \"cap\"))",
          "label": "Predicted GBW $g_{m1}/2\\pi C_c$",
          "unit_tex": "\\si{\\mega\\hertz}",
          "scale": 1e-06,
          "digits": 3
        },
        "fp1_pred": {
          "expr": "1.0/(2*3.14159265358979*(1.0/(OP(\"/OPAMP/M4\" \"gds\")+OP(\"/OPAMP/M11\" \"gds\")))*(OP(\"/OPAMP/M12\" \"gm\")/(OP(\"/OPAMP/M12\" \"gds\")+OP(\"/OPAMP/M5\" \"gds\")))*OP(\"/OPAMP/C0\" \"cap\"))",
          "label": "Predicted dominant pole $f_{p1}$",
          "unit_tex": "\\si{\\hertz}",
          "scale": 1.0,
          "digits": 1
        },
        "fp2_pred": {
          "expr": "OP(\"/OPAMP/M12\" \"gm\")/(2*3.14159265358979*VAR(\"C_L\"))",
          "label": "Predicted second pole $g_{m2}/2\\pi C_L$",
          "unit_tex": "\\si{\\mega\\hertz}",
          "scale": 1e-06,
          "digits": 2
        }
      }
    }
  },
  "figures": [
    {
      "id": "tia_zt",
      "test": "tia_ac",
      "signals": [
        "zt"
      ],
      "corners": "all",
      "width": "0.82\\linewidth",
      "height": "6.2cm",
      "xlog": true,
      "yprec": 0,
      "legendpos": "south west",
      "ylabel": "Transimpedance $|Z_t|$~[\\si{\\kilo\\ohm}]",
      "axis_extra": "ymin=0, ymax=1250",
      "caption": "Transimpedance $|Z_t|$ against frequency over the five corners, at maximum gain ($R_f = \\SI{560}{\\kilo\\ohm}$) with \\SI{1}{\\micro\\farad} of double-layer capacitance at the working electrode. Flat at \\SI{560}{\\kilo\\ohm} to about \\SI{200}{\\hertz}, it peaks to \\SIrange{1.00}{1.17}{\\mega\\ohm} near \\SI{1}{\\kilo\\hertz}. The peak is a marginally stable loop caused by $C_{\\mathrm{dl}}$ rolling the feedback factor off from \\SI{0.28}{\\hertz}, not by the amplifier."
    },
    {
      "id": "tia_dc",
      "test": "tia_dc",
      "signals": [
        "vout"
      ],
      "corners": "all",
      "width": "0.82\\linewidth",
      "height": "6.2cm",
      "yprec": 1,
      "ylabel": "Output voltage $V_{\\mathrm{OUT}}$~[\\si{\\volt}]",
      "axis_extra": "ymin=0, ymax=2.5",
      "caption": "Output voltage against the swept test-source current over the five corners, at $R_f = \\SI{560}{\\kilo\\ohm}$ with the electrode held at $v_{\\mathrm{cm}} = \\SI{1.25}{\\volt}$. The bench source draws current \\emph{out} of the WE node, so $i_{\\mathrm{we}} = -I_{\\mathrm{WE}}$ against Equation~(\\ref{eq:tia-transfer}) and the slope is $+R_f$. The corners overlay to the line width because that slope is the feedback resistor, ideal in this bench."
    },
    {
      "id": "tia_weerr",
      "test": "tia_dc",
      "signals": [
        "we_err"
      ],
      "corners": "all",
      "width": "0.82\\linewidth",
      "height": "6.2cm",
      "yprec": 1,
      "ylabel": "$V_{\\mathrm{WE}}-v_{\\mathrm{cm}}$~[\\si{\\milli\\volt}]",
      "caption": "Error between the working-electrode potential and $v_{\\mathrm{cm}}$ across the same sweep. It stays inside \\SI{\\pm 0.4}{\\milli\\volt} in both directions; the slope is the stage's input impedance, set by the loop gain at the summing node. That is under \\SI{0.04}{\\percent} of a \\SI{1.25}{\\volt} full scale, so the virtual ground is not an accuracy limit at this gain."
    },
    {
      "id": "tia_loopgain",
      "test": "amp_stb",
      "signals": [
        "lg_db"
      ],
      "corners": "all",
      "width": "0.82\\linewidth",
      "height": "6.2cm",
      "xlog": true,
      "yprec": 0,
      "legendpos": "south west",
      "ylabel": "Open-loop gain $|A|$~[\\si{\\decibel}]",
      "caption": "Open-loop gain over the five process corners, by \\texttt{stb} through the feedback probe with the amplifier in unity feedback and a \\SI{5}{\\pico\\farad} load. Miller compensation gives a single-pole roll-off from \\SI{290}{\\hertz} to a \\SIrange{6.2}{7.6}{\\mega\\hertz} crossover. This is the amplifier alone. The loop that closes around the electrode is characterised in Figure~\\ref{fig:tia-cl-loopgain} and Table~\\ref{tab:tia-cl-stability}; with the cell model and $C_f = \\SI{22}{\\pico\\farad}$ it holds \\SIrange{61.2}{64.9}{\\degree} of phase margin."
    },
    {
      "id": "tia_loopphase",
      "test": "amp_stb",
      "signals": [
        "lg_ph"
      ],
      "corners": "all",
      "width": "0.82\\linewidth",
      "height": "6.2cm",
      "xlog": true,
      "yprec": 0,
      "legendpos": "south west",
      "ylabel": "Loop phase $\\ang{180}+\\angle A$~[\\si{\\degree}]",
      "axis_extra": "ymin=0, ymax=200, xmax=1e8",
      "caption": "Phase of the same measurement. Spectre's \\texttt{stb} reports $\\ang{180}+\\angle A$, so the value at crossover is the phase margin. The lift from \\ang{90.3} at \\SI{100}{\\kilo\\hertz} to \\ang{92.3} at \\SI{1}{\\mega\\hertz} is the left-half-plane zero of Equation~(\\ref{eq:tia-zero}) adding lead, which holds the margin near \\ang{88} through crossover despite the second pole at \\SI{10.8}{\\mega\\hertz}."
    },
    {
      "id": "tia_drive",
      "test": "drive_dc",
      "signals": [
        "vo"
      ],
      "corners": "all",
      "width": "0.82\\linewidth",
      "height": "6.2cm",
      "yprec": 1,
      "legendpos": "south west",
      "ylabel": "Output voltage~[\\si{\\volt}]",
      "axis_extra": "ymin=-0.6, ymax=1.6",
