addrmap evfab {
    name = "EVFAB";
    desc = "Event/trigger fabric: a PPI-style crossbar that lets peripherals command each other with no processor in the loop";
    vesta_peripheral = "EVFAB";
    vesta_word_base = 0;

    default regwidth = 32;

    EVFCR_t       EVFCR       @0x00;
    EVFSR_t       EVFSR       @0x04;
    EVFIE_t       EVFIE       @0x08;
    EVFCAP_t      EVFCAP      @0x0C;
    EVFCHEN_t     EVFCHEN     @0x10;
    EVFCHENSET_t  EVFCHENSET  @0x14;
    EVFCHENCLR_t  EVFCHENCLR  @0x18;
    EVFCHTRIG_t   EVFCHTRIG   @0x1C;
    EVFFIRED_t    EVFFIRED    @0x20;
    EVFOVR_t      EVFOVR      @0x24;
    EVFEVSTAT_t   EVFEVSTAT   @0x28;
    EVFEVTRIG_t   EVFEVTRIG   @0x2C;
    EVFGPIOMASK_t EVFGPIOMASK @0x3C;
    EVFCH0CFG_t   EVFCH0CFG   @0x40;
    EVFCH1CFG_t   EVFCH1CFG   @0x44;
    EVFCH2CFG_t   EVFCH2CFG   @0x48;
    EVFCH3CFG_t   EVFCH3CFG   @0x4C;
    EVFCH4CFG_t   EVFCH4CFG   @0x50;
    EVFCH5CFG_t   EVFCH5CFG   @0x54;
    EVFCH6CFG_t   EVFCH6CFG   @0x58;
    EVFCH7CFG_t   EVFCH7CFG   @0x5C;
    EVFCH8CFG_t   EVFCH8CFG   @0x60;
    EVFCH9CFG_t   EVFCH9CFG   @0x64;
    EVFCH10CFG_t  EVFCH10CFG  @0x68;
    EVFCH11CFG_t  EVFCH11CFG  @0x6C;
    EVFCH12CFG_t  EVFCH12CFG  @0x70;
    EVFCH13CFG_t  EVFCH13CFG  @0x74;
    EVFCH14CFG_t  EVFCH14CFG  @0x78;
    EVFCH15CFG_t  EVFCH15CFG  @0x7C;
};
