reg DMAxC3SRC_t {
    regwidth = 32;
    desc = "Channel 3 source byte address in the 0x0-0x1FFFF shared window (word-aligned: bits[1:0] must be 0; bits[31:17] must be 0). The full written 32-bit value reads back; the engine presents byte_ptr(16:2) as the 15-bit arbiter word address. A misaligned, out-of-window (>= 0x20000), or TCM-hole (0x8000-0xBFFF) SRC is rejected at GO with CHnERR (D13/A18). (reads 0 / ignores writes when the build has NCH=2)";
    // Full 32-bit store and readback; bits 31:17 are writable scratch. An out-of-window (>= 0x20000), misaligned or TCM-hole address is rejected at GO with CHnERR.
    field {
        sw = rw; hw = r;
        reset = 32'h0;
        vesta_access = "rw";
        desc = "Source byte address (word-aligned).";
    } DMAC3SRC[31:0];
};

reg DMAxC3DST_t {
    regwidth = 32;
    desc = "Channel 3 destination byte address (same word-aligned / in-window / TCM-hole rules as C3SRC, D13/A18). (reads 0 / ignores writes when the build has NCH=2)";
    // Full 32-bit store and readback; bits 31:17 are writable scratch. An out-of-window (>= 0x20000), misaligned or TCM-hole address is rejected at GO with CHnERR.
    field {
        sw = rw; hw = r;
        reset = 32'h0;
        vesta_access = "rw";
        desc = "Destination byte address (word-aligned).";
    } DMAC3DST[31:0];
};

reg DMAxC3LEN_t {
    regwidth = 32;
    desc = "Channel 3 transfer length in WORDS. Decrements as the engine runs (a read returns the current remaining count, so pointers/LEN show where an aborted transfer stopped, D15); reads 0 before the first GO. LEN=0 at GO is a programming error (CHnERR, no transfer issued, D13). (reads 0 / ignores writes when the build has NCH=2)";
    // Full 32-bit store; the READ returns len_work, the WORKING remaining count, not the programmed seed (0 until the first GO).
    field {
        sw = rw; hw = rw;
        reset = 32'h0;
        vesta_access = "rw";
        desc = "Remaining transfer length in words.";
    } DMAC3LEN[31:0];
};

reg DMAxC3CFG_t {
    regwidth = 32;
    desc = "Channel 3 configuration: source/dest auto-increment (SINC/DINC, +4 per word when set, else a fixed peripheral data register), trigger source (TRIG), channel priority class (PRIO) and CRC ride-along enable (CRCEN). Program before GO. (reads 0 / ignores writes when the build has NCH=2)";
    field {
        sw = rw; hw = r;
        reset = 1'h0;
        vesta_access = "rw";
        encode = dmaxc3cfg_dmac3crcen_e;
        desc = "CRC ride-along enable. When set, each transferred word is folded (bytes low-to-high) into the shared DMA0CRC accumulator (CRC16-CDMA2000, D14). Use one CRCEN channel per measurement session (a single shared accumulator).";
    } DMAC3CRCEN[7:7];
    field {
        sw = rw; hw = r;
        reset = 1'h0;
        vesta_access = "rw";
        encode = dmaxc3cfg_dmac3prio_e;
        desc = "Priority class. Among serviceable channels the high class (1) is picked before the low class (0); within a class a round-robin pointer prevents starvation (D7). A continuously-serviceable PRIO=1 channel can hold off PRIO=0 channels (standard DMA priority semantic).";
    } DMAC3PRIO[6:6];
    field {
        sw = rw; hw = r;
        reset = 4'h0;
        vesta_access = "rw";
        encode = dmaxc3cfg_dmac3trig_e;
        desc = "Trigger source (D9/D10/A8). 0 = software / mem-to-mem (continuously serviceable); 1 = UART0 RC (one word per received byte, read-to-clear); 2 = QSPI0 RX-full (one word per event + an extra W1C ack txn); 3 = NFC0 payload-ready (a frame event launches the full LEN-word burst + one ack); 4-15 reserved. Pacing requires the source peripheral's own receive interrupt-enable bit set (A8).";
    } DMAC3TRIG[5:2];
    field {
        sw = rw; hw = r;
        reset = 1'h0;
        vesta_access = "rw";
        encode = dmaxc3cfg_dmac3dinc_e;
        desc = "Destination auto-increment. 1 = dst += 4 per word; 0 = dst held (peripheral fill register, D11).";
    } DMAC3DINC[1:1];
    field {
        sw = rw; hw = r;
        reset = 1'h0;
        vesta_access = "rw";
        encode = dmaxc3cfg_dmac3sinc_e;
        desc = "Source auto-increment. 1 = src += 4 per word (block copy); 0 = src held (peripheral data register, the paced-drain case, D11).";
    } DMAC3SINC[0:0];
};

reg DMAxCRC_t {
    regwidth = 32;
    desc = "CRC16-CDMA2000 (poly 0xC857) accumulator / seed, resets to 0xFFFF. Firmware writes the 0xFFFF seed before GO (the SYSTEM0 seed-via-state convention, no auto-seed) and reads the result after DONE; the engine accumulates in the MCLK domain, feeding each CRCEN word's four bytes low-to-high. No input/output reflection, no final XOR (the work.CRC16 contract). Upper bits read 0.";
    // Resets to 0xFFFF. A write stages the seed and flips crc_wr_tgl; the clk-domain engine is the accumulator's only driver, so a read returns crc_acc, not the staged seed.
    field {
        sw = rw; hw = rw;
        reset = 16'hFFFF;
        vesta_access = "rw";
        desc = "CRC16-CDMA2000 accumulator/seed (reset 0xFFFF).";
    } DMACRC[15:0];
};

reg DMAxDESC_t {
    regwidth = 32;
    desc = "Reserved for a descriptor-chain head pointer (out of scope this single-shot phase). Reads 0, writes ignored -- provisioned so scatter-gather bolts on at this slot without a register-map break. Slots >= 20 also read 0.";
    field {
        sw = r;  hw = na;
        reset = 32'h0;
        desc = "Reserved.";
    } RESERVED[31:0];
};
addrmap dma {
    name = "DMAx";
    desc = "Configurable multi-channel single-shot DMA controller: it moves words source->dest over the shared arbiter as a stream of single-word transactions, either flat-out under software GO (memory-to-memory) or paced one word per peripheral data-ready event (UART0 RC / QSPI0 RX-full / NFC0 payload-ready), with optional per-channel source/dest auto-increment, a per-channel 2-level priority + word-granular";
    vesta_peripheral = "DMAx";
    vesta_word_base = 0;

    default regwidth = 32;

    DMAxCR_t    DMAxCR    @0x00;
    DMAxSR_t    DMAxSR    @0x04;
    DMAxC0SRC_t DMAxC0SRC @0x08;
    DMAxC0DST_t DMAxC0DST @0x0C;
    DMAxC0LEN_t DMAxC0LEN @0x10;
    DMAxC0CFG_t DMAxC0CFG @0x14;
    DMAxC1SRC_t DMAxC1SRC @0x18;
    DMAxC1DST_t DMAxC1DST @0x1C;
    DMAxC1LEN_t DMAxC1LEN @0x20;
    DMAxC1CFG_t DMAxC1CFG @0x24;
    DMAxC2SRC_t DMAxC2SRC @0x28;
    DMAxC2DST_t DMAxC2DST @0x2C;
    DMAxC2LEN_t DMAxC2LEN @0x30;
    DMAxC2CFG_t DMAxC2CFG @0x34;
    DMAxC3SRC_t DMAxC3SRC @0x38;
    DMAxC3DST_t DMAxC3DST @0x3C;
    DMAxC3LEN_t DMAxC3LEN @0x40;
    DMAxC3CFG_t DMAxC3CFG @0x44;
    DMAxCRC_t   DMAxCRC   @0x48;
    DMAxDESC_t  DMAxDESC  @0x4C;
};
