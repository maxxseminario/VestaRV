// DMAGO and DMAABORT are self-clearing command strobes: the CR read mux returns `errie & doneie & "00000000000" & dmaen`, so both fields read 0. A GO is suppressed while DMAEN = 0 or that channel is busy; an ABORT is always accepted.
reg DMAxCR_t {
    regwidth = 32;
    desc = "DMA control register. Holds the master enable (DMAEN), the per-channel arm/launch and orderly-abort command strobes (CHnGO / CHnABORT, self-clearing, read 0), and the two interrupt enables (DONEIE / ERRIE). Resets to 0. A byte-lane-0 write setting CHnGO[n] captures the channel n {SRC,DST,LEN,CFG} into the working registers and launches it (the launch is suppressed while DMAEN=0 or channel n is already busy). CHnGO/CHnABORT bits for n >= NCH read 0 and ignore writes.";
    field {
        sw = rw; hw = r;
        reset = 1'h0;
        vesta_access = "rw";
        encode = dmaxcr_dmaerrie_e;
        desc = "Error interrupt enable. When set, DMA0SR.CHnERR (OR over channels) drives the DMA0_ERR interrupt (vector 119).";
    } DMAERRIE[13:13];
    field {
        sw = rw; hw = r;
        reset = 1'h0;
        vesta_access = "rw";
        encode = dmaxcr_dmadoneie_e;
        desc = "Combined-done interrupt enable. When set, DMA0SR.CHnDONE (OR over channels) drives the DMA0_DONE interrupt (vector 118).";
    } DMADONEIE[12:12];
    field {
        sw = w; hw = r;
        reset = 4'h0;
        vesta_access = "w";
        desc = "Per-channel orderly-abort command (CHnABORT[3:0], bit 5+n = channel n). Write 1 to request channel n stop; any in-flight arbiter transaction completes normally (the handshake is never truncated), then the channel's busy drops WITHOUT setting CHnDONE or CHnERR (abort is neither done nor error, D15). Self-clearing command (reads 0). Bits for n >= NCH read 0 / ignore writes.";
    } DMAABORT[8:5];
    field {
        sw = w; hw = r;
        reset = 4'h0;
        vesta_access = "w";
        desc = "Per-channel arm+launch command (CHnGO[3:0], bit 1+n = channel n). Write 1 to a bit to capture that channel's programmed descriptor and start the transfer; self-clearing command (reads 0, D8). The launch is suppressed while DMAEN=0 or that channel is busy. Bits for n >= NCH read 0 / ignore writes.";
    } DMAGO[4:1];
    field {
        sw = rw; hw = r;
        reset = 1'h0;
        vesta_access = "rw";
        encode = dmaxcr_dmaen_e;
        desc = "Master enable. When 0 all channels are held idle and every CHnGO launch is suppressed. Set to 1 before arming a channel.";
    } DMAEN[0:0];
};

// Lane-0 write-1-to-clear on CHnDONE and CHnERR; BUSY and ACTIVECH are read-only. The engine's SET wins a same-cycle clear.
reg DMAxSR_t {
    regwidth = 32;
    desc = "DMA status register. BUSY and ACTIVECH are read-only; CHnDONE and CHnERR are sticky write-1-to-clear event flags (write a 1 to a bit to clear it; writing 0 leaves it unchanged; never cleared by a read; a set arriving the same cycle as a clear survives). BUSY asserts the SAME cycle as the triggering CHnGO write (busy OR a GO pending, D8/D16), so a driver may write GO then immediately spin on BUSY. DMA0_DONE (vector 118) = (OR of CHnDONE) and CR.DONEIE; DMA0_ERR (vector 119) = (OR of CHnERR) and CR.ERRIE, both combinational. CHnDONE/CHnERR/ACTIVECH bits for n >= NCH read 0.";
    field {
        sw = r; hw = w;
        reset = 3'h0;
        vesta_access = "r";
        desc = "Index of the currently-serviced channel (0 when idle, engine-set, D16).";
    } DMAACTIVECH[11:9];
    field {
        sw = rw; hw = w; onwrite = woclr;
        reset = 4'h0;
        vesta_access = "rw1";
        desc = "Per-channel error flags (CHnERR[3:0], bit 5+n = channel n). Set on a deny-guard hit, LEN=0 at GO, misaligned/out-of-window/TCM-hole SRC or DST (D13/A18); drives vector 119 when ERRIE is set. Write 1 to clear. Bits for n >= NCH read 0.";
    } DMAERR[8:5];
    field {
        sw = rw; hw = w; onwrite = woclr;
        reset = 4'h0;
        vesta_access = "rw1";
        desc = "Per-channel done flags (CHnDONE[3:0], bit 1+n = channel n). Set when channel n reaches LEN=0 (clean completion); drives vector 118 when DONEIE is set. Write 1 to clear. Bits for n >= NCH read 0.";
    } DMADONE[4:1];
    field {
        sw = r; hw = w;
        reset = 1'h0;
        vesta_access = "r";
        encode = dmaxsr_dmabusy_e;
        desc = "Any channel active OR a GO pending. Asserts the same cycle as the CHnGO write and stays high through real engine activity (no blind window, D8).";
    } DMABUSY[0:0];
};

reg DMAxC0SRC_t {
    regwidth = 32;
    desc = "Channel 0 source byte address in the 0x0-0x1FFFF shared window (word-aligned: bits[1:0] must be 0; bits[31:17] must be 0). The full written 32-bit value reads back; the engine presents byte_ptr(16:2) as the 15-bit arbiter word address. A misaligned, out-of-window (>= 0x20000), or TCM-hole (0x8000-0xBFFF) SRC is rejected at GO with CHnERR (D13/A18).";
    // Full 32-bit store and readback; bits 31:17 are writable scratch. An out-of-window (>= 0x20000), misaligned or TCM-hole address is rejected at GO with CHnERR.
    field {
        sw = rw; hw = r;
        reset = 32'h0;
        vesta_access = "rw";
        desc = "Source byte address (word-aligned).";
    } DMAC0SRC[31:0];
};

reg DMAxC0DST_t {
    regwidth = 32;
    desc = "Channel 0 destination byte address (same word-aligned / in-window / TCM-hole rules as C0SRC, D13/A18).";
    // Full 32-bit store and readback; bits 31:17 are writable scratch. An out-of-window (>= 0x20000), misaligned or TCM-hole address is rejected at GO with CHnERR.
    field {
        sw = rw; hw = r;
        reset = 32'h0;
        vesta_access = "rw";
        desc = "Destination byte address (word-aligned).";
    } DMAC0DST[31:0];
};

reg DMAxC0LEN_t {
    regwidth = 32;
    desc = "Channel 0 transfer length in WORDS. Decrements as the engine runs (a read returns the current remaining count, so pointers/LEN show where an aborted transfer stopped, D15); reads 0 before the first GO. LEN=0 at GO is a programming error (CHnERR, no transfer issued, D13).";
    // Full 32-bit store; the READ returns len_work, the WORKING remaining count, not the programmed seed (0 until the first GO).
    field {
        sw = rw; hw = rw;
        reset = 32'h0;
        vesta_access = "rw";
        desc = "Remaining transfer length in words.";
    } DMAC0LEN[31:0];
};

reg DMAxC0CFG_t {
    regwidth = 32;
    desc = "Channel 0 configuration: source/dest auto-increment (SINC/DINC, +4 per word when set, else a fixed peripheral data register), trigger source (TRIG), channel priority class (PRIO) and CRC ride-along enable (CRCEN). Program before GO.";
    field {
        sw = rw; hw = r;
        reset = 1'h0;
        vesta_access = "rw";
        encode = dmaxc0cfg_dmac0crcen_e;
        desc = "CRC ride-along enable. When set, each transferred word is folded (bytes low-to-high) into the shared DMA0CRC accumulator (CRC16-CDMA2000, D14). Use one CRCEN channel per measurement session (a single shared accumulator).";
    } DMAC0CRCEN[7:7];
    field {
        sw = rw; hw = r;
        reset = 1'h0;
        vesta_access = "rw";
        encode = dmaxc0cfg_dmac0prio_e;
        desc = "Priority class. Among serviceable channels the high class (1) is picked before the low class (0); within a class a round-robin pointer prevents starvation (D7). A continuously-serviceable PRIO=1 channel can hold off PRIO=0 channels (standard DMA priority semantic).";
    } DMAC0PRIO[6:6];
    field {
        sw = rw; hw = r;
        reset = 4'h0;
        vesta_access = "rw";
        encode = dmaxc0cfg_dmac0trig_e;
        desc = "Trigger source (D9/D10/A8). 0 = software / mem-to-mem (continuously serviceable); 1 = UART0 RC (one word per received byte, read-to-clear); 2 = QSPI0 RX-full (one word per event + an extra W1C ack txn); 3 = NFC0 payload-ready (a frame event launches the full LEN-word burst + one ack); 4-15 reserved. Pacing requires the source peripheral's own receive interrupt-enable bit set (A8).";
    } DMAC0TRIG[5:2];
    field {
        sw = rw; hw = r;
        reset = 1'h0;
        vesta_access = "rw";
        encode = dmaxc0cfg_dmac0dinc_e;
        desc = "Destination auto-increment. 1 = dst += 4 per word; 0 = dst held (peripheral fill register, D11).";
    } DMAC0DINC[1:1];
    field {
        sw = rw; hw = r;
        reset = 1'h0;
        vesta_access = "rw";
        encode = dmaxc0cfg_dmac0sinc_e;
        desc = "Source auto-increment. 1 = src += 4 per word (block copy); 0 = src held (peripheral data register, the paced-drain case, D11).";
    } DMAC0SINC[0:0];
};

