// ===========================================================================
// dma.rdl: the register map of hdl/common/periph/DMA.vhd.
//
// THE VHDL IS THE AUTHORITY. Three things it says that the generator's
// register table does not:
//   DMAxCRC resets to 0xFFFF (`crc_acc <= X"FFFF"`), not 0. The register's
//     own prose already says so; only the reset column disagrees.
//   DMAxCnSRC / DMAxCnDST / DMAxCnLEN are FULL 32-bit stores and full 32-bit
//     readbacks (`src_reg(ch) <= wdata`, `rdata_out <= src_reg(ch)`), so
//     bits 31:17 are writable scratch, not reserved-zero. Out-of-window and
//     misaligned values are rejected at GO with CHnERR rather than masked.
//   DMAxCR.DMAGO and DMAxCR.DMAABORT are write-1 command strobes that read 0
//     (they are absent from the CR read mux), not read/write bits.
//
// Every write in the block is byte-lane-0 qualified, so software uses
// full-word stores. DMAxDESC (slot 19) is reserved: reads 0, writes ignored.
//
// DMAGO and DMAABORT are written sw=w without `singlepulse`: SystemRDL 2.0
// restricts singlepulse to a ONE-BIT field, and both are four bits wide.
// ===========================================================================

`include "vesta_udp.rdl"

enum dmaxcr_dmaerrie_e {
    INTERRUPT_DISABLED = 1'h0 { desc = "Interrupt disabled"; };
    INTERRUPT_ENABLED = 1'h1 { desc = "Interrupt enabled"; };
};
enum dmaxcr_dmadoneie_e {
    INTERRUPT_DISABLED = 1'h0 { desc = "Interrupt disabled"; };
    INTERRUPT_ENABLED = 1'h1 { desc = "Interrupt enabled"; };
};
enum dmaxcr_dmaen_e {
    DISABLED = 1'h0 { desc = "Disabled"; };
    ENABLED = 1'h1 { desc = "Enabled"; };
};
enum dmaxsr_dmabusy_e {
    IDLE = 1'h0 { desc = "Idle"; };
    BUSY = 1'h1 { desc = "Busy"; };
};
enum dmaxc0cfg_dmac0crcen_e {
    NO_CRC = 1'h0 { desc = "No CRC"; };
    ACCUMULATE_CRC = 1'h1 { desc = "Accumulate CRC"; };
};
enum dmaxc0cfg_dmac0prio_e {
    LOW_PRIORITY_CLASS = 1'h0 { desc = "Low priority class"; };
    HIGH_PRIORITY_CLASS = 1'h1 { desc = "High priority class"; };
};
enum dmaxc0cfg_dmac0trig_e {
    SOFTWARE_MEM_TO_MEM = 4'h0 { desc = "Software / mem-to-mem"; };
    UART0_RECEIVE_COMPLETE = 4'h1 { desc = "UART0 receive-complete"; };
    QSPI0_RX_FULL = 4'h2 { desc = "QSPI0 RX-full"; };
    NFC0_PAYLOAD_READY = 4'h3 { desc = "NFC0 payload-ready"; };
};
enum dmaxc0cfg_dmac0dinc_e {
    FIXED_DESTINATION = 1'h0 { desc = "Fixed destination"; };
    INCREMENT_DESTINATION = 1'h1 { desc = "Increment destination"; };
};
enum dmaxc0cfg_dmac0sinc_e {
    FIXED_SOURCE = 1'h0 { desc = "Fixed source"; };
    INCREMENT_SOURCE = 1'h1 { desc = "Increment source"; };
};
enum dmaxc1cfg_dmac1crcen_e {
    NO_CRC = 1'h0 { desc = "No CRC"; };
    ACCUMULATE_CRC = 1'h1 { desc = "Accumulate CRC"; };
};
enum dmaxc1cfg_dmac1prio_e {
    LOW_PRIORITY_CLASS = 1'h0 { desc = "Low priority class"; };
    HIGH_PRIORITY_CLASS = 1'h1 { desc = "High priority class"; };
};
