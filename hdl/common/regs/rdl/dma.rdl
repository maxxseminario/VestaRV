    FIXED_DESTINATION = 1'h0 { desc = "Fixed destination"; };
    INCREMENT_DESTINATION = 1'h1 { desc = "Increment destination"; };
};
enum dmaxc1cfg_dmac1sinc_e {
    FIXED_SOURCE = 1'h0 { desc = "Fixed source"; };
    INCREMENT_SOURCE = 1'h1 { desc = "Increment source"; };
};
