# NPU is the one peripheral with no bench in //hdl/common/tb (its benches all
# instantiate the sram1p16k_hvt_pg macro and read vectors from files opened by
# a bare name), so its closure is declared here.  It needs the VHDL-2008 fixed
# point packages, which live in commune/ as .vhdl, and the two arithmetic
# blocks FPMac and FPSigmoid.
vhdl_source_set(
    name = "npu_rtl",
    paths = [
        "hdl/common/constants.vhd",
        "hdl/common/sim/ClkGate.vhd",
        "hdl/common/commune/fixed_float_types_c.vhdl",
        "hdl/common/commune/fixed_pkg_c.vhdl",
        "hdl/common/commune/FPMac.vhd",
        "hdl/common/commune/FPSigmoid.vhd",
        "hdl/common/periph_regs.vhd",
        "hdl/common/regs/vhdl/npu_regs_pkg.vhd",
        "hdl/common/periph/NPU.vhd",
    ],
    pool = ["//hdl:vhdl_sources"],
)

# The first standing synthesis check NPU has ever had in this tier: it is
# analyzed and elaborated by //opensource_sim/mcu:mcu_elaborate and nothing
# else.
ghdl_synth_test(
    name = "NPU",
    size = "small",
    srcs = [":npu_rtl"],
    allow_latches = ICG_LATCHES,
    entity = "NPU",
    tags = ["ghdl"],
)

