# The TRNG entropy source, `rtl` architecture -- the REAL ring ensemble, the
# one genus and the gate cell lists compile.  Its combinational ring feedback
# delta-loops a behavioural simulator into zero-time oscillation, which is why
# it has no bench and why TrngRoEnsemble_sim.vhd (the other architecture of
# this same entity) must never be co-listed with it.  Synthesis is the ONLY
# tier that can look at this file, so this target is its only gate.  It
# censuses 0 flop bits because a ring oscillator is pure combinational
# feedback; the number to watch is the cell count.
ghdl_synth_test(
    name = "TrngRoEnsemble",
    size = "small",
    srcs = [":trng_ro_rtl"],
    entity = "TrngRoEnsemble",
    tags = ["ghdl"],
)

vhdl_source_set(
    name = "trng_ro_rtl",
    paths = ["hdl/common/periph/TrngRoEnsemble.vhd"],
    pool = ["//hdl:vhdl_sources"],
)

# ---------------------------------------------------------------------------
# The tiles and the chip top
# ---------------------------------------------------------------------------
#
# All three need BLACK BOXES, because all three instantiate cells that are not
# RTL in the physical flow.  See hdl/common/synth/macro_blackbox.vhd for the
# contract; the short version is that genus reads these from timing libraries
# and elaborates them as blackboxes (`set_db hdl_error_on_blackbox false`,
# genus/MCU_WOUND/tcl/MCU_WOUND_hier.genus.tcl:163), the only HDL that exists
# for them is behavioural, and an 8 KiB array modelled as RTL would census as
# 65536 flop bits of silicon that does not exist.

vhdl_source_set(
    name = "hart_tile_rtl",
    paths = VESTA_RTL_PATHS + [
        "hdl/common/adddec.vhd",
        "hdl/common/hart_tile.vhd",
    ],
    pool = ["//hdl:vhdl_sources"],
)

# THE GENERICS ARE THE ONES genus/hart_tile/tcl/hart_tile.genus.tcl NAMES, and
# that file explains at length why each is named rather than defaulted: a
# generic left to its entity default while MCU.vhd passes something else is
# the M14 hw_clint_en defect, which this flow already reproduced once --
# measured, byte-for-byte, when ENABLE_DEBUG defaulted false and the assembly
# wired it true.  SH_AW = 16 is the penta shared-window width; ENABLE_DEBUG is
# true; and harts 1-4 are the MINIMAL-ISA tiles, rv32iac, so M, B, every
# Z-series extension, U-mode and PMP come off (the TILE_ENABLE_* set,
# MemoryMap.vhd:1324-1348).  A, C and the trap CSRs stay on: the tiles run the
# shared-fabric LR/SC locking, C shrinks code at an 8 KiB TCM, and ENABLE_DEBUG
# requires ENABLE_TRAPCSR.  Everything else keeps hart_tile.vhd's defaults,
# which is what a bare `elaborate hart_tile` takes.
ghdl_synth_test(
    name = "hart_tile",
    size = "small",
    srcs = [":hart_tile_rtl"],
    allow_latches = ICG_LATCHES,
    blackbox_srcs = ["macro_blackbox.vhd"],
    entity = "hart_tile",
    generics = {
        "SH_AW": "16",
        "ENABLE_DEBUG": "true",
        "ENABLE_MUL": "false",
        "ENABLE_DIV": "false",
        "ENABLE_BITMANIP": "false",
    },
    tags = ["ghdl"],
)

vhdl_source_set(
    name = "orch_tile_rtl",
    paths = VESTA_RTL_PATHS + [
        "hdl/common/adddec.vhd",
        "hdl/common/hart_tile.vhd",
        "hdl/common/orch_tile.vhd",
    ],
    pool = ["//hdl:vhdl_sources"],
)

# Hart 0, the orchestrator: a thin wrapper holding one bare
# `entity work.hart_tile`.  ONLY SH_AW IS OVERRIDDEN, exactly as
# genus/orch_tile/tcl/orch_tile.genus.tcl does it -- hart 0 keeps the FULL
# ISA, and it keeps it by inheriting hart_tile.vhd's `:= true` defaults
# through orch_tile's own.  That is correct but implicit, which is why the
# genus flow asserts the divider is present after elaboration; the census
# here is the same assertion by other means, since a tile that lost M would
# drop several hundred flop bits and several thousand cells at once.  The
# orch_tile row is deliberately the full-ISA twin of the hart_tile row above:
# the pair is the measurement that the two tiles are different on purpose.
ghdl_synth_test(
    name = "orch_tile",
    size = "small",
    srcs = [":orch_tile_rtl"],
    allow_latches = ICG_LATCHES,
    blackbox_srcs = ["macro_blackbox.vhd"],
    entity = "orch_tile",
    generics = {"SH_AW": "16"},
    tags = ["ghdl"],
)

# The cells the MCU reaches that are not RTL, dropped from the analysis list
# and replaced by hdl/common/synth/*_blackbox.vhd.  Three are analog or
# compiled cells whose only HDL is a behavioural model; the fourth is SYSTEM,
# which is here for a TOOL defect and not a design one -- ghdl --synth 6.0.0
# crashes on its `ClkEn(1) => open` individual association, which is why
# //hdl/common/synth:SYSTEM is already a documented skip.  Without that stub
# the crash propagates to the chip top and 29130 flop bits of coverage are
# lost to protect one block that is ungraded either way.
MCU_BLACKBOXED = [
    "hdl/common/sim/PowerOnResetCheng_behav.vhd",
    "hdl/common/sim/OscillatorCurrentStarved_simulation.vhd",
    "hdl/common/sim/GlitchFilter_behav.vhd",
    "hdl/common/periph/SYSTEM.vhd",
]

# The analysis order comes from //opensource_sim/mcu, not from a copy here.
# That list is DERIVED from VESTA_ISA_RTL and guarded by
# //opensource_sim/isa:source_list_sync_test, so the gate that elaborates the
# MCU and the gate that synthesizes it cannot drift apart.  The memory macro
# models are not in it -- //opensource_sim/mcu prepends its own behavioural
# stand-in, and this package prepends black boxes instead.
vhdl_source_set(
    name = "mcu_rtl",
    paths = [p for p in VESTA_MCU_RTL if p not in MCU_BLACKBOXED],
    pool = ["//hdl:vhdl_sources"],
)

# THE GENERATED CHIP TOP, at the castalia config the tree ships.  MCU.vhd has
# no generics at all: every knob reaches it through work.MemoryMap, which
# platform/common/python/mcu_vhd.py regenerates from the config, so "the
# shipped generics" for this block are whatever MemoryMap.vhd says today and
# the census moves when a knob moves.  That is the point -- MCU.vhd is
# GENERATED, it changes on every knob move, and until now the only thing
# catching a generated MCU that does not SYNTHESIZE was Genus.
# //opensource_sim/mcu:mcu_elaborate proves it elaborates and that its size
# asserts hold; this proves it is still hardware.
ghdl_synth_test(
    name = "MCU",
    size = "small",
    srcs = [":mcu_rtl"],
    allow_latches = ICG_LATCHES,
    blackbox_srcs = [
        "macro_blackbox.vhd",
        "system_blackbox.vhd",
    ],
    entity = "MCU",
    tags = ["ghdl"],
)

