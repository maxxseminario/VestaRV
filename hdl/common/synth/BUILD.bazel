# SKIPPED, and the only target here that is skipped for a TOOL defect rather
# than a design one.  SYSTEM.vhd:497 writes `ClkEn(1) => open` in an
# individual association.  `ghdl -a -frelaxed` accepts it (warning
# -Wopen-assoc, the same waiver xcelium's -relax gives, and the reason
# SYSTEM_tb carries -frelaxed), but `ghdl --synth` then dies inside its own
# front end:
#
#     Exception CONSTRAINT_ERROR raised
#     raised CONSTRAINT_ERROR : vhdl-nodes.adb:407 index check failed
#
# Two synth-side workarounds were tried and both crash identically: --out=none
# instead of --out=raw, and the file-list form (`--synth FILES -e SYSTEM`)
# instead of a pre-analysed library.  Fixing it on the RTL side means editing
# SYSTEM.vhd, which is out of scope here.  SYSTEM's synthesizability rests on
# Genus, as it did before this suite.
ghdl_synth_test(
    name = "SYSTEM",
    size = "small",
    entity = "SYSTEM",
    skip_reason = "ghdl --synth 6.0.0 raises CONSTRAINT_ERROR at " +
                  "vhdl-nodes.adb:407 on the `ClkEn(1) => open` individual " +
                  "association at SYSTEM.vhd:497; --out=none and the " +
                  "file-list form crash identically",
    tags = ["ghdl"],
)

