# SKIPPED.  periph_regs takes eleven word_array generics (RSTVAL, IMPL, W1C,
# WOSET, WOT, PULSE, RCLR, ...) that have NO DEFAULT, because every one of
# them is a per-peripheral table generated from the .rdl.  GHDL refuses:
# "entity \"periph_regs\" cannot be at the top of a design (generic \"RSTVAL\"
# has no default value)", and there is no command-line spelling for an
# unconstrained array generic.
#
# It is not ungraded.  Every peripheral target below synthesizes its OWN
# periph_regs instance at its OWN table, and the census records each one as a
# separate module ("periph_regs_Brtl_20_0_<hash>"), so a change to the shared
# register file moves sixteen frozen numbers at once.
ghdl_synth_test(
    name = "periph_regs",
    size = "small",
    entity = "periph_regs",
    skip_reason = "eleven word_array generics have no default, so GHDL " +
                  "refuses periph_regs as a top level; it is graded through " +
                  "the sixteen peripheral targets that instantiate it",
    tags = ["ghdl"],
)

