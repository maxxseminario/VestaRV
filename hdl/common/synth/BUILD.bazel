# The curated analysis order of opensource_sim/isa/run_isa.sh, minus the
# testbench and plus pmp_unit, which datapath instantiates as a component: at
# ENABLE_PMP false the generate that binds it is dead, but leaving the file out
# makes the binding UNBOUND rather than absent, and an unbound component in a
# synthesis run is exactly the class of defect this gate exists to catch.
# THREE conflicting `regfile` entities exist in the tree and only
# regfile_sbirq.vhd is correct; ClkGate must come from hdl/common/sim/, not the
# ARM cell of the same entity name in commune/.  Keep this list in step with
# run_isa.sh, sky130/synth.sh and sky130/sim/Makefile.
VESTA_RTL_PATHS = [
    "hdl/common/constants.vhd",
    "hdl/common/MemoryMap.vhd",
    "hdl/common/vesta/extend.vhd",
    "hdl/common/vesta/loadext.vhd",
    "hdl/common/vesta/store_ext.vhd",
    "hdl/common/vesta/branch_valid.vhd",
    "hdl/common/vesta/pulse_extender.vhd",
    "hdl/common/vesta/aludec.vhd",
    "hdl/common/vesta/maindec.vhd",
    "hdl/common/vesta/div.vhd",
    "hdl/common/vesta/alu.vhd",
    "hdl/common/vesta/regfile_sbirq.vhd",
    "hdl/common/vesta/c_dec.vhd",
    "hdl/common/vesta/csr_unit.vhd",
    "hdl/common/vesta/irq_handler.vhd",
    "hdl/common/vesta/pmp_unit.vhd",
    "hdl/common/vesta/fpu_simple.vhd",
    "hdl/common/vesta/fpu.vhd",
    "hdl/common/vesta/controller.vhd",
