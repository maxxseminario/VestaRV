    "hdl/common/sim/ClkGate.vhd",
    "hdl/common/vesta/vesta.vhd",
]

vhdl_source_set(
    name = "vesta_rtl",
    paths = VESTA_RTL_PATHS,
    pool = ["//hdl:vhdl_sources"],
)

# THE GENERICS ARE LOAD BEARING, AND THIS IS THE MEASUREMENT THAT SAYS SO.
# At the entity defaults (ENABLE_TRAPCSR false, ENABLE_DEBUG false) the hart
# synthesizes with 22 INFERRED LATCHES: csr_unit declares mst_mie, mst_mpie,
# mst_mpp, mtvec_base, mie_*, mscratch, mepc_r, mcause_*, mtval_r,
# mtrapctl_legacy and the whole dcsr/dpc/dscratch group as signals whose only
# writers live inside `if ENABLE_TRAPCSR generate` / `if ENABLE_DEBUG
# generate`, so with the generic off nothing drives them and the reads become
# latches.  At the SHIPPED settings (both true, MemoryMap.vhd:1312 and 1316,
# plus ENABLE_IF_AHEAD true at 1317) the count is ONE, and that one is
# ClkGate's.  Synthesizing this block at its defaults would have manufactured
# a 22-latch finding about a configuration the chip does not build.
ghdl_synth_test(
    name = "vesta",
    size = "small",
    srcs = [":vesta_rtl"],
    allow_latches = ICG_LATCHES,
    entity = "vesta",
    generics = {
        "ENABLE_TRAPCSR": "true",
        "ENABLE_DEBUG": "true",
        "ENABLE_IF_AHEAD": "true",
    },
    tags = ["ghdl"],
)

