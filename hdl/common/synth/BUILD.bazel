# The hermetic synthesizability gate for hdl/common.
#
# WHY THIS IS ITS OWN PACKAGE, AND NOT hdl/common/BUILD.bazel.
# ---------------------------------------------------------------------------
# The test_suite would read better as //hdl/common:synth, but hdl/common
# cannot become a bazel package.  //hdl:vhdl_sources is a `glob(["**/*.vhd"])`
# rooted at hdl/, and a glob does not descend into a subpackage -- that is why
# hdl/common/tb re-exports :tb_vhdl_sources and //hdl:vhdl_sources appends it
# by hand.  A BUILD file at hdl/common/ would carve out the ENTIRE RTL tree at
# once, and it would also break //hdl:npu_vhd ("common/periph/NPU.vhd") and
# //hdl:rdl_sources (glob "common/regs/rdl/*.rdl"), both of which name files
# across that boundary.  This directory holds no VHDL, so making it a package
# carves out nothing.  The suite is //hdl/common/synth:synth.
#
# WHY THE SOURCE LISTS ARE NOT REPEATED HERE.
# ---------------------------------------------------------------------------
# Every block's analysis order is already curated once, in
# //hdl/common/tb/BUILD.bazel, and a second copy would drift.  These targets
# reuse those vhdl_source_set targets directly.  The two lists that have no
# bench, and therefore no existing source set -- NPU and the vesta hart -- are
# defined below.
#
# WHAT A RED TARGET HERE MEANS.
# ---------------------------------------------------------------------------
# `ghdl --synth` refuses a `wait` statement in a process, an incomplete `if`
# that infers a latch, and a constant index outside its array bound.  Before
# this suite, all three reached Genus, which needs a license, takes minutes,
# and does not run on every commit.  The whole suite measures under 10 s.
#
# The counts each target produces are frozen in
# toolchains/ghdl/synth_census.json and graded by
# //toolchains/ghdl:synth_census_test, which is the half that catches a change
# no bench can see: a register bank that doubles, a reset that stops reaching
# a flop, a clock gate that grows a second latch.

load("//opensource_sim/mcu:defs.bzl", "VESTA_MCU_RTL")
load("//toolchains/ghdl:defs.bzl", "ghdl_synth_test", "vhdl_source_set")

package(default_visibility = ["//visibility:public"])

# The synthesis-only VHDL this package owns: the black-box stubs and the
# afe_stub width wrapper.  It is NOT added to //hdl:vhdl_sources -- that glob
# is rooted at hdl/ and does not descend into a subpackage, which is exactly
# what keeps a stub out of every simulation source pool.  The filegroup exists
# so //tools/ci:vhdl_style_test still holds these files to the 7-bit ASCII
# rule; the ghdl_synth_test targets below name them by path, not through it.
filegroup(
    name = "synth_vhdl_sources",
    srcs = [
        "afe_stub_top.vhd",
        "macro_blackbox.vhd",
        "system_blackbox.vhd",
    ],
)

# The clock cells that hold a latch on purpose.  ClkGate's ClkSync is the
# behavioural integrated clock gate (hdl/common/sim/ClkGate.vhd:20); PreICG and
# ClockMuxGlitchFree are the glitch-free mux pair
# (hdl/common/sim/ClockMuxGlitchFree.vhd).  Patterns, not names, because GHDL
# appends the generic set to the module name
# ("clockmuxglitchfree_Bbehavioral_4_2_0").
ICG_LATCHES = [
    "clkgate_B*",
    "preicg_B*",
    "clockmuxglitchfree_B*",
]

