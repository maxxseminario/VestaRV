    entity = "sync",
    tags = ["ghdl"],
)

# SKIPPED.  periph_regs takes eleven word_array generics (RSTVAL, IMPL, W1C,
# WOSET, WOT, PULSE, RCLR, ...) that have NO DEFAULT, because every one of
# them is a per-peripheral table generated from the .rdl.  GHDL refuses:
# "entity \"periph_regs\" cannot be at the top of a design (generic \"RSTVAL\"
# has no default value)", and there is no command-line spelling for an
# unconstrained array generic.
#
# It is not ungraded.  Every peripheral target below synthesizes its OWN
# periph_regs instance at its OWN table, and the census records each one as a
# separate module ("periph_regs_Brtl_20_0_<hash>"), so a change to the shared
# register file moves sixteen frozen numbers at once.
ghdl_synth_test(
    name = "periph_regs",
    size = "small",
    entity = "periph_regs",
    skip_reason = "eleven word_array generics have no default, so GHDL " +
                  "refuses periph_regs as a top level; it is graded through " +
                  "the sixteen peripheral targets that instantiate it",
    tags = ["ghdl"],
)

# ---------------------------------------------------------------------------
# The hart
# ---------------------------------------------------------------------------

# The curated analysis order of opensource_sim/isa/run_isa.sh, minus the
# testbench and plus pmp_unit, which datapath instantiates as a component: at
# ENABLE_PMP false the generate that binds it is dead, but leaving the file out
# makes the binding UNBOUND rather than absent, and an unbound component in a
# synthesis run is exactly the class of defect this gate exists to catch.
# THREE conflicting `regfile` entities exist in the tree and only
# regfile_sbirq.vhd is correct; ClkGate must come from hdl/common/sim/, not the
# ARM cell of the same entity name in commune/.  Keep this list in step with
# run_isa.sh, sky130/synth.sh and sky130/sim/Makefile.
vhdl_source_set(
    name = "vesta_rtl",
    paths = [
        "hdl/common/constants.vhd",
        "hdl/common/MemoryMap.vhd",
        "hdl/common/vesta/extend.vhd",
        "hdl/common/vesta/loadext.vhd",
        "hdl/common/vesta/store_ext.vhd",
        "hdl/common/vesta/branch_valid.vhd",
        "hdl/common/vesta/pulse_extender.vhd",
        "hdl/common/vesta/aludec.vhd",
        "hdl/common/vesta/maindec.vhd",
        "hdl/common/vesta/div.vhd",
        "hdl/common/vesta/alu.vhd",
        "hdl/common/vesta/regfile_sbirq.vhd",
        "hdl/common/vesta/c_dec.vhd",
        "hdl/common/vesta/csr_unit.vhd",
        "hdl/common/vesta/irq_handler.vhd",
        "hdl/common/vesta/pmp_unit.vhd",
        "hdl/common/vesta/fpu_simple.vhd",
        "hdl/common/vesta/fpu.vhd",
        "hdl/common/vesta/controller.vhd",
        "hdl/common/vesta/datapath.vhd",
        "hdl/common/sim/ClkGate.vhd",
        "hdl/common/vesta/vesta.vhd",
    ],
    pool = ["//hdl:vhdl_sources"],
)

# THE GENERICS ARE LOAD BEARING, AND THIS IS THE MEASUREMENT THAT SAYS SO.
# At the entity defaults (ENABLE_TRAPCSR false, ENABLE_DEBUG false) the hart
# synthesizes with 22 INFERRED LATCHES: csr_unit declares mst_mie, mst_mpie,
# mst_mpp, mtvec_base, mie_*, mscratch, mepc_r, mcause_*, mtval_r,
# mtrapctl_legacy and the whole dcsr/dpc/dscratch group as signals whose only
# writers live inside `if ENABLE_TRAPCSR generate` / `if ENABLE_DEBUG
# generate`, so with the generic off nothing drives them and the reads become
# latches.  At the SHIPPED settings (both true, MemoryMap.vhd:1312 and 1316,
# plus ENABLE_IF_AHEAD true at 1317) the count is ONE, and that one is
# ClkGate's.  Synthesizing this block at its defaults would have manufactured
# a 22-latch finding about a configuration the chip does not build.
ghdl_synth_test(
    name = "vesta",
    size = "small",
    srcs = [":vesta_rtl"],
    allow_latches = ICG_LATCHES,
    entity = "vesta",
    generics = {
        "ENABLE_TRAPCSR": "true",
        "ENABLE_DEBUG": "true",
        "ENABLE_IF_AHEAD": "true",
    },
    tags = ["ghdl"],
)

