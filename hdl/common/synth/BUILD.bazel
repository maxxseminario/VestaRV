    ":QSPI",
    ":RTC",
    ":SPI",
    ":SYSTEM",
    ":TIMER",
    ":TRNG",
    ":UART",
    ":clint",
    ":debug_module",
    ":irq_router",
    ":mp_arbiter",
    ":mutex_bank",
    ":periph_regs",
    ":pmp_unit",
    ":pwr_ctrl",
    ":sync",
    ":vesta",
]

test_suite(
    name = "synth",
    tags = ["ghdl"],
    tests = SYNTH_TARGETS,
)

# Every target's census JSON, pulled out of the "census" output group that
# ghdl_synth_test declares alongside its test executable.  This is what lets
# //toolchains/ghdl:synth_census_test grade all 27 blocks without re-running a
# single synthesis: the counts are already on disk as build outputs of the
# same actions the tests read.
filegroup(
    name = "synth_censuses",
    testonly = True,
    srcs = SYNTH_TARGETS,
    output_group = "census",
)
