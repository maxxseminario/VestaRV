# The peripheral closures. constants and MemoryMap come first, then the
# behavioural clock cells the peripheral instantiates, then the peripheral's
# generated register package, then the peripheral. The package carries the word
# offsets, field ranges, resets and implemented-bit masks the .rdl describes
# (report R8a); every one of the twenty-two is listed here whether or not its
# entity has adopted it yet, because a package no entity `use`s costs one
# analysis and nothing else, and a wave that adopts one then has no BUILD file
# to edit.
# hdl/common/sim/ClkGate.vhd is the behavioural model; the ARM cell of the same
# entity name in commune/ is the synthesis view and must NOT be in these lists.
vhdl_source_set(
    name = "system_rtl",
    paths = [
        "hdl/common/constants.vhd",
        "hdl/common/MemoryMap.vhd",
        "hdl/common/sim/ClkGate.vhd",
        "hdl/common/sim/ClockMuxGlitchFree.vhd",
        "hdl/common/commune/CRC16.vhd",
        "hdl/common/regs/vhdl/system_regs_pkg.vhd",
        "hdl/common/periph/SYSTEM.vhd",
    ],
    pool = ["//hdl:vhdl_sources"],
)

