# The Debug Module register-level bench: abstractauto (0x18) and the dmstatus
# havereset lifecycle, graded against a shared-window RAM model and a
# token-protocol hart model that stand in for the rest of the chip.
#
# It carries its own seen-to-fail record.  Against the pre-abstractauto RTL the
# same file fails 19 of its 48 checks, and each of the four subtle behaviours
# is separated from its neighbours by a control check that passes in BOTH
# builds (B2 for "the trigger is the register and not the access", C3 for "the
# two progbuf bits are armed separately", E1a/E2 for "cmderr suppresses the
# re-issue", G3/G5c for "havereset is per hart").
ghdl_test(
    name = "dbg_module_tb",
    size = "small",
    srcs = [
        ":debug_module_rtl",
        "dbg_module_tb.vhd",
    ],
    entity = "dbg_module_tb",
    pass_pattern = "ALL CHECKS PASSED",
    sim_timeout_s = 120,
    tags = ["ghdl"],
)

# The JTAG debug transport bench: TAP state-machine scans on tck/tms/tdi
# (IDCODE, dtmcs, BYPASS, the 41-bit dmi DR) against a bench-written DMI slave
# model, with tck and mclk at an INCOMMENSURATE ratio (37 ns against 10 ns) so
# the four-phase toggle handshake is not exercised at one fixed edge phase.
#
# 104 checks in one run.  It carries its own seen-to-fail record, measured by
# mutating the DUT in a scratch copy (report P3):
#   * rsp_tgl held instead of toggled in M_RSP: 35 checks fail, from E1 on.
#   * the request-side synchroniser bypassed (req_s2 driven from req_tgl):
#     D10 and J3b fail on the crossing latency, and nothing else does.  That
#     pair is the ONLY instrument here that can see a missing sync stage --
#     removing a stage changes no value, only latency, so an event-driven
#     simulation is blind to it unless the latency itself is asserted.
#   * the response-side synchroniser bypassed: NOT caught, and the bench does
#     not claim to.  The response chain's depth is not observable at the
#     ports; it shows up only as a shift in when a capture stops reading BUSY,
#     which is not a bound worth pinning.
#
# STRICT_TRSTN_GUARD selects which contract section H grades; see the bench
# header and the jtag_dtm_trstn_guard_strict_tb target below.
ghdl_test(
    name = "jtag_dtm_tb",
    size = "small",
    srcs = [
        ":jtag_dtm_rtl",
        "jtag_dtm_tb.vhd",
    ],
    entity = "jtag_dtm_tb",
    pass_pattern = "ALL CHECKS PASSED",
    sim_timeout_s = 120,
    tags = ["ghdl"],
)

# OPEN DEFECT P3-1, held as a MANUAL target so it is out of the wildcard suite
# and cannot be mistaken for a regression somebody else introduced.
#
# jtag_dtm.vhd:~470 gates the mclk edge detect on `trstn_guard(2)`, a REGISTERED
# function of trstn_s2.  trstn and req_tgl both fall at the TRSTn edge and both
# cross on DEPTH-2 chains, so trstn_s2 and req_s2 change on the SAME mclk edge:
# the guard still reads high on the very edge that detects the toggle TRSTn
# manufactured, and one unqualified op = "00" request at address 0 escapes to
# the Debug Module.  Measured, not inferred -- the default target pins the
# escape's bound (one request, zeroed payload), this one states the contract
# the RTL's own comment claims and is RED until the guard is fixed.
#
# The fix is one line, and with it applied this target runs GREEN (measured):
#   if rst_guard(2) = '1' and trstn_s2 = '1' and trstn_guard(2) = '1'
#      and (req_s2 /= req_s3) then
#
#   tools/bin/bazel test //hdl/common/tb:jtag_dtm_trstn_guard_strict_tb
ghdl_test(
    name = "jtag_dtm_trstn_guard_strict_tb",
    size = "small",
    srcs = [
        ":jtag_dtm_rtl",
        "jtag_dtm_tb.vhd",
    ],
    entity = "jtag_dtm_tb",
    generics = {"STRICT_TRSTN_GUARD": "true"},
    pass_pattern = "ALL CHECKS PASSED",
    sim_timeout_s = 120,
    tags = [
        "ghdl",
        
    ],
)

# ---------------------------------------------------------------------------
# The rest of the single-file-closure benches, ported 2026-09-05.
#
# Same criterion as the three above: a bench is ported when its ENTIRE source
# closure is tracked VHDL in this repository, with no vendor macro and no
# generated image. That is what excludes dbg_iface_tb, dbg_dmi_tb, riscv_tb,
# NPU_pack_tb and the SPI flash bench, all of which reach a vendor RAM/ROM
# macro, a pad cell or an .rcf.
#
# What this closes, measured against the last evidence each bench had before
# today (report 08a, tables 1 and 3):
#   pwr_ctrl_tb   xcelium 2026-07-24 at NHARTS=4, T_SEQ=2, T_RAIL=8 only. The
#                 chip instantiates NHARTS=5, T_SEQ=4, T_RAIL=256 (MCU.vhd:3030)
#                 and that shape had NEVER been run; it failed 12 checks on the
#                 bench's fixed poll budget until the guard was scaled.
#   irq_router_tb xcelium 2026-07-22, five shapes, none of them NHARTS=5, MW=3,
#                 NUM_SRCS=125, the shape that needs four enable words.
#   irq_sys_tb    xcelium 2026-07-12, compiled from the pre-restructure
#                 hdl/MCU_MP path that no longer exists.
#   arb_lat_tb    xcelium 2026-07-06 at N_MASTERS=4; the arbiter ships with
#                 N=6 (MCU.vhd:2627).
#   SYSTEM_tb     last hdl/common run 2026-07-16, before PGEN_mem widened to
#                 7 bits; the xcelium peripheral suite compiles the FROZEN
#                 hdl/myshkin copies of SYSTEM/I2C/SPI and their benches, which
#                 differ from hdl/common by 227/213/52 lines, so these five
#                 targets are the first standing proof of the castalia RTL.
#   I2C_tb        no standalone run on record at all before 2026-09-05.
#
# The generics are the SHIPPED shapes, not the fast ones. The xcelium runners
# keep the multi-shape sweeps (pwr_ctrl 4/18, irq_router five shapes, arb_lat
# N_DELAY 0/1/2 and the BREAK_MODE negative controls); this tier proves the one
# shape the chip actually contains, on every commit, without a license.
# ---------------------------------------------------------------------------

