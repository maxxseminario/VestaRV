# ---------------------------------------------------------------------------
# TIMER_tb and GPIO_tb carry a DELIBERATE negative control as their last check
# (TIMER_tb.vhd:508, GPIO_tb.vhd:~350), so a passing run ends with the
# scoreboard reporting exactly one failure. Both benches grade that themselves
# -- `if sb.errors = 1` -- and print a banner naming the count.
#
# pass_pattern is therefore that banner, NOT "ALL CHECKS PASSED": the benches
# print the generic banner inside the same guarded report, so grepping for it
# alone would pass, but it would no longer be the criterion the bench states.
# Grepping the count makes a second, unintended failure red -- which grepping
# "ALL CHECKS PASSED" would also do here, and which grepping the absence of
# "CHECK(S) FAILED" would NOT, because the scoreboard summary prints that line
# on every passing run.
# ---------------------------------------------------------------------------
ghdl_test(
    name = "TIMER_tb",
    size = "small",
    srcs = [
        ":timer_rtl",
        "periph_tb_pkg.vhd",
        "TIMER_tb.vhd",
    ],
    entity = "TIMER_tb",
    pass_pattern = "TIMER_TB PASS (1 expected negative-control failure)",
    sim_timeout_s = 300,
    tags = ["ghdl"],
)

