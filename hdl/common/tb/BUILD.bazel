# Testbench-side host tools and the VHDL testbench sources.
#
# NOTE FOR //hdl:vhdl_sources OWNERS.
# Creating this BUILD file makes hdl/common/tb its own bazel package, so the
# glob in //hdl:vhdl_sources no longer descends into it.
# The :tb_vhdl_sources filegroup below re-exports exactly what that glob used
# to pick up here, so //hdl:vhdl_sources should add it to its srcs.

load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_python//python:defs.bzl", "py_test")
load("//toolchains/ghdl:defs.bzl", "ghdl_test", "vhdl_source_set")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "tb_vhdl_sources",
    srcs = glob(
        [
            "*.vhd",
            "*.vhdl",
        ],
        allow_empty = True,
    ),
)

exports_files([
    "fpu_vec_gen.c",
    "gen_fpu_vectors.sh",
])

# ---------------------------------------------------------------------------
# FPU reference vector generator.
#
# gen_fpu_vectors.sh builds this with a NATIVE x86-64 gcc and documents the
# binding reference discipline (gatekeeper correction C4): SSE single
# precision with -msse2 -mfpmath=sse, x87 FORBIDDEN, glibc fmaf for the fused
# multiply-add family, fesetround / fetestexcept for rounding and IEEE flags.
# Under bazel the compiler is the registered hermetic zig (clang) toolchain
# targeting linux_amd64_gnu.2.17, which is NOT the same C library and not the
# same compiler front end as the reference. See the loud comment on
# :fpu_vectors_generated below before trusting its output.
# ---------------------------------------------------------------------------
cc_binary(
    name = "fpu_vec_gen",
    srcs = ["fpu_vec_gen.c"],
    copts = [
        "-O2",
        "-std=c99",
        "-msse2",
        "-mfpmath=sse",
        "-frounding-math",
    ],
    linkopts = ["-lm"],
)

# ---------------------------------------------------------------------------
# WARNING -- THIS IS NOT A DROP-IN REPLACEMENT FOR gen_fpu_vectors.sh.
#
# There is no committed fpu_vectors.txt anywhere in the tree (fpu_tb.vhd reads
# it through the VECFILE generic and the file is produced on demand), so there
# is no golden artifact this rule can be proven byte-identical against, and
# this host has no native gcc to cross-generate one with.
# The reference discipline above is a statement about a specific libm and a
# specific compiler; until a run of gen_fpu_vectors.sh under the intended
# native toolchain has been diffed against this output, the shell script stays
# authoritative and this target is a convenience only.
# Do NOT wire it into a signoff flow on the strength of "bazel built it".
# ---------------------------------------------------------------------------
genrule(
    name = "fpu_vectors_generated",
    outs = ["fpu_vectors.generated.txt"],
    cmd = "$(location :fpu_vec_gen) $@",
    tools = [":fpu_vec_gen"],
)

# Self-check of the generator itself, which is what can be proven here: the
# emitted file is deterministic (the xorshift RNG is fixed-seeded) and every
# line matches the fixed-width record format fpu_tb.vhd parses.
py_test(
    name = "fpu_vectors_format_test",
    size = "small",
    srcs = ["fpu_vectors_format_test.py"],
    args = ["$(location :fpu_vectors_generated)"],
    data = [":fpu_vectors_generated"],
    main = "fpu_vectors_format_test.py",
)

# ---------------------------------------------------------------------------
# Unit benches ported from the untracked xcelium/mp_test runners to GHDL.
#
# Only benches whose ENTIRE source closure is tracked VHDL are ported. The two
# below are the smallest such closures; the runner for dbg_iface is deliberately
# absent, because that bench instantiates ARM_IP_RAM, a vendor macro that is not
# in this repository.
#
# tcm_port was absent for the same reason and NO LONGER IS. It is now
# //opensource_sim/mcu:tcm_port_tb, and it lives in that package rather than
# beside its siblings here because the tracked stand-in for the vendor macro
# (mem_macros_sim.vhd) and the source list that reaches hart_tile both live
# there. What that eight-day gap cost is written on the target.
#
# The xcelium runners compile with -V200X and grep the log for the scoreboard
# banner. GHDL analyzes both benches clean under --std=08 -fsynopsys, so the
# targets use the tree-wide 2008 settings, and pass_pattern reproduces the
# banner grep exactly rather than trusting the exit code alone.
# ---------------------------------------------------------------------------

# The RTL these benches bind lives in the //hdl package, whose source files are
# not exported; //hdl:vhdl_sources is the public handle.
vhdl_source_set(
    name = "mp_arbiter_rtl",
    paths = ["hdl/common/mp_arbiter.vhd"],
    pool = ["//hdl:vhdl_sources"],
)

vhdl_source_set(
    name = "pmp_unit_rtl",
    paths = [
        "hdl/common/constants.vhd",
        "hdl/common/vesta/pmp_unit.vhd",
    ],
    pool = ["//hdl:vhdl_sources"],
)

# The Debug Module's whole source closure is one file: it uses nothing from
# constants.vhd or MemoryMap.vhd, and every port it needs from the rest of the
# chip is an entity generic or a defaulted formal.  That is what lets the DM be
# unit-tested here at all, where dbg_dmi_tb.vhd has to instantiate the whole MCU
# (and therefore a vendor pad macro, a flash model and a boot image) to reach
# the same DMI port.
vhdl_source_set(
    name = "debug_module_rtl",
    paths = [
        "hdl/common/regs/vhdl/debug_module_regs_pkg.vhd",
        "hdl/common/debug_module.vhd",
    ],
    pool = ["//hdl:vhdl_sources"],
)

# xcelium/mp_test/run_arbiter.sh (M3c): four synthetic masters contending for
# one shared single-port RAM.
ghdl_test(
    name = "mp_arbiter_tb",
    size = "small",
    srcs = [
        ":mp_arbiter_rtl",
        "mp_arbiter_tb.vhd",
    ],
    entity = "mp_arbiter_tb",
    pass_pattern = "ALL CHECKS PASSED",
    sim_timeout_s = 90,
    tags = ["ghdl"],
)

# xcelium/mp_test/run_pmp_unit.sh (P3): a purely combinational bench that
# instantiates all three DUT shapes (ENABLE_PMP true with 16 and 8 entries,
# and ENABLE_PMP false) in one run, so one invocation covers the whole
# generic matrix.
ghdl_test(
    name = "pmp_unit_tb",
    size = "small",
    srcs = [
        ":pmp_unit_rtl",
        "pmp_unit_tb.vhd",
    ],
    entity = "pmp_unit_tb",
    pass_pattern = "ALL CHECKS PASSED",
    sim_timeout_s = 90,
    tags = ["ghdl"],
)

# The Debug Module register-level bench: abstractauto (0x18) and the dmstatus
# havereset lifecycle, graded against a shared-window RAM model and a
# token-protocol hart model that stand in for the rest of the chip.
#
# It carries its own seen-to-fail record.  Against the pre-abstractauto RTL the
# same file fails 19 of its 48 checks, and each of the four subtle behaviours
# is separated from its neighbours by a control check that passes in BOTH
# builds (B2 for "the trigger is the register and not the access", C3 for "the
# two progbuf bits are armed separately", E1a/E2 for "cmderr suppresses the
# re-issue", G3/G5c for "havereset is per hart").
ghdl_test(
    name = "dbg_module_tb",
    size = "small",
    srcs = [
        ":debug_module_rtl",
        "dbg_module_tb.vhd",
    ],
    entity = "dbg_module_tb",
    pass_pattern = "ALL CHECKS PASSED",
    sim_timeout_s = 120,
    tags = ["ghdl"],
)

# ---------------------------------------------------------------------------
# The rest of the single-file-closure benches, ported 2026-09-05.
#
# Same criterion as the three above: a bench is ported when its ENTIRE source
# closure is tracked VHDL in this repository, with no vendor macro and no
# generated image. That is what excludes dbg_iface_tb, dbg_dmi_tb, riscv_tb,
# NPU_pack_tb and the SPI flash bench, all of which reach a vendor RAM/ROM
# macro, a pad cell or an .rcf.
#
# What this closes, measured against the last evidence each bench had before
# today (report 08a, tables 1 and 3):
#   pwr_ctrl_tb   xcelium 2026-07-24 at NHARTS=4, T_SEQ=2, T_RAIL=8 only. The
#                 chip instantiates NHARTS=5, T_SEQ=4, T_RAIL=256 (MCU.vhd:3030)
#                 and that shape had NEVER been run; it failed 12 checks on the
#                 bench's fixed poll budget until the guard was scaled.
#   irq_router_tb xcelium 2026-07-22, five shapes, none of them NHARTS=5, MW=3,
#                 NUM_SRCS=125, the shape that needs four enable words.
#   irq_sys_tb    xcelium 2026-07-12, compiled from the pre-restructure
#                 hdl/MCU_MP path that no longer exists.
#   arb_lat_tb    xcelium 2026-07-06 at N_MASTERS=4; the arbiter ships with
#                 N=6 (MCU.vhd:2627).
#   SYSTEM_tb     last hdl/common run 2026-07-16, before PGEN_mem widened to
#                 7 bits; the xcelium peripheral suite compiles the FROZEN
#                 hdl/myshkin copies of SYSTEM/I2C/SPI and their benches, which
#                 differ from hdl/common by 227/213/52 lines, so these five
#                 targets are the first standing proof of the castalia RTL.
#   I2C_tb        no standalone run on record at all before 2026-09-05.
#
# The generics are the SHIPPED shapes, not the fast ones. The xcelium runners
# keep the multi-shape sweeps (pwr_ctrl 4/18, irq_router five shapes, arb_lat
# N_DELAY 0/1/2 and the BREAK_MODE negative controls); this tier proves the one
# shape the chip actually contains, on every commit, without a license.
# ---------------------------------------------------------------------------

vhdl_source_set(
    name = "pwr_ctrl_rtl",
    paths = [
        "hdl/common/regs/vhdl/pwr_ctrl_regs_pkg.vhd",
        "hdl/common/pwr_ctrl.vhd",
