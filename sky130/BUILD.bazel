# VestaRV: sky130 open-source physical flow.
#
# Nothing here is a bazel build or test yet: synth.sh drives yosys and sim/Makefile drives
# cocotb, and neither tool is a module in this workspace. What is published are the two source
# lists, so //opensource_sim/isa:source_list_sync_test can hold them to the order they share.

package(default_visibility = ["//visibility:public"])

exports_files([
    "synth.sh",
    "sim/Makefile",
])

filegroup(
    name = "vesta_source_lists",
    srcs = [
        "sim/Makefile",
        "synth.sh",
    ],
)
