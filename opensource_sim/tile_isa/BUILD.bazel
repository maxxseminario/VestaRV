# GHDL ISA regression at the CORNER-TILE polarity: the same bare core as
# //opensource_sim/isa with M and B turned off, which is what harts 1-4 are.
#
# ---------------------------------------------------------------------------
# WHY THIS PACKAGE EXISTS
# ---------------------------------------------------------------------------
# isa.minimalTiles builds harts 1..N-1 rv32iac while hart 0 keeps the full chip
# ISA. The generator implements that split with a TILE_ENABLE_<X> constant for
# every knob under isa.* and priv.* (ChipGenerator.py's TILE_ENABLE_* emission,
# handed to the tile instances by mcu_vhd.py coreGenericLines), and a minimal
# tile takes the whole set at false: M, Zb, every Z-series extension, U-mode and
# PMP. A and C stay (the 'a' and 'c' of rv32iac) and so do the trap CSRs, which
# ENABLE_DEBUG requires. So the tile core is hart 0 minus every selectable
# extension, and until this package existed nothing in the test estate ran an
# image against a core in that shape: //opensource_sim/isa runs them ON, and the
# genus tile flow asserts the divider is ABSENT but never executes an
# instruction.
#
# WIDENED 2026-09-12 (P12), with the generator split. The first version of this
# package dropped M and B only, because that was the whole of the split; P10
# finding F1 was that the split was too narrow, and this file follows it.
#
# CastaliaB (config/castalia_b.json) is what made that gap worth closing. Its
# hart 0 turns on every selectable extension, and before F1 was fixed its TILES
# inherited every one of them; now the tiles subtract them, and this package is
# what proves the subtracted core still executes the shared images. One
# combination the widening REMOVES, named so nobody looks for it here: Zcb with
# M off, where c.mul expands to a base MUL that maindec traps (c_dec.vhd:438).
# Zcb is off on a minimal tile now, so c.mul does not decode at all and that arm
# is reachable only on a non-minimal build.
#
# ---------------------------------------------------------------------------
# POLARITY, AND WHAT IT COSTS
# ---------------------------------------------------------------------------
# The images are //verification/isa's CI-polarity rv32ui set, the same ones
# //opensource_sim/isa consumes, for the same reason given in that file: one
# rv32ui source reads a CORE_ENABLE_* define (zbk.S) and the rest are
# polarity-independent. The images are NOT rebuilt without -march M: an rv32ui
# riscv-tests source is hand-written assembly and emits no compiler-chosen
# multiply, which is why the suite runs at all on a core with no multiplier.
#
# The bench generics are the only difference from //opensource_sim/isa's
# targets. vesta_isa_tb.vhd carries ENABLE_MUL/ENABLE_DIV/ENABLE_BITMANIP at
# its own boundary, defaulted true, so every other consumer of that bench is
# untouched and this package is a -g override.
#
# SUITE SCOPE: rv32ui, mirroring //opensource_sim/isa's pilot. The suites that
# a tile could also run (rv32ua for the LR/SC + AMO locking the tiles own,
# rv32uc for C) have no per-test targets anywhere yet; when the per-test port
# reaches them, add them here with the same generics.

load("//toolchains/ghdl:defs.bzl", "ghdl_test", "vhdl_source_set")
load("//opensource_sim/isa:defs.bzl", "VESTA_ISA_RTL")

package(default_visibility = ["//visibility:public"])

_IMAGE_PACKAGE = "//verification/isa"

vhdl_source_set(
    name = "vesta_tile_srcs",
    paths = VESTA_ISA_RTL,
    pool = ["//hdl:vhdl_sources"],
)

# The tile ISA: hart 0's set minus every selectable extension. Written as the
# generics the generator's split actually moves, so this list and TILE_ENABLE_*
# in a generated MemoryMap.vhd are the same statement.
#
# ABSENT ON PURPOSE, and each absence is the tile-class policy rather than an
# omission: ENABLE_ATOMICS and ENABLE_COMPRESSED (the 'a' and 'c' of rv32iac,
# never dropped), ENABLE_TRAPCSR (kept -- ENABLE_DEBUG requires it) and
# ENABLE_IF_AHEAD (microarchitecture, identical on both classes). Zihpm and
# Zawrs are listed even though this bench already defaults them false, so the
# list reads as the tile subset and not as a diff against the bench.
_TILE_GENERICS = {
    "ENABLE_MUL": "false",
    "ENABLE_DIV": "false",
    "ENABLE_BITMANIP": "false",
    "ENABLE_ZICOND": "false",
    "ENABLE_ZCB": "false",
    "ENABLE_ZIMOP": "false",
    "ENABLE_ZIHINT": "false",
    "ENABLE_ZIHPM": "false",
    "ENABLE_ZAWRS": "false",
    "ENABLE_ZABHA": "false",
    "ENABLE_ZACAS": "false",
    "ENABLE_ZICBOZ": "false",
    "ENABLE_ZCMP": "false",
    "ENABLE_ZCMT": "false",
    "ENABLE_ZBKB": "false",
    "ENABLE_ZBKC": "false",
    "ENABLE_ZBKX": "false",
    "ENABLE_ZKN": "false",
    "ENABLE_ZFINX": "false",
}

# The live rv32ui set of //opensource_sim/isa, minus any test that needs a
# dropped extension to reach its own check. MEASURED EMPTY, twice: all 42 passed
# at the M-and-B-only polarity (P10) and all 42 passed again at the full
# subtraction above (P12). The map stays as the mechanism, and an entry added
# here must carry the observed failure, never an assumption.
_SKIP = {}

# Transcribed from //opensource_sim/isa's _LIVE. A test added there and not
# here shows up as an absent target rather than as silent loss of coverage,
# which is why the list is spelled out.
_TESTS = [
    "add",
    "addi",
    "and",
    "andi",
    "auipc",
    "beq",
    "bge",
    "bgeu",
    "blt",
    "bltu",
    "bne",
    "jal",
    "jalr",
    "lb",
    "lbu",
    "ld_st",
    "lh",
    "lhu",
    "lui",
    "lw",
    "or",
    "ori",
    "sb",
    "sh",
    "shmem",
    "simple",
    "sll",
    "slli",
    "slt",
    "slti",
    "sltiu",
    "sltu",
    "sra",
    "srai",
    "srl",
    "srli",
    "st_ld",
    "sub",
    "sw",
    "xor",
    "xori",
    "zbk",
]

_LIVE = [t for t in _TESTS if t not in _SKIP]

[
    ghdl_test(
        name = "tile-rv32ui-p-%s" % test,
        size = "medium",
        srcs = [
            ":vesta_tile_srcs",
            "//opensource_sim/isa:vesta_isa_tb.vhd",
        ],
        entity = "vesta_isa_tb",
        generics = _TILE_GENERICS,
        image = "%s:rv32ui-p-%s.rcf" % (_IMAGE_PACKAGE, test),
        sim_timeout_s = 90,
        tags = ["ghdl"],
    )
    for test in _LIVE
]

test_suite(
    name = "tile_rv32ui",
    tags = ["ghdl"],
    tests = ["tile-rv32ui-p-%s" % t for t in _LIVE],
)
