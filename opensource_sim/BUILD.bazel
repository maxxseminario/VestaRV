# VestaRV: the open-source simulation tier as bazel tests, one sh_test per suite.
#
# Hermetic: @ghdl//:ghdl with its pre-analyzed VHDL-2008 libraries, ON-polarity images from
# //verification/isa's os_* targets, RTL from //hdl:vhdl_sources. The os_* define list mirrors
# run_isa.sh's CORE_ENABLE_DEFS and the two must move together. Suite wall-clock is dominated
# by test count times GHDL run time, so rv32ui and rv32ua are tagged long and the rest moderate.

load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

_ISA_SUITES = [
    ("rv32ui", "long"),
    ("rv32um", "moderate"),
    ("rv32ua", "long"),
    ("rv32uc", "moderate"),
    ("rv32uzba", "moderate"),
    ("rv32uzbb", "moderate"),
    ("rv32uzbc", "moderate"),
    ("rv32uzbs", "moderate"),
    ("rv32uzf", "long"),
]

[
    sh_test(
        name = "isa_" + suite,
        timeout = tmo,
        srcs = ["isa_suite_test.sh"],
        args = [
            suite,
            "$(rlocationpath @ghdl//:ghdl)",
        ],
        data = [
            "//opensource_sim/isa:run_isa.sh",
            "//opensource_sim/isa:vesta_isa_tb.vhd",
            "//hdl:vhdl_sources",
            "//verification/isa:os_%s_rcfs" % suite,
            "@ghdl//:ghdl",
            "@ghdl//:vhdl_libs_v08",
        ],
    )
    for suite, tmo in _ISA_SUITES
]

test_suite(
    name = "isa_regression",
    tests = [":isa_" + suite for suite, _ in _ISA_SUITES],
)
