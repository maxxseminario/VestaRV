# The SINGLE-HART chip, config/mcu_hart.json: elaborated, and booted out of the
# real mask-ROM image.
#
# ---------------------------------------------------------------------------
# WHY THIS PACKAGE EXISTS SEPARATELY FROM //opensource_sim/mcu
# ---------------------------------------------------------------------------
# //opensource_sim/mcu elaborates the TRACKED hdl/common/MCU.vhd, which is the
# five-hart Castalia golden master and the only generated pair the tree keeps
# on disk. MCU_hart is a different configuration of the same generator, so its
# MCU.vhd and MemoryMap.vhd exist only as build outputs of
# //platform/common:chip_artifacts_mcu_hart. The two labels are spliced into
# the shared analysis order at the two positions defs.bzl names, and nothing in
# the source tree has to hold a second copy of the RTL.
#
# The bar //platform/common:mcu_hart_generation_test sets is that the
# configuration generates and its JSON parses, which is what the hart-count
# note in generate.py calls unproven. These two targets are what carry it
# further: the RTL binds a hierarchy, its size contracts hold at time zero, and
# a real program runs on it.
#
# ---------------------------------------------------------------------------
# THE TWO TARGETS
# ---------------------------------------------------------------------------
# :mcu_hart_elaborate is //opensource_sim/mcu:mcu_elaborate for this
# configuration, and it is the same 1 ns run for the same reason -- MCU.vhd's
# `assert RomAddrBits = RomMacroAddrBits` and hart_tile.vhd's
# `assert RamSize = 8192` are CONCURRENT assertions, so they need a simulation
# and not an elaboration. The ROM is empty here; it reads no memory contents.
#
# :mcu_hart_boot is the one that proves the chip works. It holds BOOT low,
# which selects the ROM-resident Forth monitor, and grades the 21-character
# boot banner the monitor prints on UART0. A pass means the single-hart chip
# released reset, fetched from the shared boot ROM through a one-master
# arbiter, ran C out of its TCM and drove a UART -- none of which an
# elaboration says anything about. MEASURED: the banner lands at 3.12 ms of
# simulated time and the whole run takes 13 s.
#
# The verdict is pass_pattern, not the exit code: see the same note in
# //opensource_sim/rv4th.

load("//opensource_sim/mcu:defs.bzl", "rom_image_pkg")
load("//toolchains/ghdl:defs.bzl", "ghdl_test", "vhdl_source_set")
load(":defs.bzl", "MCU_HART_HEAD", "MCU_HART_MID", "MCU_HART_TB")

package(default_visibility = ["//visibility:public"])

# No image: the elaboration gate reads no memory contents.
rom_image_pkg(name = "mcu_hart_rom_image_empty")

# The real mask-ROM image, for the boot test. $(rootpath) inside the generated
# package, so the image is a build dependency and a ROM change re-runs the test.
rom_image_pkg(
    name = "mcu_hart_rom_image",
    image = "//software/bootrom_mp:rom_rcf",
)

vhdl_source_set(
    name = "mcu_hart_head_srcs",
    paths = MCU_HART_HEAD,
    pool = ["//hdl:vhdl_sources"],
)

vhdl_source_set(
    name = "mcu_hart_mid_srcs",
    paths = MCU_HART_MID,
    pool = ["//hdl:vhdl_sources"],
)

vhdl_source_set(
    name = "mcu_hart_tb_srcs",
    paths = MCU_HART_TB,
    pool = ["//hdl:vhdl_sources"],
)

# Order is analysis order, and it is load bearing twice over: a direct
# `entity work.x` instantiation binds at ANALYSIS, so the macro model has to
# precede hart_tile.vhd and MCU.vhd; and the GENERATED MemoryMap.vhd has to sit
# where the tracked one sat, because every unit below it reads that package.
_RTL = [
    ":mcu_hart_head_srcs",
    "//platform/common:mcu_hart_memorymap_vhd",
    ":mcu_hart_mid_srcs",
    "//platform/common:mcu_hart_mcu_vhd",
]

_FLAGS = [
    "-fsynopsys",
    # hdl/common/periph/SYSTEM.vhd:465 associates one element of a port array
    # with `open`, which is an error under plain --std=08.
    "-frelaxed",
]

ghdl_test(
    name = "mcu_hart_elaborate",
    size = "small",
    srcs = [
        ":mcu_hart_rom_image_empty",
        "//opensource_sim/mcu:mem_macros_sim.vhd",
    ] + _RTL,
    entity = "MCU",
    flags = _FLAGS,
    sim_timeout_s = 45,
    stop_time = "1ns",
    tags = ["ghdl"],
)

ghdl_test(
    name = "mcu_hart_boot",
    # MEASURED at 13 s. `moderate` is a 300 s bazel timeout, which leaves room
    # for a slower runner; sim_timeout_s below cuts in first, so a hang is
    # reported by this rule with a log tail rather than by bazel killing the
    # test with none.
    size = "medium",
    srcs = [
        ":mcu_hart_rom_image",
        "//opensource_sim/mcu:mem_macros_sim.vhd",
    ] + _RTL + [
        ":mcu_hart_tb_srcs",
        # The behavioural TSMC pad cell. The bench puts one on every package
        # pin, UART0 TX/RX and both crystals included, and the receiver's
        # pull-up is what makes an undriven pin read as a defined level.
        "//opensource_sim/rv4th:pads_sim.vhd",
        "mcu_hart_boot_tb.vhd",
    ],
    # The image itself, named nowhere on the GHDL command line: the ROM model
    # opens it by the path :mcu_hart_rom_image carries, so it has to be in
    # runfiles or that open fails.
    data = ["//software/bootrom_mp:rom_rcf"],
    entity = "mcu_hart_boot_tb",
    flags = _FLAGS,
    pass_pattern = "MCU_HART BOOT PASSED",
    run_options = ["--assert-level=failure"],
    sim_timeout_s = 240,
    # The banner lands at 3.12 ms; the rest is slack, not budget.
    stop_time = "5ms",
    tags = ["ghdl"],
)
