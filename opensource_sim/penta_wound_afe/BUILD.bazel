# GHDL elaboration gate for the AFE-bearing tape-out configuration
# (platform/common/config/penta_wound_afe.json): the generated MCU.vhd binds
# every entity it names, including the four AFE2 sites and the afe_* entity
# ports, and its time-zero size asserts hold. Same shape and same reasons as
# //opensource_sim/mcu:mcu_elaborate and //opensource_sim/mcu_hart:mcu_hart_elaborate.

load("//opensource_sim/mcu:defs.bzl", "rom_image_pkg")
load("//toolchains/ghdl:defs.bzl", "ghdl_test", "vhdl_source_set")
load(":defs.bzl", "WOUND_AFE_HEAD", "WOUND_AFE_MID")

package(default_visibility = ["//visibility:public"])

rom_image_pkg(name = "wound_afe_rom_image_empty")

vhdl_source_set(
    name = "wound_afe_head_srcs",
    paths = WOUND_AFE_HEAD,
    pool = ["//hdl:vhdl_sources"],
)

vhdl_source_set(
    name = "wound_afe_mid_srcs",
    paths = WOUND_AFE_MID,
    pool = ["//hdl:vhdl_sources"],
)

ghdl_test(
    name = "penta_wound_afe_elaborate",
    size = "small",
    srcs = [
        ":wound_afe_rom_image_empty",
        "//opensource_sim/mcu:mem_macros_sim.vhd",
        ":wound_afe_head_srcs",
        "//platform/common:penta_wound_afe_memorymap_vhd",
        ":wound_afe_mid_srcs",
        "//platform/common:penta_wound_afe_mcu_vhd",
    ],
    entity = "MCU",
    flags = [
        "-fsynopsys",
        "-frelaxed",
    ],
    sim_timeout_s = 90,
    stop_time = "1ns",
    tags = ["ghdl"],
)
