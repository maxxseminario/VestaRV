_LIVE = [t for t in _RV32UI_TESTS if t not in _SKIP]

[
    ghdl_test(
        name = "rv32ui-p-%s" % test,
        size = "medium",
        srcs = [
            ":vesta_isa_srcs",
            "vesta_isa_tb.vhd",
        ],
        entity = "vesta_isa_tb",
        image = "%s:rv32ui-p-%s.rcf" % (_IMAGE_PACKAGE, test),
        # run_isa.sh's TIMEOUT_S. The a0-sentinel harness has no software trap
        # recovery, so an unmet dependency spins instead of reporting.
        sim_timeout_s = 90,
        tags = ["ghdl"],
    )
    for test in _LIVE
]

test_suite(
    name = "rv32ui",
    tags = ["ghdl"],
    tests = ["rv32ui-p-%s" % t for t in _LIVE],
)

# ---------------------------------------------------------------------------
# The "MUST STAY IN SYNC" comment on the curated source order, enforced.
# ---------------------------------------------------------------------------
py_test(
    name = "source_list_sync_test",
    size = "small",
    srcs = ["source_list_sync_test.py"],
    args = [
        "$(location run_isa.sh)",
        "$(location defs.bzl)",
        "$(location //sky130:synth.sh)",
        "$(location //sky130:sim/Makefile)",
    ],
    data = [
        "defs.bzl",
        "run_isa.sh",
        "//sky130:sim/Makefile",
        "//sky130:synth.sh",
    ],
    main = "source_list_sync_test.py",
)
