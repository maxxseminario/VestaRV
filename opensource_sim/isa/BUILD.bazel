# GHDL ISA regression: one bazel test per riscv-tests image.
#
# This is the bazel port of opensource_sim/isa/run_isa.sh's run loop. The
# shell script builds the images with make and then loops `ghdl -r` over them;
# here each image is a separate test target, so a single failure names itself
# and reruns on its own.
#
# PILOT SCOPE: rv32ui only, per the porting brief. The other eight suites of
# run_isa.sh's DEFAULT_SUITES are deliberately not instantiated yet -- see the
# POLARITY note below for the reason that is not just a matter of typing.
#
# ---------------------------------------------------------------------------
# POLARITY: which images these tests consume
# ---------------------------------------------------------------------------
# vesta_isa_tb enables every extension generic a single bare core can exercise,
# and run_isa.sh therefore rebuilds the images with CORE_ENABLE_DEFS so the
# rv32ua ext-probes compile their ON arm. //verification/isa's targets are
# built at the CI polarity instead (NHARTS=4, no -DCORE_ENABLE_*).
#
# For rv32ui that difference is almost entirely inert: exactly one rv32ui
# source, tests/rv32ui/zbk.S, reads a CORE_ENABLE_* define, and the NHARTS
# define is only read by the sh* system tests, which the SKIP map already
# excludes for needing a second hart. Measured consequence: every live target
# below passes against the CI-polarity images, and the only coverage lost is
# zbk's ON arm (see the note under _SKIP).
#
# When //verification/isa grows CORE_ENABLE-polarity image targets, point
# _IMAGE_PACKAGE at them; nothing else here has to change.

load("//toolchains/ghdl:defs.bzl", "ghdl_library", "ghdl_test", "vhdl_source_set")
load("@rules_python//python:defs.bzl", "py_test")
load(":defs.bzl", "VESTA_ISA_RTL")

package(default_visibility = ["//visibility:public"])

exports_files([
    "vesta_isa_tb.vhd",
    "run_isa.sh",
])

_IMAGE_PACKAGE = "//verification/isa"

# The a0-sentinel testbench: one hart, one flat RAM at 0x8000, no peripherals.
# It loads its RAM image at ELABORATION through a signal initializer, which is
# why every image needs its own ghdl -r with a real -gTEST_FILE.
vhdl_source_set(
    name = "vesta_isa_srcs",
    paths = VESTA_ISA_RTL,
    pool = ["//hdl:vhdl_sources"],
)

# Build-time check that the curated list still analyzes clean. Not consumed by
# the tests: a GHDL work library is not relocatable across exec roots (measured
# -- see //toolchains/ghdl:defs.bzl).
ghdl_library(
    name = "vesta_isa_lib",
    srcs = [
        ":vesta_isa_srcs",
        "vesta_isa_tb.vhd",
    ],
)

# ---------------------------------------------------------------------------
# SKIP map, transcribed from run_isa.sh's SKIP table (rv32ui entries) plus the
# entries this port measured for itself. Every entry is a test that is present
# in the suite and deliberately NOT instantiated, never one silently dropped.
#
# Family 1 -- MCU / multi-core system-integration tests that live in the
# rv32ui tree but are not bare-core ISA tests. They drive peripheral MMIO (the
# 0x4xxx slots, the 0x6000 HW-mutex bank, the 0x7xxx IRQ/CLINT window, CLINT
# mtime at 0x5010) and/or launch harts 1..NHARTS-1 through the mp_boot ROM. On
# this harness the device reads back zero (self-check writes a0=DEADBEEF) or
# the program spins on a hart that never boots (sim watchdog).
#
# Family 2 -- polarity mismatches against the CI-polarity images, see above.
# ---------------------------------------------------------------------------
_SKIP = {
    # Family 1, verbatim from run_isa.sh.
    "shperiph": "shared SPI1(0x4300)+UART1(0x4500) via the HW mutex bank(0x6000), MCU peripherals, not bare core",
    "shuart": "shared UART1 peripheral (0x4500), MCU peripheral absent on the bare core",
    "shi2c": "shared I2C peripheral MMIO, MCU peripheral absent on the bare core",
    "shtimer": "shared timer peripheral MMIO, MCU peripheral absent on the bare core",
    "shclint": "CLINT / timer-IRQ window (0x4000/0x71c0), MCU CLINT absent on the bare core",
    "shirq": "inter-hart IRQ + routing table (0x7xxx), needs the MCU IRQ controller and more than one hart",
    "irqctx": "IRQ context save/restore over the 0x7xxx routing window, MCU IRQ controller absent",
    "shmutex": "HW mutex bank (0x6000) single-instruction acquire, MCU mutex block absent",
    "shboot": "launches harts 1..N through the mp_boot ROM, needs the boot ROM and more than one hart",
    "shexec": "multi-hart execution / GO-gate coordination, needs more than one hart",
    "shwfi": "WFI parked on an inter-hart wakeup, needs another hart or IRQ to wake it",
    "shfault": "fault-injection / trap handshake over MMIO, MCU fault facilities absent",
    "shpwr": "power-gate / sleep-control peripheral, MCU power controller absent",
    "shnpu": "NPU accelerator peripheral + staging RAM (0xC000), MCU NPU absent",
    "shafe": "AFE analog-front-end peripheral, MCU analog block absent",
    "afsel": "AFE peripheral select + IRQ routing (0x7000), MCU peripheral absent",
    "afselv2": "AFE peripheral slot (0x4100) + IRQ routing (0x7000/0x7201), MCU peripheral absent",
    # Family 1, tests added to the rv32ui tree after run_isa.sh's SKIP table
    # was written. Each was RUN on this harness before being listed, and each
    # was observed to fail or to hit the simulation watchdog for the same
    # reason as its neighbours above: it needs a peripheral or a second hart.
    # See MEASURED-SKIPS below for the observation.
    "shmem_mp": "measured sim watchdog timeout: the current shmem_mp.S opens with a READY barrier that waits for all NHARTS harts (its own T1 FIX note), so on a one-hart harness it never leaves the barrier. run_isa.sh's SKIP table predates that barrier and still lists shmem_mp as a keeper; plain shmem still passes and is kept",
    "shdma": "shared DMA engine MMIO, MCU DMA block absent on the bare core",
    "shevfab": "event-fabric peripheral plus harts 1..N, MCU event fabric absent",
    "shexecc": "multi-hart execution coordination variant, needs more than one hart",
    "shorch": "multi-hart orchestration through the mp_boot ROM, needs more than one hart",
    "shtcm": "per-core TCM window, needs the MCU memory map and more than one hart",
    "wactf": "NPU activation-function peripheral, MCU NPU absent",
    "wdma": "DMA peripheral, MCU DMA block absent",
    "wgemm": "NPU GEMM peripheral, MCU NPU absent",
    "wgpio": "GPIO peripheral, MCU GPIO absent",
    "wi2ct": "I2C-target peripheral, MCU I2C absent",
    "wi3c": "I3C peripheral, MCU I3C absent",
    "wnfc": "NFC peripheral, MCU NFC block absent",
    "wnpuconv": "NPU convolution peripheral, MCU NPU absent",
    "wow": "OneWire peripheral, MCU OneWire absent",
    "wperiph": "generic peripheral-window walk, MCU peripherals absent",
    "wpwm": "PWM peripheral, MCU PWM absent",
    "wqspi": "QSPI peripheral, MCU QSPI absent",
    "wrtc": "RTC peripheral, MCU RTC absent",
    "wtrng": "TRNG peripheral, MCU TRNG absent",
    "wxnpu": "NPU XNOR peripheral, MCU NPU absent",
}

# Family 2 has no members today, and that is a measurement, not an assumption.
# tests/rv32ui/zbk.S is the only rv32ui source that reads a CORE_ENABLE_*
# define, and its own header says the OFF build "degrades to a trivially-
# passing arm so the suite stays green". Measured here: rv32ui-p-zbk passes
# against the CI-polarity image. It is therefore kept as a live target, with
# the caveat that until CORE_ENABLE-polarity images exist it proves only that
# the trivial arm still runs, not that the Zbkb/Zbkx/Zbkc datapath is right.
# The real Zbk coverage is the ON arm, which needs the os_* images.

# Every -p- test the //verification/isa package builds for rv32ui. Keeping the
# full list here, minus _SKIP, means a new test appears as a new target rather
# than being quietly absent.
