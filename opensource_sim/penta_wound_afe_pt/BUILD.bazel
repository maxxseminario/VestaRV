# GHDL elaboration gate for the PER-TILE AFE tape-out configuration
# (platform/common/config/penta_wound_afe_pt.json): the generated MCU.vhd binds
# every entity it names -- the four AFE2 sites, the BIASG register, and the four
# hart_tile_pt channel tiles with their behavioural converters -- and its
# time-zero size asserts hold. Same shape and same reasons as
# //opensource_sim/penta_wound_afe:penta_wound_afe_elaborate.

load("//opensource_sim/mcu:defs.bzl", "rom_image_pkg")
load("//toolchains/ghdl:defs.bzl", "ghdl_test", "vhdl_source_set")
load(":defs.bzl", "WOUND_AFE_PT_HEAD", "WOUND_AFE_PT_MID")

package(default_visibility = ["//visibility:public"])

rom_image_pkg(name = "wound_afe_pt_rom_image_empty")

vhdl_source_set(
    name = "wound_afe_pt_head_srcs",
    paths = WOUND_AFE_PT_HEAD,
    pool = ["//hdl:vhdl_sources"],
)

vhdl_source_set(
    name = "wound_afe_pt_mid_srcs",
    paths = WOUND_AFE_PT_MID,
    pool = ["//hdl:vhdl_sources"],
)

ghdl_test(
    name = "penta_wound_afe_pt_elaborate",
    size = "small",
    srcs = [
        ":wound_afe_pt_rom_image_empty",
        "//opensource_sim/mcu:mem_macros_sim.vhd",
        ":wound_afe_pt_head_srcs",
        "//platform/common:penta_wound_afe_pt_memorymap_vhd",
        ":wound_afe_pt_mid_srcs",
        "//platform/common:penta_wound_afe_pt_mcu_vhd",
    ],
    entity = "MCU",
    flags = [
        "-fsynopsys",
        "-frelaxed",
    ],
    sim_timeout_s = 90,
    stop_time = "1ns",
    tags = ["ghdl"],
)
