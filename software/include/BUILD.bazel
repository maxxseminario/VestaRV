# VestaRV: the generated firmware register headers.
#
# software/include/regs/*.h is emitted by //platform/common/python:rdl_regs_headers from the
# SystemRDL descriptions. They are tracked rather than built, because firmware is compiled by
# three paths (bazel, software/*/makefile, a developer's own gcc) and only a tracked file is on
# all three. They do not replace MemoryMap.h; a test proves the two describe the same addresses.

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "regs_headers",
    srcs = glob(
        ["regs/*.h"],
        allow_empty = False,
    ),
)
