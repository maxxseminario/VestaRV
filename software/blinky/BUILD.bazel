# VestaRV: blinky, the template application the other five packages were cloned from.
# See the myshkin_app docstring for how the platform-vs-tools linker directory
# fallback in that makefile was resolved.

load("//toolchains/riscv:defs.bzl", "firmware_image_test", "myshkin_app")

package(default_visibility = ["//visibility:public"])

myshkin_app(
    name = "blinky",
    # Present in src/ but not currently included by either source file; listed
    # so an edit that starts including it does not silently miss the sandbox.
    hdrs = ["src/platform_fix.h"],
)

# The golden below is the current recipe's output: .text at 0x8200, the boot ROM's entry,
# anchored at 0x8000 by toolchains/riscv/app_base.S. The bench copies in bin/ and rcf/
# predate that and are not reproduced. Whether the image boots is
# //implementations/fpga/bringup:blinky_flash_boot's job, not this byte gate's.
firmware_image_test(
    name = "blinky_flashed_rcf_test",
    image = "xxxxxxxxxxxxblinky.rcf",
    golden = "testdata/blinky_flashed_rcf_golden.txt",
)
