# VestaRV: the debug entry trampoline.
#
# One assembly file linked at the fixed entry page 0x10780, turned into a 64-line plantable word
# list: words 0..39 are the trampoline, planted as 32 binary characters, and words 40..63 are a
# single '-', left writable for the Debug Module's abstract body and epilogue. TRAMP_WORDS is a
# coupling with debug_module.vhd's W_ABST/W_EPILOG, enforced by bin2rcf --expect-words 40.

load("//toolchains/riscv:defs.bzl", "FIRMWARE_TOOLS", "PRELUDE", "firmware_image_test")

package(default_visibility = ["//visibility:public"])

TRAMP_WORDS = 40

PAGE_WORDS = 64

genrule(
    name = "dbg_trampoline_elf",
    srcs = ["dbg_trampoline.S"],
    outs = ["dbg_trampoline.elf"],
    # rv32iac, not rv32imac. The Debug Module plants this page for WHICHEVER
    # hart it halts, and MCU.vhd gives every hart_tile instance
    # DEBUG_ENTRY_ADDR => x"00010780" with ENABLE_DEBUG => CORE_ENABLE_DEBUG, so
    # a tile is a hart that executes it. The tiles are rv32iac
    # (derived.hartClasses in config/ChipConfig.resolved.json), and a wider
    # -march here only lets gas accept an instruction they trap as illegal.
    # Byte-identical output today (the page is hand-written assembly and uses
    # no M encoding); the point is that it cannot stop being.
    # Kept in step with software/dbg_trampoline/Makefile, and graded on the
    # linked ELF by //software/testtools:tile_isa_test.
    cmd = PRELUDE + '"$$CC" -march=rv32iac -mabi=ilp32 -nostdlib -nostartfiles ' +
          '-Wl,-Ttext=0x00010780 -o "$@" "$<"\n',
    tools = FIRMWARE_TOOLS,
)

genrule(
    name = "dbg_trampoline_bin",
    srcs = ["dbg_trampoline.elf"],
    outs = ["dbg_trampoline.bin"],
    cmd = PRELUDE + '"$$OBJCOPY" -O binary --gap-fill=0x00 "$<" "$@"\n',
    tools = FIRMWARE_TOOLS,
)

genrule(
    name = "dbg_trampoline_dump",
    srcs = ["dbg_trampoline.elf"],
    outs = ["dbg_trampoline.dump"],
    cmd = PRELUDE + '"$$OBJDUMP" -d --disassemble-zeroes "$<" > "$@"\n',
    tools = FIRMWARE_TOOLS,
)

# CONTRACT: tools/cosim/check_dbg_trampoline.py consumes this target by name.
genrule(
    name = "dbg_trampoline_words",
    srcs = ["dbg_trampoline.bin"],
    outs = ["dbg_trampoline.words"],
    cmd = ("set -euo pipefail\n" +
           'WORDS="$$(mktemp)"\n' +
           # --expect-words is the Makefile's `wc -l` guard: the trampoline is
           # exactly TRAMP_WORDS long or the build stops here.
           '"$(location //tools/build:bin2rcf)" "$<" "$$WORDS" --expect-words %d\n' % TRAMP_WORDS +
           'cat "$$WORDS" > "$@"\n' +
           'i=%d\n' % TRAMP_WORDS +
           "while [ $$i -lt %d ]; do\n" % PAGE_WORDS +
           '  printf -- "-   word %s: DM-written, MUST stay writable\\n" "$$i" >> "$@"\n' +
           "  i=$$((i+1))\n" +
           "done\n" +
           'rm -f "$$WORDS"\n'),
    tools = ["//tools/build:bin2rcf"],
)

# Locks the planted words. A trampoline edit that changes any instruction has
# to move this golden too, which is where the debug_module.vhd W_ABST/W_EPILOG
# review happens.
firmware_image_test(
    name = "dbg_trampoline_words_test",
    golden = "testdata/dbg_trampoline_words_golden.txt",
    image = "dbg_trampoline.words",
)
