# The course SDK: the runtime every lab links against.
#
# course.mk compiles crt0.S and course_lib/course.c into every lab image and
# links with course.ld. The files are exported individually because the lab
# packages name them directly in link order.
#
# generated/ is a frozen snapshot of the chip generator output, kept for
# reference. Nothing in the SDK includes it (chip.h is self-contained), so it
# is not exposed as a build input at all. It must never be regenerated by a
# build; see generated/PROVENANCE.md.
#
# run_sim.sh drives Cadence and is deliberately not wired into bazel.

package(default_visibility = ["//visibility:public"])

exports_files([
    "crt0.S",
    "course.ld",
    "course_lib/course.c",
])

# Headers the SDK and the labs include: the student API, the register view,
# and the optional interrupt and multicore helpers.
filegroup(
    name = "course_lib_headers",
    srcs = [
        "course_lib/chip.h",
        "course_lib/course.h",
        "course_lib/irq.h",
        "course_lib/mp.h",
    ],
)
