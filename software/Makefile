# VestaRV Firmware Projects Makefile
# This makefile helps create and manage firmware projects

.PHONY: help new clean-all build-all list

# Default target
help:
	@echo "VestaRV Firmware Project Manager"
	@echo ""
	@echo "Usage:"
	@echo "  make new PROJECT=<name>        Create new firmware project with template"
	@echo "  make list                      List all firmware projects"
	@echo "  make build-all                 Build all firmware projects"
	@echo "  make clean-all                 Clean all firmware projects"
	@echo ""
	@echo "Example:"
	@echo "  make new PROJECT=my-app"
	@echo ""
	@echo "Project Types (optional, default=ram):"
	@echo "  TYPE=ram                       Application runs from RAM"
	@echo "  TYPE=rom                       Application runs from ROM (bootloader)"
	@echo ""
	@echo "Example with type:"
	@echo "  make new PROJECT=my-bootloader TYPE=rom"

# Create new project with standard structure
new:
	@if [ -z "$(PROJECT)" ]; then \
		echo "Error: PROJECT name required"; \
		echo "Usage: make new PROJECT=<name>"; \
		exit 1; \
	fi; \
	if [ -d "$(PROJECT)" ]; then \
		echo "Error: Project '$(PROJECT)' already exists"; \
		exit 1; \
	fi; \
	echo "Creating project: $(PROJECT)"; \
	mkdir -p $(PROJECT)/src $(PROJECT)/include $(PROJECT)/obj $(PROJECT)/bin; \
	echo "Creating makefile..."; \
	$(call create_makefile,$(PROJECT),$(if $(TYPE),$(TYPE),ram)); \
	echo "Creating template source files..."; \
	$(call create_main_c,$(PROJECT)); \
	$(call create_start_s,$(PROJECT)); \
	echo ""; \
	echo "Project '$(PROJECT)' created successfully!"; \
	echo ""; \
	echo "Next steps:"; \
	echo "  1. cd $(PROJECT)"; \
	echo "  2. Edit src/main.c with your application code"; \
	echo "  3. make all"; \
	echo ""

# List all firmware projects (directories with makefiles)
list:
	@echo "Firmware Projects:"
	@for dir in */; do \
		if [ -f "$$dir/makefile" ] || [ -f "$$dir/Makefile" ]; then \
			echo "  - $${dir%/}"; \
		fi; \
	done

# Build all projects
build-all:
	@echo "Building all firmware projects..."
	@for dir in */; do \
		if [ -f "$$dir/makefile" ] || [ -f "$$dir/Makefile" ]; then \
			echo "Building $${dir%/}..."; \
			$(MAKE) -C $$dir all || exit 1; \
		fi; \
	done
	@echo "All projects built successfully"

# Clean all projects
clean-all:
	@echo "Cleaning all firmware projects..."
	@for dir in */; do \
		if [ -f "$$dir/makefile" ] || [ -f "$$dir/Makefile" ]; then \
			echo "Cleaning $${dir%/}..."; \
			$(MAKE) -C $$dir clean; \
		fi; \
	done
	@echo "All projects cleaned"

# Function to create barebones project makefile
define create_makefile
	printf '%s\n' \
		'# $(1) Firmware Makefile' \
		'# Generated by VestaRV firmware project generator' \
		'' \
		'TARGET = $(1)' \
		'' \
		'# Project source files' \
		'# WARNING: start.S must be first' \
		'SRC_SOURCES = start.S main.c' \
		'LIB_SOURCES =' \
		'EXTENSIONS = imac' \
		'' \
		'# Directories' \
		'LIB_DIR = ../commune' \
		'PLATFORM_DIR = ../../platform/gcc/lib' \
		'LD_DIR = $$(PLATFORM_DIR)/linker' \
		'LD_SCRIPT = $$(LD_DIR)/MCU$(if $(filter rom,$(2)),-bootrom,).ld' \
		'LIB_SRC_DIR = $$(LIB_DIR)/src' \
		'LIB_INC_DIR = $$(LIB_DIR)/include' \
		'SRC_DIR = ./src' \
		'INC_DIR = ./include' \
		'OBJ_DIR = ./obj' \
		'BIN_DIR = ./bin' \
		'RCF_DIR = ./rcf' \
		'' \
		'# Scripts' \
		'PYTHON_DIR = ../../tools/build/scripts' \
		'FLASH_SCRIPT = ../../verification/isa/flash_prepend.sh' \
		'' \
		'# Memory configuration (generated by platform)' \
		'RAM_START = `cat $$(LD_DIR)/RAM_START.txt`' \
		'RAM_SIZE = `cat $$(LD_DIR)/RAM_SIZE.txt`' \
		'ROM_START = `cat $$(LD_DIR)/ROM_START.txt`' \
		'ROM_SIZE = `cat $$(LD_DIR)/ROM_SIZE.txt`' \
		'MEM_SIZE = $$(shell printf "%d" 0x14000)' \
		'WORD_COUNT = $$(shell echo $$$$(( $$(MEM_SIZE) / 4 )))' \
		'' \
		'# Toolchain' \
		'ifndef RISCV_TOOLCHAIN_DIR' \
		'$$(error RISCV_TOOLCHAIN_DIR is not set. Please set it to your RISC-V toolchain path, e.g.: export RISCV_TOOLCHAIN_DIR=~/riscv-toolchain/xpack-riscv-none-elf-gcc-13.2.0-2)' \
		'endif' \
		'TOOLCHAIN_DIR = $$(RISCV_TOOLCHAIN_DIR)' \
		'PREFIX = $$(TOOLCHAIN_DIR)/bin/riscv-none-elf-' \
		'CC = $$(PREFIX)gcc' \
		'OBJCOPY = $$(PREFIX)objcopy' \
		'OBJDUMP = $$(PREFIX)objdump' \
		'SIZE = $$(PREFIX)size' \
		'' \
		'# Architecture' \
		'ARCH = rv32$$(EXTENSIONS)' \
		'ABI = ilp32' \
		'' \
		'# Flags' \
		'CFLAGS = -march=$$(ARCH) -mabi=$$(ABI) -Wall -O2 -g -I$$(INC_DIR) -I$$(LIB_INC_DIR) -I$$(PLATFORM_DIR)/include -ffreestanding -nostdlib' \
		'LDFLAGS = -march=$$(ARCH) -mabi=$$(ABI) -T$$(LD_SCRIPT) -nostartfiles -nostdlib -Wl,-Map=$$(BIN_DIR)/$$(TARGET).map -L$$(LD_DIR)' \
		'' \
		'# Source files' \
		'SRC_FILES = $$(addprefix $$(SRC_DIR)/,$$(SRC_SOURCES))' \
		'LIB_FILES = $$(addprefix $$(LIB_SRC_DIR)/,$$(LIB_SOURCES))' \
		'SRC_OBJS = $$(patsubst $$(SRC_DIR)/%.S,$$(OBJ_DIR)/%.o,$$(patsubst $$(SRC_DIR)/%.c,$$(OBJ_DIR)/%.o,$$(SRC_FILES)))' \
		'LIB_OBJS = $$(patsubst $$(LIB_SRC_DIR)/%.c,$$(OBJ_DIR)/%.o,$$(filter %.c,$$(LIB_FILES)))' \
		'ALL_OBJS = $$(SRC_OBJS) $$(LIB_OBJS)' \
		'' \
		'.PHONY: all clean flash sim help' \
		'' \
		'help:' \
		'	@echo "$$(TARGET) Build Targets:"' \
		'	@echo "  make all      - Build ELF, binary, hex, dump, and RCF files"' \
		'	@echo "  make flash    - Add SPI flash headers to RCF file (required for Xcelium)"' \
		'	@echo "  make sim      - Run simulation in Xcelium (requires flash target first)"' \
		'	@echo "  make clean    - Remove all build artifacts"' \
		'' \
		'all: $$(BIN_DIR)/$$(TARGET).elf $$(BIN_DIR)/$$(TARGET).bin $$(BIN_DIR)/$$(TARGET).hex $$(BIN_DIR)/$$(TARGET).dump $$(RCF_DIR)/$$(TARGET).rcf' \
		'	@echo "Build complete: $$(TARGET)"' \
		'	@$$(SIZE) $$(BIN_DIR)/$$(TARGET).elf' \
		'	@echo ""' \
		'	@echo "Next steps:"' \
		'	@echo "  make flash    - Add SPI flash headers for simulation"' \
		'	@echo "  make sim      - Run in Xcelium testbench"' \
		'' \
		'$$(BIN_DIR)/$$(TARGET).elf: $$(ALL_OBJS) | $$(BIN_DIR)' \
		'	$$(CC) $$(LDFLAGS) -o $$@ $$(ALL_OBJS)' \
		'' \
		'$$(OBJ_DIR)/%.o: $$(SRC_DIR)/%.c | $$(OBJ_DIR)' \
		'	$$(CC) $$(CFLAGS) -c $$< -o $$@' \
		'' \
		'$$(OBJ_DIR)/%.o: $$(LIB_SRC_DIR)/%.c | $$(OBJ_DIR)' \
		'	$$(CC) $$(CFLAGS) -c $$< -o $$@' \
		'' \
		'$$(OBJ_DIR)/%.o: $$(SRC_DIR)/%.S | $$(OBJ_DIR)' \
		'	$$(CC) $$(CFLAGS) -c $$< -o $$@' \
		'' \
		'$$(BIN_DIR)/$$(TARGET).bin: $$(BIN_DIR)/$$(TARGET).elf' \
		'	$$(OBJCOPY) -O binary $$< $$@' \
		'' \
		'$$(BIN_DIR)/$$(TARGET).hex: $$(BIN_DIR)/$$(TARGET).elf' \
		'	$$(OBJCOPY) -O ihex $$< $$@' \
		'' \
		'$$(BIN_DIR)/$$(TARGET).dump: $$(BIN_DIR)/$$(TARGET).elf' \
		'	$$(OBJDUMP) -D $$< > $$@' \
		'' \
		'# Generate padded binary (full memory space with zeros)' \
		'$$(BIN_DIR)/$$(TARGET)_padded.bin: $$(BIN_DIR)/$$(TARGET).bin' \
		'	@echo "Creating padded binary ($$(MEM_SIZE) bytes)..."' \
		'	@dd if=/dev/zero of=$$@ bs=$$(MEM_SIZE) count=1 2>/dev/null' \
		'	@dd if=$$< of=$$@ bs=1 seek=0 conv=notrunc 2>/dev/null' \
		'' \
		'# Convert padded binary to RCF format (binary text: 1s and 0s)' \
		'$$(RCF_DIR)/$$(TARGET).rcf: $$(BIN_DIR)/$$(TARGET)_padded.bin | $$(RCF_DIR)' \
		'	@echo "Generating RCF file ($$(WORD_COUNT) words)..."' \
		'	@od -v -An -tx4 -w4 $$< | awk '"'"'\' \
		'	{ \' \
		'	    hex = $$$$1; \' \
		'	    bin = ""; \' \
		'	    for (i = 1; i <= 8; i++) { \' \
		'	        c = substr(hex, i, 1); \' \
		'	        if (c == "0") bin = bin "0000"; \' \
		'	        else if (c == "1") bin = bin "0001"; \' \
		'	        else if (c == "2") bin = bin "0010"; \' \
		'	        else if (c == "3") bin = bin "0011"; \' \
		'	        else if (c == "4") bin = bin "0100"; \' \
		'	        else if (c == "5") bin = bin "0101"; \' \
		'	        else if (c == "6") bin = bin "0110"; \' \
		'	        else if (c == "7") bin = bin "0111"; \' \
		'	        else if (c == "8") bin = bin "1000"; \' \
		'	        else if (c == "9") bin = bin "1001"; \' \
		'	        else if (c == "a") bin = bin "1010"; \' \
		'	        else if (c == "b") bin = bin "1011"; \' \
		'	        else if (c == "c") bin = bin "1100"; \' \
		'	        else if (c == "d") bin = bin "1101"; \' \
		'	        else if (c == "e") bin = bin "1110"; \' \
		'	        else if (c == "f") bin = bin "1111"; \' \
		'	    } \' \
		'	    print bin; \' \
		'	}'"'"' > $$@' \
		'	@lines=$$$$(wc -l < $$@); \' \
		'	if [ $$$$lines -ne $$(WORD_COUNT) ]; then \' \
		'	    echo "Error: $$@ has $$$$lines lines (expected $$(WORD_COUNT))"; \' \
		'	    exit 1; \' \
		'	fi' \
		'	@echo "RCF file created: $$@"' \
		'' \
		'# Add SPI flash protocol headers' \
		'flash: $$(RCF_DIR)/$$(TARGET).rcf' \
		'	@echo "Adding SPI flash headers to RCF file..."' \
		'	@$$(FLASH_SCRIPT) "$$(RCF_DIR)/$$(TARGET).rcf" 22' \
		'	@echo "Flash headers added successfully"' \
		'	@echo "RCF file ready for Xcelium simulation"' \
		'' \
		'# Run simulation in Xcelium' \
		'sim: flash' \
		'	@echo "Starting Xcelium simulation..."' \
		'	@echo "Copying RCF to verification test directory..."' \
		'	@cp $$(RCF_DIR)/*$$(TARGET).rcf ../../verification/isa/rcf/' \
		'	@echo "Launch Xcelium and load: ../../../verification/isa/rcf/*$$(TARGET).rcf"' \
		'	@echo ""' \
		'	@echo "Note: Update your testbench to load the $$(TARGET) RCF file"' \
		'' \
		'$$(OBJ_DIR):' \
		'	mkdir -p $$@' \
		'' \
		'$$(BIN_DIR):' \
		'	mkdir -p $$@' \
		'' \
		'$$(RCF_DIR):' \
		'	mkdir -p $$@' \
		'' \
		'clean:' \
		'	rm -rf $$(OBJ_DIR) $$(BIN_DIR) $$(RCF_DIR)' \
		> $(1)/makefile
endef

# Function to create template main.c
define create_main_c
	printf '%s\n' \
		'/*' \
		' * $(1) - Main Application' \
		' * VestaRV Firmware' \
		' */' \
		'' \
		'#include <stdint.h>' \
		'' \
		'// Add your peripheral headers here' \
		'// #include "gpio.h"' \
		'// #include "uart.h"' \
		'' \
		'int main(void) {' \
		'    // Initialize peripherals' \
		'    ' \
		'    // Main application loop' \
		'    while(1) {' \
		'        // Your code here' \
		'    }' \
		'    ' \
		'    return 0;' \
		'}' \
		> $(1)/src/main.c
endef

# Function to create template start.S
define create_start_s
	printf '%s\n' \
		'/*' \
		' * $(1) - Startup Assembly' \
		' * VestaRV Firmware Boot Code' \
		' */' \
		'' \
		'.section .program_start, "ax"' \
		'.global __start_RAM_program__' \
		'.type __start_RAM_program__, @function' \
		'' \
		'__start_RAM_program__:' \
		'    # Jump to actual initialization (entry must be <=16 bytes)' \
		'    j _init' \
		'    nop' \
		'    nop' \
		'' \
		'.section .text.init' \
		'_init:' \
		'    # Initialize stack pointer to end of RAM' \
		'    # Stack grows downward from top of RAM' \
		'    # Adjust 0x10000 based on your RAM size' \
		'    li sp, 0x10000' \
		'    ' \
		'    # Clear BSS section' \
		'    la a0, __bss_start' \
		'    la a1, _end' \
		'bss_clear:' \
		'    beq a0, a1, bss_done' \
		'    sw zero, 0(a0)' \
		'    addi a0, a0, 4' \
		'    j bss_clear' \
		'bss_done:' \
		'    ' \
		'    # Jump to main' \
		'    jal main' \
		'    ' \
		'    # Infinite loop if main returns' \
		'halt:' \
		'    j halt' \
		> $(1)/src/start.S
endef
