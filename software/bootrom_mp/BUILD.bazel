# Multiprocessor boot ROM (the "flashboot" image).
#
# This is the mask ROM content of the fabricated part, so the recipe here is a
# literal transcription of software/bootrom_mp/makefile: same sources in the
# same order, same flags, same link line, same 16KB zero filled window, same
# 4096 word RCF. See :rom_rcf_reproducibility_test for the byte level proof
# against the pinned bench artifact.
#
# start.S must stay first in srcs. The linker script places the first input
# section at the reset vector.
#
# The -march string and the size-coupled compile flags are NOT written twice.
# They live in isa.bzl, which this file loads and the makefile reads with sed.

load("@rules_python//python:defs.bzl", "py_test")
load("//toolchains/riscv:defs.bzl", "rv32_firmware")
load(":isa.bzl", "BOOTROM_MARCH", "BOOTROM_SIZE_COPTS")

package(default_visibility = ["//visibility:public"])

# The makefile's LIB_SOURCES is empty, so nothing from commune/src is linked
# in. The commune include directory is on the path only for myshkin.h and
# myshkin_s.h; MemoryMap.h is commented out in every source here, which is why
# this package builds without the gitignored generator outputs.
rv32_firmware(
    name = "flashboot",
    srcs = [
        "src/start.S",
        "src/main.c",
        "src/rv4th.c",
        "src/uart.c",
        "src/spi.c",
        "src/flash_memory.c",
    ],
    copts = [
        "-Werror",
        "-Wall",
        "-Wunused",
        "-Os",
        "-flto",
        "-g",
    ] + BOOTROM_SIZE_COPTS,
    defines = ["__nostdlib__"],
    # The makefile names objects <source>.src.o; keep that so any name
    # sensitive step inside LTO sees what it always saw.
    obj_suffix = ".src.o",
    dump_flags = [
        "--disassemble-all",
        "--disassemble-zeroes",
        "--section=.text",
        "--section=.text.startup",
        "--section=.text.init",
        "--section=.data",
        "--section=.rodata",
        "--section=.bss",
        "--prefix-addresses",
        "--show-raw-insn",
    ],
    # This is mask ROM, not a flash image, so no SPI load header.
    flash = False,
    gcc_inc = True,
    hdrs = [
        "include/flash_memory.h",
        "include/rv4th.h",
        "include/spi.h",
        "include/uart.h",
        "//software/commune:chip_headers",
    ],
    includes = [
        "software/bootrom_mp/include",
        "software/commune/include",
    ],
    ld_script = "//tools/build:linker-scripts/MCU-bootrom.ld",
    # MCU-bootrom.ld does INCLUDE memory.x and INCLUDE periph.x, which the
    # linker resolves out of the -L directory.
    ld_srcs = ["//tools/build:linker_scripts"],
    # LFLAGS from the makefile, in the makefile's order. -lgcc really does
    # come before the objects there, and static link order is load bearing,
    # so it is reproduced rather than tidied.
    link_flags = [
        "-lgcc",
        "{march}",
        "-Os",
        "-flto",
    ] + BOOTROM_SIZE_COPTS + [
        "-nostartfiles",
        "-Wl,-Bstatic,-T,{ld_script},-Map,{map},--cref",
        "-Ltools/build/linker-scripts",
        "-g",
    ],
    # The ISA string is not spelled here on purpose. See isa.bzl: the makefile
    # reads the same assignment, so the two build paths cannot drift apart.
    march = BOOTROM_MARCH,
    # 16KB boot ROM, 4096 words.
    pad_bytes = 16384,
    rcf_name = "rom.rcf",
)

# The pinned bench copy of the ROM image, tracked under a name that does not
# collide with the global *.rcf gitignore. Byte identical to the ROM plate.
#
# RE-CUT 2026-08-23, and it is NOT drift. The ISA string in isa.bzl went from
# rv32i to rv32ic and -fno-tree-loop-distribute-patterns was added, so every
# word of the image moved. .text went 10,140 bytes to 7,376, which is 816 bytes
# under the 8,192 byte target. The mirror the cosim gate reads,
# tools/cosim/gate/bootrom_mp_rom.rcf, was re-cut in the same change; the two
# and software/bootrom_mp/bin/rom.rcf are one md5.
filegroup(
    name = "rom_rcf_golden",
    srcs = ["testdata/rom_rcf_golden.txt"],
)

# Proves the hermetic bazel build still reproduces the mask ROM content that
# was taped out. If this fails, either the toolchain pin moved or a source
# under src/ changed, and the physical part no longer matches the tree.
py_test(
    name = "rom_rcf_reproducibility_test",
    srcs = ["//software/testtools:compare_text.py"],
    args = [
        "$(location rom.rcf)",
        "$(location testdata/rom_rcf_golden.txt)",
        "--label",
        "bazel-built-rom.rcf",
    ],
    data = [
        "rom.rcf",
        "testdata/rom_rcf_golden.txt",
    ],
    main = "//software/testtools:compare_text.py",
    size = "small",
)

# The name the rest of the build refers to. The macro derives its target names
# from the makefile TARGET ("flashboot"), but the artifact everyone means is
# the ROM image.
alias(
    name = "rom_rcf",
    actual = ":flashboot_rcf",
)
